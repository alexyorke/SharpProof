# SharpProof strict profile. Copy as .editorconfig or merge its [*.cs] section.
root = true

[*.cs]
sharpproof_suggest_missing_enforce_pure = true
sharpproof_suggest_missing_enforce_pure_scope = all
sharpproof_suggest_missing_enforce_pure_exclude_generated = false
sharpproof_suggest_missing_enforce_pure_exclude_tests = false
sharpproof_suggest_missing_enforce_pure_min_complexity = 0
sharpproof_suggest_inferred_contracts = true
sharpproof_suggest_inferred_contracts_scope = all
sharpproof_suggest_inferred_contracts_kinds = zero-allocations, capabilities, complexity, exceptions, ensures, requires
sharpproof_suggest_inferred_contracts_minimum_confidence = high
sharpproof_emit_explanations = true
sharpproof_report_bcl_fallback_guesses = true
sharpproof_runtime_hazard_mode = all-and-unknowns
sharpproof_suppress_proven_diagnostics = false
sharpproof_report_exceptions = true
sharpproof_checked_exceptions = true

dotnet_diagnostic.SP0002.severity = error
dotnet_diagnostic.SP0003.severity = error
dotnet_diagnostic.SP0004.severity = warning
dotnet_diagnostic.SP0005.severity = error
dotnet_diagnostic.SP0006.severity = error
dotnet_diagnostic.SP0007.severity = error
dotnet_diagnostic.SP0008.severity = warning
dotnet_diagnostic.SP0009.severity = warning
dotnet_diagnostic.SP0010.severity = warning
dotnet_diagnostic.SP0011.severity = error
dotnet_diagnostic.SP0012.severity = warning
dotnet_diagnostic.SP0013.severity = error
dotnet_diagnostic.SP0014.severity = error
dotnet_diagnostic.SP0015.severity = error
dotnet_diagnostic.SP0016.severity = error
dotnet_diagnostic.SP0017.severity = error
dotnet_diagnostic.SP0018.severity = error
dotnet_diagnostic.SP0019.severity = error
dotnet_diagnostic.SP0020.severity = error
dotnet_diagnostic.SP0021.severity = error
dotnet_diagnostic.SP0022.severity = error
dotnet_diagnostic.SP0023.severity = error
dotnet_diagnostic.SP0024.severity = error
dotnet_diagnostic.SP0025.severity = error
dotnet_diagnostic.SP0026.severity = error
dotnet_diagnostic.SP0027.severity = error
dotnet_diagnostic.SP0028.severity = error
dotnet_diagnostic.SP0029.severity = error
dotnet_diagnostic.SP0030.severity = error
dotnet_diagnostic.SP0031.severity = error
dotnet_diagnostic.SP0032.severity = error
dotnet_diagnostic.SP0033.severity = error
