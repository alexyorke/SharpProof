<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>SharpProof.Verifier.Win-x64</id>
    <version>$version$</version>
    <title>SharpProof Verifier for Windows x64</title>
    <authors>Alex Yorke</authors>
    <license type="expression">MIT</license>
    <readme>README.md</readme>
    <projectUrl>https://github.com/alexyorke/SharpProof</projectUrl>
    <description>Windows x64 postcondition verifier for SharpProof, including the worker, launcher, MSBuild integration, and one native Z3 payload.</description>
    <releaseNotes>Initial split Windows x64 verifier package for the soundness-first SharpProof preview.</releaseNotes>
    <copyright>Copyright (c) Alex Yorke</copyright>
    <tags>SharpProof Verifier Contracts SMT Z3 Windows x64</tags>
    <repository type="git" url="https://github.com/alexyorke/SharpProof" commit="$repositorycommit$" />
    <dependencies>
      <group targetFramework=".NETStandard2.0">
        <dependency id="SharpProof" version="[$version$]" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="buildTransitive\SharpProof.Verifier.Win-x64.props" target="buildTransitive" />
    <file src="buildTransitive\SharpProof.Verifier.Win-x64.targets" target="buildTransitive" />
    <file src="..\README.md" />
    <file src="..\LICENSE" />
    <file src="THIRD-PARTY-NOTICES.txt" />
    <file src="..\SharpProof.Worker\bin\$configuration$\net9.0\Microsoft.Z3.dll" target="tools\net9" />
    <file src="..\SharpProof.Worker\bin\$configuration$\net9.0\SharpProof.CompilerArtifact.dll" target="tools\net9" />
    <file src="..\SharpProof.Worker\bin\$configuration$\net9.0\SharpProof.Dataflow.dll" target="tools\net9" />
    <file src="..\SharpProof.Worker\bin\$configuration$\net9.0\SharpProof.Ir.dll" target="tools\net9" />
    <file src="..\SharpProof.Worker\bin\$configuration$\net9.0\SharpProof.Smt.dll" target="tools\net9" />
    <file src="..\SharpProof.Worker\bin\$configuration$\net9.0\SharpProof.Specs.dll" target="tools\net9" />
    <file src="..\SharpProof.Worker\bin\$configuration$\net9.0\SharpProof.Verify.dll" target="tools\net9" />
    <file src="..\SharpProof.Worker\bin\$configuration$\net9.0\SharpProof.Worker.Protocol.dll" target="tools\net9" />
    <file src="..\SharpProof.Worker\bin\$configuration$\net9.0\SharpProof.Worker.dll" target="tools\net9" />
    <file src="..\SharpProof.Worker\bin\$configuration$\net9.0\SharpProof.Worker.deps.json" target="tools\net9" />
    <file src="..\SharpProof.Worker\bin\$configuration$\net9.0\SharpProof.Worker.runtimeconfig.json" target="tools\net9" />
    <file src="..\SharpProof.Worker\bin\$configuration$\net9.0\System.IO.Pipelines.dll" target="tools\net9" />
    <file src="..\SharpProof.Worker\bin\$configuration$\net9.0\System.Text.Encodings.Web.dll" target="tools\net9" />
    <file src="..\SharpProof.Worker\bin\$configuration$\net9.0\System.Text.Json.dll" target="tools\net9" />
    <file src="..\SharpProof.Worker\bin\$configuration$\net9.0\runtimes\win-x64\native\libz3.dll" target="tools\net9\runtimes\win-x64\native" />
    <file src="..\SharpProof.Worker\bin\$configuration$\net9.0\runtimes\win\lib\net9.0\System.Text.Encodings.Web.dll" target="tools\net9\runtimes\win\lib\net9.0" />
    <file src="..\SharpProof.Worker.Launcher\bin\$configuration$\net9.0\SharpProof.Worker.Launcher.dll" target="tools\net9" />
    <file src="..\SharpProof.Worker.Launcher\bin\$configuration$\net9.0\SharpProof.Worker.Launcher.deps.json" target="tools\net9" />
