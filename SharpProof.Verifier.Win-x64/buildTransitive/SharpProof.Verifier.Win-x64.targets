<Project>
  <UsingTask TaskName="_SharpProofInvalidatePublishedResult"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ResultPath ParameterType="System.String"
                  Required="true" />
      <ProjectDirectory ParameterType="System.String"
                        Required="true" />
      <RequestPath ParameterType="System.String" />
      <ManifestPath ParameterType="System.String" />
      <SarifPath ParameterType="System.String" />
      <InvocationRequestPath ParameterType="System.String" />
      <InvocationResultPath ParameterType="System.String" />
      <InvocationManifestPath ParameterType="System.String" />
      <WorkerPath ParameterType="System.String" />
      <LauncherPath ParameterType="System.String" />
      <WorkerProtocolPath ParameterType="System.String" />
      <CachePath ParameterType="System.String" />
    </ParameterGroup>
    <Task>
      <Reference Include="$(_SharpProofWorkerProtocolPath)" />
      <Using Namespace="System.Linq" />
      <Using Namespace="SharpProof.Worker.Protocol" />
      <Code Type="Fragment"
            Language="cs"><![CDATA[
        System.Func<string, string> normalizePath =
            WindowsPathIdentity.Canonicalize;
        var lexicalProjectDirectory = System.IO.Path.GetFullPath(
            ProjectDirectory);
        System.Func<string, string> resolveLexicalPath = path =>
            System.IO.Path.GetFullPath(System.IO.Path.IsPathRooted(path)
                ? path
                : System.IO.Path.Combine(lexicalProjectDirectory, path));
        System.Func<string, string> resolvePath = path =>
            normalizePath(resolveLexicalPath(path));
        var outputPaths = new[] { ResultPath, SarifPath }
            .Where(path => !string.IsNullOrWhiteSpace(path))
            .Select(resolvePath)
            .ToArray();
        var publicationPaths = new[] {
            RequestPath, ResultPath, ManifestPath, SarifPath
        }.Where(path => !string.IsNullOrWhiteSpace(path))
            .Select(resolvePath)
            .ToArray();
        var publicationMarkerPaths = publicationPaths
            .Select(WindowsPathIdentity.PublicationMarkerPath)
            .ToArray();
        var publicationMutationPaths = outputPaths
            .Concat(publicationMarkerPaths)
            .ToArray();
        var aliasesOutput = outputPaths
            .Distinct(System.StringComparer.OrdinalIgnoreCase)
            .Count() != outputPaths.Length ||
            outputPaths.SelectMany((path, index) =>
                    outputPaths.Skip(index + 1)
                        .Select(other => new[] { path, other }))
                .Any(pair => WindowsPathIdentity.AreSameExistingFile(
                    pair[0], pair[1]));
        var toolPaths = new[] { WorkerPath, LauncherPath }
            .Where(path => !string.IsNullOrWhiteSpace(path))
            .SelectMany(path => new[] {
                path,
                System.IO.Path.ChangeExtension(path, ".deps.json"),
                System.IO.Path.ChangeExtension(path, ".runtimeconfig.json")
            })
            .Concat(new[] {
                System.IO.Path.Combine(
                    System.IO.Path.GetDirectoryName(resolvePath(LauncherPath)),
                    "SharpProof.CompilerArtifact.dll"),
                System.IO.Path.Combine(
                    System.IO.Path.GetDirectoryName(resolvePath(LauncherPath)),
                    "SharpProof.Ir.dll"),
                System.IO.Path.Combine(
                    System.IO.Path.GetDirectoryName(resolvePath(LauncherPath)),
                    "SharpProof.Specs.dll"),
                System.IO.Path.Combine(
                    System.IO.Path.GetDirectoryName(resolvePath(LauncherPath)),
                    "SharpProof.Worker.Protocol.dll"),
                System.IO.Path.Combine(
                    System.IO.Path.GetDirectoryName(resolvePath(LauncherPath)),
                    "SharpProof.Worker.Launcher.exe"),
                System.IO.Path.Combine(
                    System.IO.Path.GetDirectoryName(resolvePath(LauncherPath)),
                    "System.IO.Pipelines.dll"),
                System.IO.Path.Combine(
                    System.IO.Path.GetDirectoryName(resolvePath(LauncherPath)),
                    "System.Text.Encodings.Web.dll"),
                System.IO.Path.Combine(
                    System.IO.Path.GetDirectoryName(resolvePath(LauncherPath)),
                    "System.Text.Json.dll")
            });
        var resolvedWorkerPath = resolvePath(WorkerPath);
        var workerDirectory = System.IO.Path.GetDirectoryName(
            resolvedWorkerPath);
        var workerTreeExists = System.IO.File.Exists(resolvedWorkerPath) ||
            System.IO.File.Exists(System.IO.Path.ChangeExtension(
                resolvedWorkerPath, ".deps.json")) ||
            System.IO.File.Exists(System.IO.Path.ChangeExtension(
                resolvedWorkerPath, ".runtimeconfig.json"));
        var protectedPaths = new[] {
            RequestPath, ManifestPath, InvocationRequestPath,
            InvocationResultPath, InvocationManifestPath,
            WorkerProtocolPath
        }.Where(path => !string.IsNullOrWhiteSpace(path))
            .Select(resolvePath)
            .Concat(toolPaths.Select(resolvePath))
            .ToArray();
        var resolvedCachePath = string.IsNullOrWhiteSpace(CachePath)
            ? null
            : resolvePath(CachePath);
        System.Func<string, bool> traversesReparsePoint = path => {
            try {
                var current = resolveLexicalPath(path);
                while (!string.IsNullOrWhiteSpace(current)) {
                    try {
                        if ((System.IO.File.GetAttributes(current) &
                             System.IO.FileAttributes.ReparsePoint) != 0)
                            return true;
                    }
                    catch (System.IO.FileNotFoundException) { }
                    catch (System.IO.DirectoryNotFoundException) { }
                    var parent = System.IO.Path.GetDirectoryName(current);
                    if (string.IsNullOrWhiteSpace(parent) ||
                        System.String.Equals(parent, current,
                            System.StringComparison.OrdinalIgnoreCase))
                        break;
                    current = parent;
                }
                return false;
            }
            catch {
                return true;
            }
        };
        var aliasesReparse = publicationMutationPaths.Concat(protectedPaths)
            .Concat(resolvedCachePath != null
                ? new[] { resolvedCachePath }
                : System.Array.Empty<string>())
            .Any(traversesReparsePoint);
        if (aliasesReparse)
            Log.LogError(
                "SharpProof output paths must not traverse reparse points.");
        var aliasesFileIdentity = publicationMutationPaths
            .Any(output => protectedPaths.Any(input =>
                !string.Equals(
                    output, input, System.StringComparison.OrdinalIgnoreCase) &&
                WindowsPathIdentity.AreSameExistingFile(output, input)));
        var aliasesInput = aliasesFileIdentity || publicationMutationPaths
            .Any(output => protectedPaths.Any(input => string.Equals(
                output, input, System.StringComparison.OrdinalIgnoreCase)));
        if (aliasesFileIdentity)
            Log.LogError(
                "SharpProof output aliases a protected file identity.");
        var aliasesWorkerTree = workerTreeExists &&
            !string.IsNullOrWhiteSpace(workerDirectory) &&
            publicationMutationPaths.Any(output => WindowsPathIdentity.IsSameOrDescendant(
                output, workerDirectory));
        var aliasesCache = resolvedCachePath != null &&
            (publicationMutationPaths.Any(output => WindowsPathIdentity.IsSameOrDescendant(
                output, resolvedCachePath)) ||
             protectedPaths.Any(input => WindowsPathIdentity.IsSameOrDescendant(
                input, resolvedCachePath)) ||
             workerTreeExists &&
             !string.IsNullOrWhiteSpace(workerDirectory) &&
             WindowsPathIdentity.IsSameOrDescendant(
                 resolvedCachePath, workerDirectory));
        if (!aliasesReparse && !aliasesInput && !aliasesOutput &&
            !aliasesWorkerTree && !aliasesCache) {
            using (WindowsPathIdentity.AcquirePublicationSet(
                publicationPaths,
                System.TimeSpan.FromSeconds(30))) {
                foreach (var path in outputPaths)
                    WindowsPathIdentity.DeleteIfUnprotected(
                        path, protectedPaths);
            }
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <UsingTask TaskName="_SharpProofRunVerifier"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Executable ParameterType="System.String"
                  Required="true" />
      <Arguments ParameterType="Microsoft.Build.Framework.ITaskItem[]"
                 Required="true" />
      <WorkingDirectory ParameterType="System.String"
                        Required="true" />
      <ExitCode ParameterType="System.Int32"
                Output="true" />
    </ParameterGroup>
    <Task>
      <Reference Include="$(_SharpProofWorkerProtocolPath)" />
      <Code Type="Class"
            Language="cs"><![CDATA[
using System;
using System.Diagnostics;
using System.Text;
using Microsoft.Build.Framework;
using Microsoft.Build.Utilities;
using SharpProof.Worker.Protocol;

public sealed class _SharpProofRunVerifier : Task, ICancelableTask
{
    private readonly object _synchronization = new object();
    private Process _process;
    private bool _canceled;

    [Required]
    public string Executable { get; set; }

    [Required]
    public ITaskItem[] Arguments { get; set; }

    [Required]
    public string WorkingDirectory { get; set; }

    [Output]
    public int ExitCode { get; set; }

    public override bool Execute()
    {
        Process process = null;
        try
        {
            var resolvedExecutable = ResolveDotNetHost(Executable);
            var commandLine = new StringBuilder();
            foreach (var argument in Arguments)
            {
                if (commandLine.Length != 0)
                    commandLine.Append(' ');
                commandLine.Append(QuoteArgument(argument.ItemSpec));
            }
            process = new Process {
                StartInfo = new ProcessStartInfo {
                    FileName = resolvedExecutable,
                    Arguments = commandLine.ToString(),
                    WorkingDirectory = WorkingDirectory,
                    UseShellExecute = false,
                    RedirectStandardOutput = true,
                    RedirectStandardError = true,
                    CreateNoWindow = true
                }
            };
            lock (_synchronization)
            {
                if (_canceled)
                {
                    ExitCode = -1;
                    return true;
                }
                if (!process.Start())
                    throw new InvalidOperationException(
                        "The SharpProof verifier process could not be started.");
                _process = process;
            }
            var standardOutput = process.StandardOutput.ReadToEndAsync();
            var standardError = process.StandardError.ReadToEndAsync();
            process.WaitForExit();
            var output = standardOutput.GetAwaiter().GetResult();
            var error = standardError.GetAwaiter().GetResult();
            if (!string.IsNullOrWhiteSpace(output))
                Log.LogMessage(MessageImportance.High, "{0}", output);
            if (!string.IsNullOrWhiteSpace(error))
                Log.LogMessage(MessageImportance.High, "{0}", error);
            ExitCode = process.ExitCode;
        }
        catch (Exception exception)
        {
            ExitCode = -1;
            Log.LogMessage(
                MessageImportance.High,
                "SharpProof verifier launch failed: {0}",
                exception.Message);
        }
        finally
        {
            lock (_synchronization)
            {
                if (ReferenceEquals(_process, process))
                    _process = null;
            }
            if (process != null)
                process.Dispose();
        }
        return true;
    }

    private static string ResolveDotNetHost(string executable)
    {
        if (string.IsNullOrWhiteSpace(executable))
            throw new InvalidOperationException(
                "SharpProofDotNetHost must name the direct dotnet.exe muxer.");

        var disclosedHost = Environment.GetEnvironmentVariable("DOTNET_HOST_PATH");
        var trusted = !string.IsNullOrWhiteSpace(disclosedHost)
            ? ValidateDotNetInstallation(disclosedHost)
            : ValidateDotNetInstallation(ResolveDotNetFromPath());
        if (string.Equals(executable, "dotnet", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(executable, "dotnet.exe", StringComparison.OrdinalIgnoreCase))
        {
            return trusted;
        }
        if (!System.IO.Path.IsPathRooted(executable) ||
            !string.Equals(
                System.IO.Path.GetFileName(executable),
                "dotnet.exe",
                StringComparison.OrdinalIgnoreCase))
        {
            throw new InvalidOperationException(
                "SharpProofDotNetHost must name the direct dotnet.exe muxer.");
        }
        var configured = ValidateDotNetInstallation(executable);
        if (!WindowsPathIdentity.AreSameExistingFile(configured, trusted))
            throw new InvalidOperationException(
                "SharpProofDotNetHost must match the trusted current dotnet.exe muxer.");
        return configured;
    }

    private static string ResolveDotNetFromPath()
    {
        foreach (var value in (Environment.GetEnvironmentVariable("PATH") ??
                     string.Empty).Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries))
        {
            var directory = value.Trim().Trim('"');
            if (string.IsNullOrWhiteSpace(directory) ||
                directory == "." ||
                !System.IO.Path.IsPathRooted(directory))
                continue;
            var candidate = System.IO.Path.Combine(directory, "dotnet.exe");
            if (System.IO.File.Exists(candidate))
                return candidate;
        }
        throw new InvalidOperationException(
            "SharpProofDotNetHost could not resolve a trusted dotnet.exe from PATH.");
    }

    private static string ValidateDotNetInstallation(string candidate)
    {
        if (!System.IO.Path.IsPathRooted(candidate) ||
            !string.Equals(
                System.IO.Path.GetFileName(candidate),
                "dotnet.exe",
                StringComparison.OrdinalIgnoreCase))
            throw new InvalidOperationException(
                "SharpProofDotNetHost must name the direct dotnet.exe muxer.");
        var resolved = WindowsPathIdentity.Canonicalize(candidate);
        var directoryPath = System.IO.Path.GetDirectoryName(resolved);
        if (!System.IO.File.Exists(resolved) ||
            string.IsNullOrEmpty(directoryPath) ||
            !System.IO.Directory.Exists(System.IO.Path.Combine(
                directoryPath, "host", "fxr")))
        {
            throw new InvalidOperationException(
                "SharpProofDotNetHost must be a complete dotnet.exe installation.");
        }
        WindowsPathIdentity.Canonicalize(
            System.IO.Path.Combine(directoryPath, "host", "fxr"));
        return resolved;
    }

    public void Cancel()
    {
        Process process;
        lock (_synchronization)
        {
            _canceled = true;
            process = _process;
        }
        if (process == null)
            return;
        try
        {
            if (!process.HasExited)
                process.Kill();
        }
        catch (InvalidOperationException) { }
        catch (System.ComponentModel.Win32Exception) { }
    }

    private static string QuoteArgument(string argument)
    {
                var quoted = new StringBuilder(argument.Length + 2);
                quoted.Append('"');
                var backslashes = 0;
                foreach (var character in argument) {
                    if (character == '\\') {
                        backslashes++;
                        continue;
                    }
                    if (character == '"') {
                        quoted.Append('\\', (backslashes * 2) + 1);
                        quoted.Append(character);
                        backslashes = 0;
                        continue;
                    }
                    quoted.Append('\\', backslashes);
                    quoted.Append(character);
                    backslashes = 0;
                }
                quoted.Append('\\', backslashes * 2);
                quoted.Append('"');
                return quoted.ToString();
    }
}
      ]]></Code>
    </Task>
  </UsingTask>

  <PropertyGroup>
    <SharpProofVerifyPolicy Condition="'$(SharpProofVerifyPolicy)' == '' AND '$(_SharpProofProfileNormalized)' == 'strict'">require-proven</SharpProofVerifyPolicy>
    <SharpProofVerifyPolicy Condition="'$(SharpProofVerifyPolicy)' == ''">advisory</SharpProofVerifyPolicy>
    <SharpProofAssumptionPolicy Condition="'$(SharpProofAssumptionPolicy)' == '' AND '$(_SharpProofProfileNormalized)' == 'strict'">error</SharpProofAssumptionPolicy>
    <SharpProofAssumptionPolicy Condition="'$(SharpProofAssumptionPolicy)' == ''">allow</SharpProofAssumptionPolicy>
    <_SharpProofVerifyPolicyNormalized>$([System.String]::Copy('$(SharpProofVerifyPolicy)').ToLowerInvariant())</_SharpProofVerifyPolicyNormalized>
    <_SharpProofAssumptionPolicyNormalized>$([System.String]::Copy('$(SharpProofAssumptionPolicy)').ToLowerInvariant())</_SharpProofAssumptionPolicyNormalized>
  </PropertyGroup>

  <Target Name="_SharpProofInitializeVerify"
          BeforeTargets="GenerateMSBuildEditorConfigFileShouldRun;GenerateMSBuildEditorConfigFile">
    <PropertyGroup>
      <_SharpProofVerifyDirectory>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)SharpProof'))))</_SharpProofVerifyDirectory>
      <SharpProofVerifyRequestFile Condition="'$(SharpProofVerifyRequestFile)' == ''">$(_SharpProofVerifyDirectory)\request.json</SharpProofVerifyRequestFile>
      <SharpProofVerifyResultFile Condition="'$(SharpProofVerifyResultFile)' == ''">$(_SharpProofVerifyDirectory)\result.json</SharpProofVerifyResultFile>
      <SharpProofCompilerManifestFile Condition="'$(SharpProofCompilerManifestFile)' == ''">$(_SharpProofVerifyDirectory)\compiler-manifest.json</SharpProofCompilerManifestFile>
      <_SharpProofVerifyCacheDirectoryNormalized>$([System.String]::Copy('$(SharpProofVerifyCacheDirectory)').Trim())</_SharpProofVerifyCacheDirectoryNormalized>
      <_SharpProofEffectiveCacheDirectory Condition="'$(_SharpProofVerifyCacheDirectoryNormalized)' == ''">$(_SharpProofVerifyDirectory)\cache</_SharpProofEffectiveCacheDirectory>
      <_SharpProofEffectiveCacheDirectory Condition="'$(_SharpProofVerifyCacheDirectoryNormalized)' != ''">$(SharpProofVerifyCacheDirectory)</_SharpProofEffectiveCacheDirectory>
      <_SharpProofInvocationId Condition="'$(_SharpProofInvocationId)' == ''">$([System.Guid]::NewGuid().ToString('N'))</_SharpProofInvocationId>
      <_SharpProofInvocationDirectory>$(_SharpProofVerifyDirectory)\runs\$(_SharpProofInvocationId)</_SharpProofInvocationDirectory>
      <_SharpProofInvocationRequestFile>$(_SharpProofInvocationDirectory)\request.json</_SharpProofInvocationRequestFile>
      <_SharpProofInvocationResultFile>$(_SharpProofInvocationDirectory)\result.json</_SharpProofInvocationResultFile>
    </PropertyGroup>
    <PropertyGroup Condition="'$(SharpProofVerify)' == 'true' AND '$(_SharpProofProfileNormalized)' != 'off' AND '$(_SharpProofVerifierHostSupported)' == 'true' AND '$(DesignTimeBuild)' != 'true' AND '$(BuildingProject)' != 'false'">
      <_SharpProofCompilationTargetFramework>$(TargetFramework)</_SharpProofCompilationTargetFramework>
      <_SharpProofCompilerManifestPath>$(_SharpProofInvocationDirectory)\compiler-manifest.json</_SharpProofCompilerManifestPath>
      <_SharpProofProjectDirectory>$(MSBuildProjectDirectory)</_SharpProofProjectDirectory>
    </PropertyGroup>
    <_SharpProofInvalidatePublishedResult
        Condition="'$(SharpProofVerify)' == 'true' AND '$(_SharpProofProfileNormalized)' != 'off' AND '$(_SharpProofVerifierHostSupported)' == 'true' AND '$(DesignTimeBuild)' != 'true' AND '$(BuildingProject)' != 'false'"
        ResultPath="$(SharpProofVerifyResultFile)"
        ProjectDirectory="$(MSBuildProjectDirectory)"
        RequestPath="$(SharpProofVerifyRequestFile)"
        ManifestPath="$(SharpProofCompilerManifestFile)"
        SarifPath="$(SharpProofVerifySarifFile)"
        InvocationRequestPath="$(_SharpProofInvocationRequestFile)"
        InvocationResultPath="$(_SharpProofInvocationResultFile)"
        InvocationManifestPath="$(_SharpProofCompilerManifestPath)"
        WorkerPath="$(_SharpProofWorkerPath)"
        LauncherPath="$(_SharpProofLauncherPath)"
        WorkerProtocolPath="$(_SharpProofWorkerProtocolPath)"
        CachePath="$(_SharpProofEffectiveCacheDirectory)" />
  </Target>

  <Target Name="_SharpProofVerifyCore"
          DependsOnTargets="_SharpProofInitializeVerify;ResolveReferences">
    <Error Condition="'$(_SharpProofVerifierHostSupported)' != 'true'"
           Text="SharpProof out-of-process verification is supported only on Windows x64. Portable analyzer profiles remain available on this host." />
    <Error Condition="'$(_SharpProofVerifyPolicyNormalized)' != 'advisory' AND '$(_SharpProofVerifyPolicyNormalized)' != 'warn-on-unknown' AND '$(_SharpProofVerifyPolicyNormalized)' != 'require-proven'"
           Text="SharpProofVerifyPolicy must be advisory, warn-on-unknown, or require-proven." />
    <Error Condition="'$(_SharpProofAssumptionPolicyNormalized)' != 'allow' AND '$(_SharpProofAssumptionPolicyNormalized)' != 'warn' AND '$(_SharpProofAssumptionPolicyNormalized)' != 'error'"
           Text="SharpProofAssumptionPolicy must be allow, warn, or error." />
    <Error Code="SP0049"
           Condition="!Exists('$(_SharpProofCompilerManifestPath)')"
           Text="SharpProof did not receive the required final compiler manifest." />
    <Error Condition="!Exists('$(_SharpProofLauncherPath)')"
           Text="SharpProof verifier launcher was not found at '$(_SharpProofLauncherPath)'." />
    <Error Condition="!Exists('$(_SharpProofWorkerPath)')"
           Text="SharpProof verifier worker was not found at '$(_SharpProofWorkerPath)'." />
    <MakeDir Directories="$(_SharpProofInvocationDirectory)" />
    <ItemGroup>
      <_SharpProofVerifierArgument Remove="@(_SharpProofVerifierArgument)" />
      <_SharpProofVerifierArgument Include="$([MSBuild]::Escape('$(_SharpProofLauncherPath)'))" />
      <_SharpProofVerifierArgument Include="verify" />
      <_SharpProofVerifierArgument Include="--worker" />
      <_SharpProofVerifierArgument Include="$([MSBuild]::Escape('$(_SharpProofWorkerPath)'))" />
      <_SharpProofVerifierArgument Include="--request" />
      <_SharpProofVerifierArgument Include="$([MSBuild]::Escape('$(_SharpProofInvocationRequestFile)'))" />
      <_SharpProofVerifierArgument Include="--result" />
      <_SharpProofVerifierArgument Include="$([MSBuild]::Escape('$(_SharpProofInvocationResultFile)'))" />
      <_SharpProofVerifierArgument Include="--publish-request" />
      <_SharpProofVerifierArgument Include="$([MSBuild]::Escape('$(SharpProofVerifyRequestFile)'))" />
      <_SharpProofVerifierArgument Include="--publish-result" />
      <_SharpProofVerifierArgument Include="$([MSBuild]::Escape('$(SharpProofVerifyResultFile)'))" />
      <_SharpProofVerifierArgument Include="--compiler-manifest" />
      <_SharpProofVerifierArgument Include="$([MSBuild]::Escape('$(_SharpProofCompilerManifestPath)'))" />
      <_SharpProofVerifierArgument Include="--publish-compiler-manifest" />
      <_SharpProofVerifierArgument Include="$([MSBuild]::Escape('$(SharpProofCompilerManifestFile)'))" />
      <_SharpProofVerifierArgument Include="--verify-policy" />
      <_SharpProofVerifierArgument Include="$(_SharpProofVerifyPolicyNormalized)" />
      <_SharpProofVerifierArgument Include="--assumption-policy" />
      <_SharpProofVerifierArgument Include="$(_SharpProofAssumptionPolicyNormalized)" />
      <_SharpProofVerifierArgument Include="--query-rlimit" />
      <_SharpProofVerifierArgument Include="$(SharpProofVerifyQueryRlimit)" />
      <_SharpProofVerifierArgument Include="--method-rlimit" />
      <_SharpProofVerifierArgument Include="$(SharpProofVerifyMethodRlimit)" />
      <_SharpProofVerifierArgument Include="--method-wall-ms" />
      <_SharpProofVerifierArgument Include="$(SharpProofVerifyMethodWallTimeMilliseconds)" />
      <_SharpProofVerifierArgument Include="--project-wall-ms" />
      <_SharpProofVerifierArgument Include="$(SharpProofVerifyProjectWallTimeMilliseconds)" />
      <_SharpProofVerifierArgument Include="--max-parallelism" />
      <_SharpProofVerifierArgument Include="$(SharpProofVerifyMaxParallelism)" />
      <_SharpProofVerifierArgument Include="--max-expression-depth" />
      <_SharpProofVerifierArgument Include="$(SharpProofVerifyMaximumExpressionDepth)" />
      <_SharpProofVerifierArgument Include="--process-memory-bytes" />
      <_SharpProofVerifierArgument Include="$(SharpProofVerifyProcessMemoryLimitBytes)" />
      <_SharpProofVerifierArgument Include="--max-worker-processes" />
      <_SharpProofVerifierArgument Include="$(SharpProofVerifyMaxWorkerProcesses)" />
      <_SharpProofVerifierArgument Include="--termination-grace-ms" />
      <_SharpProofVerifierArgument Include="$(SharpProofVerifyTerminationGraceMilliseconds)" />
      <_SharpProofVerifierArgument Include="--cache-enabled" />
      <_SharpProofVerifierArgument Include="$(SharpProofVerifyCacheEnabled)" />
      <_SharpProofVerifierArgument Include="--cache-directory" />
      <_SharpProofVerifierArgument Include="$([MSBuild]::Escape('$(_SharpProofEffectiveCacheDirectory)'))" />
      <_SharpProofVerifierArgument Include="--cache-maximum-bytes" />
      <_SharpProofVerifierArgument Include="$(SharpProofVerifyCacheMaximumBytes)" />
      <_SharpProofVerifierArgument Include="--publish-sarif"
                                   Condition="'$(SharpProofVerifySarifFile)' != ''" />
      <_SharpProofVerifierArgument Include="$([MSBuild]::Escape('$(SharpProofVerifySarifFile)'))"
                                   Condition="'$(SharpProofVerifySarifFile)' != ''" />
    </ItemGroup>
    <_SharpProofRunVerifier
        Executable="$(SharpProofDotNetHost)"
        Arguments="@(_SharpProofVerifierArgument)"
        WorkingDirectory="$(MSBuildProjectDirectory)">
      <Output TaskParameter="ExitCode"
              PropertyName="_SharpProofVerifierExitCode" />
    </_SharpProofRunVerifier>
    <RemoveDir Directories="$(_SharpProofInvocationDirectory)" />
    <Error Condition="'$(_SharpProofVerifierExitCode)' != '0'"
           Text="SharpProof verifier failed with exit code $(_SharpProofVerifierExitCode)." />
    <Message Importance="High"
             Text="SharpProof verifier result: $(SharpProofVerifyResultFile)" />
    <Message Condition="'$(SharpProofVerifySarifFile)' != ''"
             Importance="High"
             Text="SharpProof verifier SARIF result: $(SharpProofVerifySarifFile)" />
  </Target>

  <Target Name="SharpProofVerify"
          AfterTargets="CoreCompile"
          DependsOnTargets="_SharpProofInitializeVerify;_SharpProofVerifyCore"
          Condition="'$(SharpProofVerify)' == 'true' AND '$(_SharpProofProfileNormalized)' != 'off' AND '$(_SharpProofVerifierHostSupported)' == 'true' AND '$(DesignTimeBuild)' != 'true' AND '$(BuildingProject)' != 'false'" />

  <Target Name="SharpProofRejectUnsupportedWorkerHost"
          AfterTargets="CoreCompile"
          Condition="'$(SharpProofVerify)' == 'true' AND '$(_SharpProofProfileNormalized)' != 'off' AND '$(_SharpProofVerifierHostSupported)' != 'true' AND '$(DesignTimeBuild)' != 'true' AND '$(BuildingProject)' != 'false'">
    <Error Text="SharpProof out-of-process verification is supported only on Windows x64. Portable analyzer profiles remain available on this host." />
  </Target>
</Project>
