<Project>
  <!--
    This target deliberately consumes built analyzer payloads instead of
    importing SharpProof.AnalyzerConsumer.props. The consumer props add
    project references, which would introduce cycles when every repository
    project is self-applied in one solution build.
  -->
  <PropertyGroup>
    <SharpProofSelfApplyIncludeMetaAnalyzers
        Condition="'$(SharpProofSelfApplyIncludeMetaAnalyzers)' == ''">false</SharpProofSelfApplyIncludeMetaAnalyzers>
    <_SharpProofSelfApplySourceCoreDirectory>$(MSBuildThisFileDirectory)SharpProof.Analyzer.Core\bin\$(Configuration)\netstandard2.0</_SharpProofSelfApplySourceCoreDirectory>
    <_SharpProofSelfApplySourceAnalyzerPath>$(MSBuildThisFileDirectory)SharpProof.Analyzer\bin\$(Configuration)\netstandard2.0\SharpProof.Analyzer.dll</_SharpProofSelfApplySourceAnalyzerPath>
    <_SharpProofSelfApplySourceGeneratorPath>$(MSBuildThisFileDirectory)SharpProof.ContractForGenerator\bin\$(Configuration)\netstandard2.0\SharpProof.ContractForGenerator.dll</_SharpProofSelfApplySourceGeneratorPath>
    <_SharpProofSelfApplySourceMetaAnalyzerPath>$(MSBuildThisFileDirectory)SharpProof.Meta.Analyzers\bin\$(Configuration)\netstandard2.0\SharpProof.Meta.Analyzers.dll</_SharpProofSelfApplySourceMetaAnalyzerPath>
    <_SharpProofSelfApplyPayloadDirectory
        Condition="'$(SharpProofSelfApplyPayloadDirectory)' != ''">$(SharpProofSelfApplyPayloadDirectory)</_SharpProofSelfApplyPayloadDirectory>
    <_SharpProofSelfApplyPayloadDirectory
        Condition="'$(SharpProofSelfApplyPayloadDirectory)' == ''">$(_SharpProofSelfApplySourceCoreDirectory)</_SharpProofSelfApplyPayloadDirectory>
    <_SharpProofSelfApplyAnalyzerPath
        Condition="'$(SharpProofSelfApplyPayloadDirectory)' != ''">$(_SharpProofSelfApplyPayloadDirectory)\SharpProof.Analyzer.dll</_SharpProofSelfApplyAnalyzerPath>
    <_SharpProofSelfApplyAnalyzerPath
        Condition="'$(SharpProofSelfApplyPayloadDirectory)' == ''">$(_SharpProofSelfApplySourceAnalyzerPath)</_SharpProofSelfApplyAnalyzerPath>
    <_SharpProofSelfApplyGeneratorPath
        Condition="'$(SharpProofSelfApplyPayloadDirectory)' != ''">$(_SharpProofSelfApplyPayloadDirectory)\SharpProof.ContractForGenerator.dll</_SharpProofSelfApplyGeneratorPath>
    <_SharpProofSelfApplyGeneratorPath
        Condition="'$(SharpProofSelfApplyPayloadDirectory)' == ''">$(_SharpProofSelfApplySourceGeneratorPath)</_SharpProofSelfApplyGeneratorPath>
    <_SharpProofSelfApplyMetaAnalyzerPath
        Condition="'$(SharpProofSelfApplyPayloadDirectory)' != ''">$(_SharpProofSelfApplyPayloadDirectory)\SharpProof.Meta.Analyzers.dll</_SharpProofSelfApplyMetaAnalyzerPath>
    <_SharpProofSelfApplyMetaAnalyzerPath
        Condition="'$(SharpProofSelfApplyPayloadDirectory)' == ''">$(_SharpProofSelfApplySourceMetaAnalyzerPath)</_SharpProofSelfApplyMetaAnalyzerPath>
    <_SharpProofSelfApplyUseMetaAnalyzer
        Condition="'$(SharpProofSelfApplyIncludeMetaAnalyzers)' == 'true' OR '$(SharpProofProductionProject)' == 'true'">true</_SharpProofSelfApplyUseMetaAnalyzer>
  </PropertyGroup>

  <ItemGroup Condition="'$(SharpProofSelfApply)' == 'true' AND '$(DesignTimeBuild)' != 'true'">
    <!-- Remove consumer-props entries so a project never loads a payload twice. -->
    <Analyzer Remove="$(_SharpProofSelfApplyAnalyzerPath)" />
    <Analyzer Remove="$(_SharpProofSelfApplySourceAnalyzerPath)" />
    <Analyzer Remove="$(_SharpProofSelfApplyGeneratorPath)" />
    <Analyzer Remove="$(_SharpProofSelfApplySourceGeneratorPath)" />
    <Analyzer Remove="$(_SharpProofSelfApplyMetaAnalyzerPath)"
              Condition="'$(_SharpProofSelfApplyUseMetaAnalyzer)' == 'true'" />
    <Analyzer Remove="$(_SharpProofSelfApplyPayloadDirectory)\SharpProof.Analyzer.Core.dll" />
    <Analyzer Remove="$(_SharpProofSelfApplySourceCoreDirectory)\SharpProof.Analyzer.Core.dll" />
    <Analyzer Remove="$(_SharpProofSelfApplyPayloadDirectory)\SharpProof.Contracts.dll" />
    <Analyzer Remove="$(_SharpProofSelfApplySourceCoreDirectory)\SharpProof.Contracts.dll" />
    <Analyzer Remove="$(_SharpProofSelfApplyPayloadDirectory)\SharpProof.Dataflow.dll" />
    <Analyzer Remove="$(_SharpProofSelfApplySourceCoreDirectory)\SharpProof.Dataflow.dll" />
    <Analyzer Remove="$(_SharpProofSelfApplyPayloadDirectory)\SharpProof.Effects.dll" />
    <Analyzer Remove="$(_SharpProofSelfApplySourceCoreDirectory)\SharpProof.Effects.dll" />
    <Analyzer Remove="$(_SharpProofSelfApplyPayloadDirectory)\SharpProof.Frontend.dll" />
    <Analyzer Remove="$(_SharpProofSelfApplySourceCoreDirectory)\SharpProof.Frontend.dll" />
    <Analyzer Remove="$(_SharpProofSelfApplyPayloadDirectory)\SharpProof.Ir.dll" />
    <Analyzer Remove="$(_SharpProofSelfApplySourceCoreDirectory)\SharpProof.Ir.dll" />
    <Analyzer Remove="$(_SharpProofSelfApplyPayloadDirectory)\SharpProof.Specs.dll" />
    <Analyzer Remove="$(_SharpProofSelfApplySourceCoreDirectory)\SharpProof.Specs.dll" />
    <Analyzer Remove="$(_SharpProofSelfApplyPayloadDirectory)\System.Buffers.dll" />
    <Analyzer Remove="$(_SharpProofSelfApplySourceCoreDirectory)\System.Buffers.dll" />
    <Analyzer Remove="$(_SharpProofSelfApplyPayloadDirectory)\System.Collections.Immutable.dll" />
    <Analyzer Remove="$(_SharpProofSelfApplySourceCoreDirectory)\System.Collections.Immutable.dll" />
    <Analyzer Remove="$(_SharpProofSelfApplyPayloadDirectory)\System.Memory.dll" />
    <Analyzer Remove="$(_SharpProofSelfApplySourceCoreDirectory)\System.Memory.dll" />
    <Analyzer Remove="$(_SharpProofSelfApplyPayloadDirectory)\System.Numerics.Vectors.dll" />
    <Analyzer Remove="$(_SharpProofSelfApplySourceCoreDirectory)\System.Numerics.Vectors.dll" />
    <Analyzer Remove="$(_SharpProofSelfApplyPayloadDirectory)\System.Reflection.Metadata.dll" />
    <Analyzer Remove="$(_SharpProofSelfApplySourceCoreDirectory)\System.Reflection.Metadata.dll" />
    <Analyzer Remove="$(_SharpProofSelfApplyPayloadDirectory)\System.Runtime.CompilerServices.Unsafe.dll" />
    <Analyzer Remove="$(_SharpProofSelfApplySourceCoreDirectory)\System.Runtime.CompilerServices.Unsafe.dll" />
    <Analyzer Remove="$(_SharpProofSelfApplyPayloadDirectory)\System.Text.Encoding.CodePages.dll" />
    <Analyzer Remove="$(_SharpProofSelfApplySourceCoreDirectory)\System.Text.Encoding.CodePages.dll" />
    <Analyzer Remove="$(_SharpProofSelfApplyPayloadDirectory)\System.Threading.Tasks.Extensions.dll" />
    <Analyzer Remove="$(_SharpProofSelfApplySourceCoreDirectory)\System.Threading.Tasks.Extensions.dll" />

    <Analyzer Include="$(_SharpProofSelfApplyAnalyzerPath)" />
    <Analyzer Include="$(_SharpProofSelfApplyGeneratorPath)" />
    <Analyzer Include="$(_SharpProofSelfApplyPayloadDirectory)\SharpProof.Analyzer.Core.dll" />
    <Analyzer Include="$(_SharpProofSelfApplyPayloadDirectory)\SharpProof.Contracts.dll" />
    <Analyzer Include="$(_SharpProofSelfApplyPayloadDirectory)\SharpProof.Dataflow.dll" />
    <Analyzer Include="$(_SharpProofSelfApplyPayloadDirectory)\SharpProof.Effects.dll" />
    <Analyzer Include="$(_SharpProofSelfApplyPayloadDirectory)\SharpProof.Frontend.dll" />
    <Analyzer Include="$(_SharpProofSelfApplyPayloadDirectory)\SharpProof.Ir.dll" />
    <Analyzer Include="$(_SharpProofSelfApplyPayloadDirectory)\SharpProof.Specs.dll" />
    <Analyzer Include="$(_SharpProofSelfApplyPayloadDirectory)\System.Buffers.dll" />
    <Analyzer Include="$(_SharpProofSelfApplyPayloadDirectory)\System.Collections.Immutable.dll" />
    <Analyzer Include="$(_SharpProofSelfApplyPayloadDirectory)\System.Memory.dll" />
    <Analyzer Include="$(_SharpProofSelfApplyPayloadDirectory)\System.Numerics.Vectors.dll" />
    <Analyzer Include="$(_SharpProofSelfApplyPayloadDirectory)\System.Reflection.Metadata.dll" />
    <Analyzer Include="$(_SharpProofSelfApplyPayloadDirectory)\System.Runtime.CompilerServices.Unsafe.dll" />
    <Analyzer Include="$(_SharpProofSelfApplyPayloadDirectory)\System.Text.Encoding.CodePages.dll" />
    <Analyzer Include="$(_SharpProofSelfApplyPayloadDirectory)\System.Threading.Tasks.Extensions.dll" />
    <Analyzer Include="$(_SharpProofSelfApplyMetaAnalyzerPath)"
              Condition="'$(_SharpProofSelfApplyUseMetaAnalyzer)' == 'true'" />
  </ItemGroup>

  <Target Name="_SharpProofValidateSelfApplyArtifacts"
          BeforeTargets="CoreCompile"
          Condition="'$(SharpProofSelfApply)' == 'true' AND '$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('$(_SharpProofSelfApplyAnalyzerPath)')"
           Text="SharpProofSelfApply requires a baseline build. Missing $(_SharpProofSelfApplyAnalyzerPath); run the self-application command instead of setting SharpProofSelfApply on a first build." />
    <Error Condition="!Exists('$(_SharpProofSelfApplyGeneratorPath)')"
           Text="SharpProofSelfApply requires a baseline build. Missing $(_SharpProofSelfApplyGeneratorPath); run the self-application command instead of setting SharpProofSelfApply on a first build." />
    <Error Condition="!Exists('$(_SharpProofSelfApplyPayloadDirectory)\SharpProof.Analyzer.Core.dll')"
           Text="SharpProofSelfApply requires the baseline analyzer dependency closure under $(_SharpProofSelfApplyPayloadDirectory)." />
    <Error Condition="'$(_SharpProofSelfApplyUseMetaAnalyzer)' == 'true' AND !Exists('$(_SharpProofSelfApplyMetaAnalyzerPath)')"
           Text="SharpProofSelfApply requires SharpProof.Meta.Analyzers.dll in $(_SharpProofSelfApplyPayloadDirectory) for this project." />
  </Target>
</Project>
