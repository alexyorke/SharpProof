<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    
    <IsPackable>true</IsPackable> 
    
    
    
    <PackageId>SharpProof.Attributes</PackageId>
    <Version>0.1.0-preview.1</Version>
    <Authors>Alex Yorke</Authors>
    <Description>Contains SharpProof contract attributes for bounded symbolic C# analysis, including EnforcePureAttribute, PureAttribute, PureExternalAttribute, ImpureAttribute, AllowSynchronizationAttribute, ZeroAllocationsAttribute, AllowedCapabilitiesAttribute, ExpectedComplexityAttribute, ComplexityKind, and SharpProofCapability.</Description>
    <PackageTags>SharpProof;Attributes;Roslyn;Analyzer;Purity;StaticAnalysis;SymbolicAnalysis;Capabilities;ZeroAllocations;Complexity</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Title>SharpProof Attributes</Title>
    <PackageProjectUrl>https://github.com/alexyorke/SharpProof</PackageProjectUrl>
    <RepositoryUrl>https://github.com/alexyorke/SharpProof</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Public preview release of the SharpProof contract attributes package, including purity, synchronization, zero-allocation, capability-contract, symbolic postcondition, and complexity-contract attributes.</PackageReleaseNotes>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild> 
    

  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project> 
