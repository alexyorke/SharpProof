{
  "version": "0.2",
  "language": "en",
  "useGitignore": true,
  "files": ["**/*.md"],
  "ignorePaths": [
    "**/bin/**", "**/obj/**", "artifacts/**", "**/node_modules/**",
    "docs/generated/**", "**/*.generated.md", "**/Corpus/third-party/**"
  ],
  "ignoreRegExpList": [
    "/```[\\s\\S]*?```/g",
    "/`[^`\\n]+`/g",
    "/https?:\\/\\/[^\\s)<>]+/g"
  ],
  "dictionaryDefinitions": [
    { "name": "sharpproof", "path": "./eng/lint/project-words.txt", "addWords": true }
  ],
  "dictionaries": ["sharpproof"]
}
