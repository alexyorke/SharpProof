{
  "version": "0.2",
  "language": "en",
  "useGitignore": true,
  "files": [
    "**/*.md"
  ],
  "ignorePaths": [
    "**/bin/**",
    "**/obj/**",
    "artifacts/**",
    "**/node_modules/**",
    "**/Corpus/third-party/**",
    "eng/common/**"
  ],
  "ignoreRegExpList": [
    "/```[\\s\\S]*?```/g",
    "/`[^`\\n]+`/g",
    "/https?:\\/\\/[^\\s)<>]+/g"
  ],
  "dictionaryDefinitions": [
    {
      "name": "sharpproof",
      "path": "./eng/lint/project-words.txt",
      "addWords": true
    }
  ],
  "dictionaries": [
    "sharpproof"
  ]
}
