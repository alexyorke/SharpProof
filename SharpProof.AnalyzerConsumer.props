<Project>
  <!-- Import this file after the consuming project's SharpProof settings. -->
  <PropertyGroup>
    <_SharpProofAnalyzerConsumerPresent>true</_SharpProofAnalyzerConsumerPresent>
    <SharpProofProfile Condition="'$(SharpProofProfile)' == ''">advisory</SharpProofProfile>
    <SharpProofFeatures Condition="'$(SharpProofFeatures)' == ''">all</SharpProofFeatures>
    <SharpProofSpecificationPacks Condition="'$(SharpProofSpecificationPacks)' == ''"></SharpProofSpecificationPacks>
    <_SharpProofProfileNormalized>$([System.String]::Copy('$(SharpProofProfile)').Trim().ToLowerInvariant())</_SharpProofProfileNormalized>
    <_SharpProofFeaturesNormalized>$([System.String]::Copy('$(SharpProofFeatures)').Trim().ToLowerInvariant())</_SharpProofFeaturesNormalized>
    <SharpProofVerify Condition="'$(SharpProofVerify)' == '' AND '$(_SharpProofProfileNormalized)' == 'strict'">true</SharpProofVerify>
    <SharpProofVerify Condition="'$(SharpProofVerify)' == ''">false</SharpProofVerify>
    <_SharpProofContractsRuntimeEnabled
        Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(DefineConstants)', '(^|[;,])\s*SHARPPROOF_CONTRACTS\s*($|[;,])'))">true</_SharpProofContractsRuntimeEnabled>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="SharpProofProfile" />
    <CompilerVisibleProperty Include="SharpProofFeatures" />
    <CompilerVisibleProperty Include="SharpProofVerifyPolicy" />
    <CompilerVisibleProperty Include="SharpProofAssumptionPolicy" />
    <CompilerVisibleProperty Include="SharpProofSpecificationPacks" />
    <CompilerVisibleProperty Include="_SharpProofCompilerManifestPath" />
    <CompilerVisibleProperty Include="_SharpProofCompilationTargetFramework" />
    <CompilerVisibleProperty Include="_SharpProofProjectDirectory" />
    <CompilerVisibleProperty Include="SharpProofVerifyMaximumExpressionDepth" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)SharpProof.Attributes\SharpProof.Attributes.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(_SharpProofProfileNormalized)' != 'off'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)SharpProof.Analyzer\SharpProof.Analyzer.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)SharpProof.ContractForGenerator\SharpProof.ContractForGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <Analyzer Include="$(MSBuildThisFileDirectory)SharpProof.Analyzer.Core\bin\$(Configuration)\netstandard2.0\SharpProof.Analyzer.Core.dll" />
    <Analyzer Include="$(MSBuildThisFileDirectory)SharpProof.Analyzer.Core\bin\$(Configuration)\netstandard2.0\SharpProof.Contracts.dll" />
    <Analyzer Include="$(MSBuildThisFileDirectory)SharpProof.Analyzer.Core\bin\$(Configuration)\netstandard2.0\SharpProof.Dataflow.dll" />
    <Analyzer Include="$(MSBuildThisFileDirectory)SharpProof.Analyzer.Core\bin\$(Configuration)\netstandard2.0\SharpProof.Effects.dll" />
    <Analyzer Include="$(MSBuildThisFileDirectory)SharpProof.Analyzer.Core\bin\$(Configuration)\netstandard2.0\SharpProof.Frontend.dll" />
    <Analyzer Include="$(MSBuildThisFileDirectory)SharpProof.Analyzer.Core\bin\$(Configuration)\netstandard2.0\SharpProof.Ir.dll" />
    <Analyzer Include="$(MSBuildThisFileDirectory)SharpProof.Analyzer.Core\bin\$(Configuration)\netstandard2.0\SharpProof.Specs.dll" />
    <Analyzer Include="$(MSBuildThisFileDirectory)SharpProof.Analyzer.Core\bin\$(Configuration)\netstandard2.0\System.Buffers.dll" />
    <Analyzer Include="$(MSBuildThisFileDirectory)SharpProof.Analyzer.Core\bin\$(Configuration)\netstandard2.0\System.Collections.Immutable.dll" />
    <Analyzer Include="$(MSBuildThisFileDirectory)SharpProof.Analyzer.Core\bin\$(Configuration)\netstandard2.0\System.Memory.dll" />
    <Analyzer Include="$(MSBuildThisFileDirectory)SharpProof.Analyzer.Core\bin\$(Configuration)\netstandard2.0\System.Numerics.Vectors.dll" />
    <Analyzer Include="$(MSBuildThisFileDirectory)SharpProof.Analyzer.Core\bin\$(Configuration)\netstandard2.0\System.Reflection.Metadata.dll" />
    <Analyzer Include="$(MSBuildThisFileDirectory)SharpProof.Analyzer.Core\bin\$(Configuration)\netstandard2.0\System.Runtime.CompilerServices.Unsafe.dll" />
    <Analyzer Include="$(MSBuildThisFileDirectory)SharpProof.Analyzer.Core\bin\$(Configuration)\netstandard2.0\System.Text.Encoding.CodePages.dll" />
    <Analyzer Include="$(MSBuildThisFileDirectory)SharpProof.Analyzer.Core\bin\$(Configuration)\netstandard2.0\System.Threading.Tasks.Extensions.dll" />
    <Analyzer Update="$(MSBuildThisFileDirectory)SharpProof.Analyzer.Core\bin\$(Configuration)\netstandard2.0\*"
              SharpProofSourceTreeDependencyGroup="Portable" />
  </ItemGroup>

  <ItemGroup Condition="'$(SharpProofVerify)' == 'true' AND '$(_SharpProofProfileNormalized)' != 'off' AND '$(DesignTimeBuild)' != 'true'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)SharpProof.CompilerCollector\SharpProof.CompilerCollector.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <Analyzer Include="$(MSBuildThisFileDirectory)SharpProof.CompilerCollector\bin\$(Configuration)\netstandard2.0\Microsoft.Bcl.AsyncInterfaces.dll" />
    <Analyzer Include="$(MSBuildThisFileDirectory)SharpProof.CompilerCollector\bin\$(Configuration)\netstandard2.0\SharpProof.CompilerArtifact.dll" />
    <Analyzer Include="$(MSBuildThisFileDirectory)SharpProof.CompilerCollector\bin\$(Configuration)\netstandard2.0\SharpProof.Summaries.dll" />
    <Analyzer Include="$(MSBuildThisFileDirectory)SharpProof.CompilerCollector\bin\$(Configuration)\netstandard2.0\SharpProof.Worker.Protocol.dll" />
    <Analyzer Include="$(MSBuildThisFileDirectory)SharpProof.CompilerCollector\bin\$(Configuration)\netstandard2.0\System.IO.Pipelines.dll" />
    <Analyzer Include="$(MSBuildThisFileDirectory)SharpProof.CompilerCollector\bin\$(Configuration)\netstandard2.0\System.Text.Encodings.Web.dll" />
    <Analyzer Include="$(MSBuildThisFileDirectory)SharpProof.CompilerCollector\bin\$(Configuration)\netstandard2.0\System.Text.Json.dll" />
    <Analyzer Update="$(MSBuildThisFileDirectory)SharpProof.CompilerCollector\bin\$(Configuration)\netstandard2.0\*"
              SharpProofSourceTreeDependencyGroup="Collector" />
  </ItemGroup>

  <Target Name="_SharpProofApplyMappedAnalyzerConfigurations"
          AfterTargets="AssignProjectConfiguration"
          Condition="'$(_SharpProofProfileNormalized)' != 'off'">
    <ItemGroup>
      <_SharpProofMappedAnalyzerProjectReference
          Include="@(ProjectReferenceWithConfiguration)"
          Condition="'%(ProjectReferenceWithConfiguration.Filename)' == 'SharpProof.Analyzer'" />
      <_SharpProofMappedCollectorProjectReference
          Include="@(ProjectReferenceWithConfiguration)"
          Condition="'%(ProjectReferenceWithConfiguration.Filename)' == 'SharpProof.CompilerCollector'" />
      <_SharpProofDefaultAnalyzerDependency
          Include="@(Analyzer)"
          Condition="'%(Analyzer.SharpProofSourceTreeDependencyGroup)' == 'Portable'" />
      <_SharpProofDefaultCollectorDependency
          Include="@(Analyzer)"
          Condition="'%(Analyzer.SharpProofSourceTreeDependencyGroup)' == 'Collector'" />
    </ItemGroup>
    <PropertyGroup Condition="'@(_SharpProofMappedAnalyzerProjectReference)' != ''">
      <_SharpProofMappedAnalyzerConfiguration>@(_SharpProofMappedAnalyzerProjectReference->'%(Configuration)')</_SharpProofMappedAnalyzerConfiguration>
      <_SharpProofMappedAnalyzerConfiguration Condition="'$(_SharpProofMappedAnalyzerConfiguration)' == ''">$(Configuration)</_SharpProofMappedAnalyzerConfiguration>
      <_SharpProofMappedAnalyzerDependencyDirectory>$(MSBuildThisFileDirectory)SharpProof.Analyzer.Core\bin\$(_SharpProofMappedAnalyzerConfiguration)\netstandard2.0</_SharpProofMappedAnalyzerDependencyDirectory>
    </PropertyGroup>
    <PropertyGroup Condition="'@(_SharpProofMappedCollectorProjectReference)' != ''">
      <_SharpProofMappedCollectorConfiguration>@(_SharpProofMappedCollectorProjectReference->'%(Configuration)')</_SharpProofMappedCollectorConfiguration>
      <_SharpProofMappedCollectorConfiguration Condition="'$(_SharpProofMappedCollectorConfiguration)' == ''">$(Configuration)</_SharpProofMappedCollectorConfiguration>
      <_SharpProofMappedCollectorDependencyDirectory>$(MSBuildThisFileDirectory)SharpProof.CompilerCollector\bin\$(_SharpProofMappedCollectorConfiguration)\netstandard2.0</_SharpProofMappedCollectorDependencyDirectory>
    </PropertyGroup>
    <ItemGroup Condition="'$(_SharpProofMappedAnalyzerDependencyDirectory)' != ''">
      <Analyzer Remove="@(_SharpProofDefaultAnalyzerDependency)" />
      <Analyzer Include="@(_SharpProofDefaultAnalyzerDependency->'$(_SharpProofMappedAnalyzerDependencyDirectory)\%(Filename)%(Extension)')" />
    </ItemGroup>
    <ItemGroup Condition="'$(_SharpProofMappedCollectorDependencyDirectory)' != ''">
      <Analyzer Remove="@(_SharpProofDefaultCollectorDependency)" />
      <Analyzer Include="@(_SharpProofDefaultCollectorDependency->'$(_SharpProofMappedCollectorDependencyDirectory)\%(Filename)%(Extension)')" />
    </ItemGroup>
  </Target>

  <Target Name="_SharpProofValidateSourceTreeConfiguration"
          BeforeTargets="CoreCompile"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="'$(SharpProofMode)' != ''"
           Text="SharpProofMode was removed before preview.1. Use SharpProofProfile and SharpProofFeatures." />
    <Error Condition="'$(SharpProofPortableAnalyzerPath)' != ''"
           Text="SharpProofPortableAnalyzerPath was removed before preview.1. Analyzer layout is package-owned; use SharpProofAnalyzerDirectory only for package testing." />
    <Error Condition="'$(_SharpProofProfileNormalized)' != 'advisory' AND '$(_SharpProofProfileNormalized)' != 'strict' AND '$(_SharpProofProfileNormalized)' != 'off'"
           Text="SharpProofProfile must be advisory, strict, or off." />
    <Error Condition="'$(_SharpProofFeaturesNormalized)' != 'effects' AND '$(_SharpProofFeaturesNormalized)' != 'contracts' AND '$(_SharpProofFeaturesNormalized)' != 'all'"
           Text="SharpProofFeatures must be effects, contracts, or all." />
    <Error Condition="'$(SharpProofVerify)' != 'true' AND '$(SharpProofVerify)' != 'false'"
           Text="SharpProofVerify must be true or false." />
    <Error Condition="'$(_SharpProofProfileNormalized)' == 'strict' AND '$(SharpProofVerify)' != 'true'"
           Text="SharpProofProfile=strict requires SharpProofVerify=true; use the advisory profile to make verification optional." />
    <Error Condition="'$(_SharpProofProfileNormalized)' != 'off' AND '$(_SharpProofContractsRuntimeEnabled)' == 'true'"
           Text="SHARPPROOF_CONTRACTS enables runtime evaluation of ghost contracts and is not supported while SharpProof analysis is enabled. Remove it from DefineConstants or set SharpProofProfile=off." />
  </Target>

  <Target Name="_SharpProofRequireSourceTreeVerifierPackage"
          BeforeTargets="CoreCompile"
          DependsOnTargets="_SharpProofValidateSourceTreeConfiguration"
          Condition="'$(SharpProofVerify)' == 'true' AND '$(_SharpProofProfileNormalized)' != 'off' AND '$(_SharpProofVerifierPackagePresent)' != 'true' AND '$(DesignTimeBuild)' != 'true' AND '$(BuildingProject)' != 'false'">
    <Error Text="SharpProof verification requires the matching SharpProof.Verifier package. The source-tree analyzer consumer cannot run verification by itself." />
  </Target>
</Project>
