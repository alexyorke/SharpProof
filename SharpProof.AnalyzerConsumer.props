<Project>
  <ItemGroup>
    <CompilerVisibleProperty Include="SharpProofProfile" />
    <CompilerVisibleProperty Include="SharpProofFeatures" />
    <CompilerVisibleProperty Include="SharpProofMode" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)SharpProof.Attributes\SharpProof.Attributes.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)SharpProof.Analyzer\SharpProof.Analyzer.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)SharpProof.ContractForGenerator\SharpProof.ContractForGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <Analyzer Include="$(MSBuildThisFileDirectory)SharpProof.Attributes\bin\$(Configuration)\netstandard2.0\SharpProof.Attributes.dll" />
    <Analyzer Include="$(MSBuildThisFileDirectory)SharpProof.Contracts\bin\$(Configuration)\netstandard2.0\SharpProof.Contracts.dll" />
    <Analyzer Include="$(MSBuildThisFileDirectory)SharpProof.Dataflow\bin\$(Configuration)\netstandard2.0\SharpProof.Dataflow.dll" />
    <Analyzer Include="$(MSBuildThisFileDirectory)SharpProof.Effects\bin\$(Configuration)\netstandard2.0\SharpProof.Effects.dll" />
    <Analyzer Include="$(MSBuildThisFileDirectory)SharpProof.Frontend\bin\$(Configuration)\netstandard2.0\SharpProof.Frontend.dll" />
    <Analyzer Include="$(MSBuildThisFileDirectory)SharpProof.Ir\bin\$(Configuration)\netstandard2.0\SharpProof.Ir.dll" />
    <Analyzer Include="$(MSBuildThisFileDirectory)SharpProof.Specs\bin\$(Configuration)\netstandard2.0\SharpProof.Specs.dll" />
    <Analyzer Include="$(MSBuildThisFileDirectory)SharpProof.Analyzer\bin\$(Configuration)\netstandard2.0\Microsoft.CodeAnalysis.AnalyzerUtilities.dll" />
  </ItemGroup>
</Project>
