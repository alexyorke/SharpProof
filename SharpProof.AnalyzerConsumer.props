<Project>
  <!-- Import this file after the consuming project's SharpProof settings. -->
  <PropertyGroup>
    <_SharpProofAnalyzerConsumerPresent>true</_SharpProofAnalyzerConsumerPresent>
    <SharpProofSpecificationPacks Condition="'$(SharpProofSpecificationPacks)' == ''"></SharpProofSpecificationPacks>
    <_SharpProofAnalyzerConsumerDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))</_SharpProofAnalyzerConsumerDirectory>
    <_SharpProofConsumerContractPath>$([MSBuild]::Escape('$(MSBuildThisFileDirectory)SharpProof.Package/buildTransitive/SharpProof.ConsumerContract.props'))</_SharpProofConsumerContractPath>
  </PropertyGroup>

  <Import Project="$(_SharpProofConsumerContractPath)" />

  <ItemGroup>
    <CompilerVisibleProperty Include="SharpProofProfile" />
    <CompilerVisibleProperty Include="SharpProofFeatures" />
    <CompilerVisibleProperty Include="SharpProofVerifyPolicy" />
    <CompilerVisibleProperty Include="SharpProofAssumptionPolicy" />
    <CompilerVisibleProperty Include="SharpProofSpecificationPacks" />
    <CompilerVisibleProperty Include="_SharpProofCompilerManifestPath" />
    <CompilerVisibleProperty Include="_SharpProofCompilationTargetFramework" />
    <CompilerVisibleProperty Include="_SharpProofProjectDirectory" />
    <CompilerVisibleProperty Include="SharpProofVerifyMaximumExpressionDepth" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(_SharpProofAnalyzerConsumerDirectory)SharpProof.Attributes\SharpProof.Attributes.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(_SharpProofProfileNormalized)' != 'off'">
    <ProjectReference Include="$(_SharpProofAnalyzerConsumerDirectory)SharpProof.Analyzer\SharpProof.Analyzer.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="$(_SharpProofAnalyzerConsumerDirectory)SharpProof.ContractForGenerator\SharpProof.ContractForGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <Analyzer Include="$(_SharpProofAnalyzerConsumerDirectory)SharpProof.Analyzer.Core\bin\$(Configuration)\netstandard2.0\SharpProof.Analyzer.Core.dll" />
    <Analyzer Include="$(_SharpProofAnalyzerConsumerDirectory)SharpProof.Analyzer.Core\bin\$(Configuration)\netstandard2.0\SharpProof.Contracts.dll" />
    <Analyzer Include="$(_SharpProofAnalyzerConsumerDirectory)SharpProof.Analyzer.Core\bin\$(Configuration)\netstandard2.0\SharpProof.Dataflow.dll" />
    <Analyzer Include="$(_SharpProofAnalyzerConsumerDirectory)SharpProof.Analyzer.Core\bin\$(Configuration)\netstandard2.0\SharpProof.Effects.dll" />
    <Analyzer Include="$(_SharpProofAnalyzerConsumerDirectory)SharpProof.Analyzer.Core\bin\$(Configuration)\netstandard2.0\SharpProof.Frontend.dll" />
    <Analyzer Include="$(_SharpProofAnalyzerConsumerDirectory)SharpProof.Analyzer.Core\bin\$(Configuration)\netstandard2.0\SharpProof.Ir.dll" />
    <Analyzer Include="$(_SharpProofAnalyzerConsumerDirectory)SharpProof.Analyzer.Core\bin\$(Configuration)\netstandard2.0\SharpProof.Specs.dll" />
    <Analyzer Include="$(_SharpProofAnalyzerConsumerDirectory)SharpProof.Analyzer.Core\bin\$(Configuration)\netstandard2.0\System.Buffers.dll" />
    <Analyzer Include="$(_SharpProofAnalyzerConsumerDirectory)SharpProof.Analyzer.Core\bin\$(Configuration)\netstandard2.0\System.Collections.Immutable.dll" />
    <Analyzer Include="$(_SharpProofAnalyzerConsumerDirectory)SharpProof.Analyzer.Core\bin\$(Configuration)\netstandard2.0\System.Memory.dll" />
    <Analyzer Include="$(_SharpProofAnalyzerConsumerDirectory)SharpProof.Analyzer.Core\bin\$(Configuration)\netstandard2.0\System.Numerics.Vectors.dll" />
    <Analyzer Include="$(_SharpProofAnalyzerConsumerDirectory)SharpProof.Analyzer.Core\bin\$(Configuration)\netstandard2.0\System.Reflection.Metadata.dll" />
    <Analyzer Include="$(_SharpProofAnalyzerConsumerDirectory)SharpProof.Analyzer.Core\bin\$(Configuration)\netstandard2.0\System.Runtime.CompilerServices.Unsafe.dll" />
    <Analyzer Include="$(_SharpProofAnalyzerConsumerDirectory)SharpProof.Analyzer.Core\bin\$(Configuration)\netstandard2.0\System.Text.Encoding.CodePages.dll" />
    <Analyzer Include="$(_SharpProofAnalyzerConsumerDirectory)SharpProof.Analyzer.Core\bin\$(Configuration)\netstandard2.0\System.Threading.Tasks.Extensions.dll" />
    <Analyzer Update="$(_SharpProofAnalyzerConsumerDirectory)SharpProof.Analyzer.Core\bin\$(Configuration)\netstandard2.0\*"
              SharpProofSourceTreeDependencyGroup="Portable" />
  </ItemGroup>

  <ItemGroup Condition="'$(SharpProofVerify)' == 'true' AND '$(_SharpProofProfileNormalized)' != 'off' AND '$(DesignTimeBuild)' != 'true'">
    <ProjectReference Include="$(_SharpProofAnalyzerConsumerDirectory)SharpProof.CompilerCollector\SharpProof.CompilerCollector.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <Analyzer Include="$(_SharpProofAnalyzerConsumerDirectory)SharpProof.CompilerCollector\bin\$(Configuration)\netstandard2.0\Microsoft.Bcl.AsyncInterfaces.dll" />
    <Analyzer Include="$(_SharpProofAnalyzerConsumerDirectory)SharpProof.CompilerCollector\bin\$(Configuration)\netstandard2.0\SharpProof.CompilerArtifact.dll" />
    <Analyzer Include="$(_SharpProofAnalyzerConsumerDirectory)SharpProof.CompilerCollector\bin\$(Configuration)\netstandard2.0\SharpProof.Summaries.dll" />
    <Analyzer Include="$(_SharpProofAnalyzerConsumerDirectory)SharpProof.CompilerCollector\bin\$(Configuration)\netstandard2.0\SharpProof.Worker.Protocol.dll" />
    <Analyzer Include="$(_SharpProofAnalyzerConsumerDirectory)SharpProof.CompilerCollector\bin\$(Configuration)\netstandard2.0\System.IO.Pipelines.dll" />
    <Analyzer Include="$(_SharpProofAnalyzerConsumerDirectory)SharpProof.CompilerCollector\bin\$(Configuration)\netstandard2.0\System.Text.Encodings.Web.dll" />
    <Analyzer Include="$(_SharpProofAnalyzerConsumerDirectory)SharpProof.CompilerCollector\bin\$(Configuration)\netstandard2.0\System.Text.Json.dll" />
    <Analyzer Update="$(_SharpProofAnalyzerConsumerDirectory)SharpProof.CompilerCollector\bin\$(Configuration)\netstandard2.0\*"
              SharpProofSourceTreeDependencyGroup="Collector" />
  </ItemGroup>

  <Target Name="_SharpProofApplyMappedAnalyzerConfigurations"
          AfterTargets="AssignProjectConfiguration"
          Condition="'$(_SharpProofProfileNormalized)' != 'off'">
    <ItemGroup>
      <_SharpProofMappedAnalyzerProjectReference
          Include="@(ProjectReferenceWithConfiguration)"
          Condition="'%(ProjectReferenceWithConfiguration.Filename)' == 'SharpProof.Analyzer'" />
      <_SharpProofMappedCollectorProjectReference
          Include="@(ProjectReferenceWithConfiguration)"
          Condition="'%(ProjectReferenceWithConfiguration.Filename)' == 'SharpProof.CompilerCollector'" />
      <_SharpProofDefaultAnalyzerDependency
          Include="@(Analyzer)"
          Condition="'%(Analyzer.SharpProofSourceTreeDependencyGroup)' == 'Portable'" />
      <_SharpProofDefaultCollectorDependency
          Include="@(Analyzer)"
          Condition="'%(Analyzer.SharpProofSourceTreeDependencyGroup)' == 'Collector'" />
    </ItemGroup>
    <PropertyGroup Condition="'@(_SharpProofMappedAnalyzerProjectReference)' != ''">
      <_SharpProofMappedAnalyzerConfiguration>@(_SharpProofMappedAnalyzerProjectReference->'%(Configuration)')</_SharpProofMappedAnalyzerConfiguration>
      <_SharpProofMappedAnalyzerConfiguration Condition="'$(_SharpProofMappedAnalyzerConfiguration)' == ''">$(Configuration)</_SharpProofMappedAnalyzerConfiguration>
      <_SharpProofMappedAnalyzerDependencyDirectory>$(_SharpProofAnalyzerConsumerDirectory)SharpProof.Analyzer.Core\bin\$(_SharpProofMappedAnalyzerConfiguration)\netstandard2.0</_SharpProofMappedAnalyzerDependencyDirectory>
    </PropertyGroup>
    <PropertyGroup Condition="'@(_SharpProofMappedCollectorProjectReference)' != ''">
      <_SharpProofMappedCollectorConfiguration>@(_SharpProofMappedCollectorProjectReference->'%(Configuration)')</_SharpProofMappedCollectorConfiguration>
      <_SharpProofMappedCollectorConfiguration Condition="'$(_SharpProofMappedCollectorConfiguration)' == ''">$(Configuration)</_SharpProofMappedCollectorConfiguration>
      <_SharpProofMappedCollectorDependencyDirectory>$(_SharpProofAnalyzerConsumerDirectory)SharpProof.CompilerCollector\bin\$(_SharpProofMappedCollectorConfiguration)\netstandard2.0</_SharpProofMappedCollectorDependencyDirectory>
    </PropertyGroup>
    <ItemGroup Condition="'$(_SharpProofMappedAnalyzerDependencyDirectory)' != ''">
      <Analyzer Remove="@(_SharpProofDefaultAnalyzerDependency)" />
      <Analyzer Include="@(_SharpProofDefaultAnalyzerDependency->'$(_SharpProofMappedAnalyzerDependencyDirectory)\%(Filename)%(Extension)')" />
    </ItemGroup>
    <ItemGroup Condition="'$(_SharpProofMappedCollectorDependencyDirectory)' != ''">
      <Analyzer Remove="@(_SharpProofDefaultCollectorDependency)" />
      <Analyzer Include="@(_SharpProofDefaultCollectorDependency->'$(_SharpProofMappedCollectorDependencyDirectory)\%(Filename)%(Extension)')" />
    </ItemGroup>
  </Target>

  <Target Name="_SharpProofValidateSourceTreeConfiguration"
          BeforeTargets="CoreCompile"
          DependsOnTargets="_SharpProofValidateConsumerConfiguration"
          Condition="'$(DesignTimeBuild)' != 'true'">
  </Target>

  <Target Name="_SharpProofRequireSourceTreeVerifierPackage"
          BeforeTargets="CoreCompile"
          DependsOnTargets="_SharpProofValidateSourceTreeConfiguration"
          Condition="'$(SharpProofVerify)' == 'true' AND '$(_SharpProofProfileNormalized)' != 'off' AND '$(_SharpProofVerifierPackagePresent)' != 'true' AND '$(DesignTimeBuild)' != 'true' AND '$(BuildingProject)' != 'false'">
    <Error Text="SharpProof verification requires the matching SharpProof.Verifier package. The source-tree analyzer consumer cannot run verification by itself." />
  </Target>
</Project>
