    {"kind":"class","name":"WorkerFileReference","properties":[{"name":"Path","jsonName":"path","order":0,"type":"string","set":true,"default":{"kind":"stringEmpty"}},{"name":"Sha256","jsonName":"sha256","order":1,"type":"string","set":true,"default":{"kind":"stringEmpty"}}]},
    {"kind":"enum","name":"WorkerFeatureSet","underlyingType":"int","flags":false,"members":[{"name":"Unspecified","value":0},{"name":"Effects","value":1},{"name":"Contracts","value":2},{"name":"All","value":3}]},
