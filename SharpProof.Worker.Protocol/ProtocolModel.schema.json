{
  "schemaVersion": 1,
  "namespace": "SharpProof.Worker.Protocol",
  "jsonNamingPolicy": "camelCase",
  "usings": ["System.Collections.Immutable"],
  "versionMembers": {
    "protocol": "WorkerProtocolVersions.Current",
    "manifest": "WorkerManifestVersions.Current",
    "cache": "WorkerCacheVersions.Current"
  },
  "requiredJsonRoots": [
    "WorkerVerifyRequest",
    "WorkerVerifyResponse"
  ],
  "manifestNameEnums": [
    "WorkerSelectedFeature",
    "WorkerSelectionReason",
    "WorkerAssumptionKind",
    "WorkerClaimKind",
    "WorkerClaimEvidence",
    "WorkerEffectContractKind"
  ],
  "definedEnums": [
    "WorkerFeatureSet",
    "WorkerVerifyPolicy",
    "WorkerAssumptionPolicy",
    "WorkerSelectedFeature",
    "WorkerSelectionReason",
    "WorkerClaimKind",
    "WorkerClaimEvidence",
    "WorkerEffectContractKind",
    "WorkerRunStatus",
    "WorkerCallableCoverage",
    "WorkerClaimOutcome",
    "WorkerClaimReason",
    "WorkerEffectEvidenceCertainty",
    "WorkerAssumptionKind"
  ],
  "validationTables": [
    {
      "name": "ClaimShape",
      "parameters": [
        {"name":"kind","type":"WorkerClaimKind"},
        {"name":"evidence","type":"WorkerClaimEvidence"},
        {"name":"effectKind","type":"WorkerEffectContractKind"}
      ],
      "rows": [
        ["Postcondition","DirectClause","Unspecified"],
        ["Postcondition","CompanionClause","Unspecified"],
        ["Postcondition","ReturnAttribute","Unspecified"],
        ["Effect","Attribute","EnforcePure"],
        ["Effect","Attribute","ZeroAllocations"],
        ["Effect","Attribute","AllowedCapabilities"],
        ["Effect","Attribute","DoesNotThrow"],
        ["Effect","Attribute","AllowedExceptions"],
        ["Effect","Attribute","EffectContract"]
      ]
    },
    {
      "name": "CallableCoverage",
      "parameters": [
        {"name":"coverage","type":"WorkerCallableCoverage"},
        {"name":"reason","type":"WorkerCallableCoverageReason"}
      ],
      "rows": [
        ["Complete","None"],
        ["Incomplete","UnsupportedCallable"],
        ["Incomplete","UnsupportedContract"],
        ["Incomplete","SemanticUnknown"],
        ["Incomplete","MissingClaimResult"],
        ["Incomplete","MethodTimeout"],
        ["Incomplete","ProjectTimeout"],
        ["Incomplete","Canceled"],
        ["Incomplete","InfrastructureFailure"]
      ]
    },
    {
      "name": "ClaimOutcome",
      "parameters": [
        {"name":"outcome","type":"WorkerClaimOutcome"},
        {"name":"reason","type":"WorkerClaimReason"}
      ],
      "rows": [
        ["Proven","None"],
        ["Refuted","None"],
        ["Unknown","UnsupportedCallable"],
        ["Unknown","UnsupportedContract"],
        ["Unknown","UnsupportedBody"],
        ["Unknown","UnsupportedExpression"],
        ["Unknown","DeepPostcondition"],
        ["Unknown","MissingReturnValue"],
        ["Unknown","ResourceLimit"],
        ["Unknown","MethodTimeout"],
        ["Unknown","ProjectTimeout"],
        ["Unknown","Canceled"],
        ["Unknown","BackendUnavailable"],
        ["Unknown","InfrastructureFailure"],
        ["Unknown","MalformedBackendResult"],
        ["Unknown","CounterexampleReplayFailed"],
        ["Unknown","PostconditionMayBeUndefined"],
        ["Unknown","CounterexampleNotReplayable"],
        ["Unknown","EffectSummaryIncomplete"],
        ["Unknown","EffectContractNotEstablished"]
      ]
    },
    {
      "name": "EffectCertainty",
      "parameters": [
        {"name":"outcome","type":"WorkerClaimOutcome"},
        {"name":"reason","type":"WorkerClaimReason"},
        {"name":"certainty","type":"WorkerEffectEvidenceCertainty"}
      ],
      "rows": [
        ["Proven","None","CompleteMayEffectSummary"],
        ["Proven","None","TrustedCompleteBoundary"],
        ["Proven","None","VacuousEntry"],
        ["Refuted","None","DefiniteViolation"],
        ["Unknown","EffectSummaryIncomplete","IncompleteMayEffectSummary"],
        ["Unknown","EffectContractNotEstablished","CompleteMayEffectSummary"],
        ["Unknown","*","Unavailable"]
      ]
    },
    {
      "name": "Vacuity",
      "parameters": [
        {"name":"kind","type":"WorkerClaimKind"},
        {"name":"outcome","type":"WorkerClaimOutcome"},
        {"name":"vacuity","type":"WorkerVacuityKind"}
      ],
      "rows": [
        ["*","*","None"],
        ["Postcondition","Proven","ContradictoryPreconditions"],
        ["Postcondition","Proven","NoModeledNormalReturn"],
        ["Effect","Proven","ContradictoryPreconditions"]
      ]
    },
    {
      "name": "RunFailure",
      "parameters": [
        {"name":"status","type":"WorkerRunStatus"},
        {"name":"reason","type":"WorkerRunFailureReason"}
      ],
      "rows": [
        ["Complete","None"],
        ["TimedOut","None"],
        ["Canceled","None"],
        ["Failed","InvalidRequest"],
        ["Failed","InputUnavailable"],
        ["Failed","CompilationFailure"],
        ["Failed","CompilerManifestMismatch"],
        ["Failed","BackendUnavailable"],
        ["Failed","InfrastructureFailure"],
        ["Failed","MalformedResult"],
        ["Failed","CounterexampleReplayFailed"],
        ["Failed","ContainmentFailure"]
      ]
    },
    {
      "name": "CacheState",
      "parameters": [
        {"name":"status","type":"WorkerCacheStatus"},
        {"name":"hit","type":"bool"}
      ],
      "rows": [
        ["Disabled",false],
        ["Miss",false],
        ["Hit",true],
        ["Written",false],
        ["Rejected",false],
        ["Unavailable",false]
      ]
    },
    {
      "name": "ClaimPayload",
      "parameters": [
        {"name":"outcome","type":"WorkerClaimOutcome"},
        {"name":"hasProofCore","type":"bool"},
        {"name":"hasModel","type":"bool"}
      ],
      "rows": [
        ["Proven","*",false],
        ["Refuted",false,"*"],
        ["Unknown",false,false]
      ]
    }
  ],
  "validationPlans": [
    {
      "name": "Request",
      "type": "WorkerVerifyRequest",
      "rules": [
        {"code":"protocol.unsupported","condition":{"op":"equalsMember","property":"ProtocolVersion","member":"WorkerProtocolVersions.Current"}},
        {"code":"project.compiler_manifest","condition":{"op":"all","conditions":[
          {"op":"notNull","property":"CompilerManifest"},
          {"op":"nonBlank","property":"CompilerManifest.Path"},
          {"op":"sha256","property":"CompilerManifest.Sha256"}
        ]}},
        {"code":"cache.null","condition":{"op":"notNull","property":"Cache"}},
        {"code":"cache.maximum_bytes","condition":{"op":"implies",
          "if":{"op":"notNull","property":"Cache"},
          "then":{"op":"between","property":"Cache.MaximumBytes","minimum":1,"maximumMember":"WorkerCacheOptions.DefaultMaximumBytes"}}},
        {"code":"policy.verify","condition":{"op":"defined","property":"VerifyPolicy","unspecified":"WorkerVerifyPolicy.Unspecified"}},
        {"code":"policy.assumption","condition":{"op":"defined","property":"AssumptionPolicy","unspecified":"WorkerAssumptionPolicy.Unspecified"}}
      ]
    },
    {
      "name": "Budgets",
      "type": "WorkerBudgets",
      "rules": [
        {"code":"rlimit","condition":{"op":"positive","property":"QueryRlimit"}},
        {"code":"method_rlimit","condition":{"op":"positive","property":"MethodRlimit"}},
        {"code":"rlimit_order","condition":{"op":"lessOrEqualProperty","property":"QueryRlimit","other":"MethodRlimit"}},
        {"code":"method_wall","condition":{"op":"positive","property":"MethodWallTimeMilliseconds"}},
        {"code":"project_wall","condition":{"op":"positive","property":"ProjectWallTimeMilliseconds"}},
        {"code":"parallelism","condition":{"op":"between","property":"MaxParallelism","minimum":1,"maximumMember":"WorkerBudgets.MaximumParallelism"}},
        {"code":"expression_depth","condition":{"op":"between","property":"MaximumExpressionDepth","minimum":1,"maximum":256}},
        {"code":"process_memory","condition":{"op":"between","property":"ProcessMemoryLimitBytes","minimum":1,"maximumMember":"WorkerBudgets.MaximumProcessMemoryLimitBytes"}},
        {"code":"worker_processes","condition":{"op":"between","property":"MaxWorkerProcesses","minimum":1,"maximumMember":"WorkerBudgets.MaximumParallelism"}},
        {"code":"wall_order","condition":{"op":"lessOrEqualProperty","property":"MethodWallTimeMilliseconds","other":"ProjectWallTimeMilliseconds"}}
      ]
    },
    {
      "name": "SourceLocation",
      "type": "WorkerSourceLocation",
      "mode": "predicate",
      "rules": [
        {"code":"valid","condition":{"op":"all","conditions":[
          {"op":"nonBlank","property":"Path"},
          {"op":"nonNegative","property":"Start"},
          {"op":"nonNegative","property":"Length"},
          {"op":"positive","property":"Line"},
          {"op":"positive","property":"Column"}
        ]}}
      ]
    },
    {
      "name": "ManifestCallable",
      "type": "WorkerCallableManifestEntry",
      "rules": [
        {"code":"selected_features","condition":{"op":"uniqueEnums","property":"SelectedFeatures","unspecified":"WorkerSelectedFeature.Unspecified","nonEmpty":true}},
        {"code":"selection_reasons","condition":{"op":"uniqueEnums","property":"SelectionReasons","unspecified":"WorkerSelectionReason.Unspecified","nonEmpty":true}},
        {"code":"callable_claim_ids","condition":{"op":"distinctNonblank","property":"ClaimIds"}},
        {"code":"callable_assumptions","condition":{"op":"validAssumptions","property":"Assumptions"}},
        {"code":"callable_assumption_usage","condition":{"op":"assumptionsUnused","property":"Assumptions"}}
      ]
    },
    {
      "name": "ManifestClaim",
      "type": "WorkerClaimManifestEntry",
      "rules": [
        {"code":"claim_ordinal","condition":{"op":"nonNegative","property":"Ordinal"}},
        {"code":"claim_kind","condition":{"op":"defined","property":"Kind","unspecified":"WorkerClaimKind.Unspecified"}},
        {"code":"claim_evidence","condition":{"op":"defined","property":"Evidence","unspecified":"WorkerClaimEvidence.Unspecified"}},
        {"code":"claim_shape","condition":{"op":"stateTable","table":"ClaimShape","arguments":[
          {"op":"property","property":"Kind"},
          {"op":"property","property":"Evidence"},
          {"op":"property","property":"EffectContractKind"}
        ]}}
      ]
    },
    {
      "name": "Assumption",
      "type": "WorkerAssumptionEvidence",
      "mode": "predicate",
      "rules": [
        {"code":"valid","condition":{"op":"all","conditions":[
          {"op":"nonBlank","property":"Id"},
          {"op":"defined","property":"Kind","unspecified":"WorkerAssumptionKind.Unspecified"}
        ]}}
      ]
    },
    {
      "name": "CallableResult",
      "type": "WorkerCallableResult",
      "rules": [
        {"code":"response.callable_coverage","condition":{"op":"defined","property":"Coverage","unspecified":"WorkerCallableCoverage.Unspecified"}},
        {"code":"response.callable_reason","condition":{"op":"stateTable","table":"CallableCoverage","arguments":[
          {"op":"property","property":"Coverage"},
          {"op":"property","property":"Reason"}
        ]}},
        {"code":"response.callable_assumptions","condition":{"op":"validAssumptions","property":"Assumptions"}}
      ]
    },
    {
      "name": "ClaimResult",
      "type": "WorkerClaimResult",
      "rules": [
        {"code":"response.claim_outcome","condition":{"op":"defined","property":"Outcome","unspecified":"WorkerClaimOutcome.Unspecified"}},
        {"code":"response.claim_reason","condition":{"op":"stateTable","table":"ClaimOutcome","arguments":[
          {"op":"property","property":"Outcome"},
          {"op":"property","property":"Reason"}
        ]}},
        {"code":"response.proof_core","condition":{"op":"distinctNonblank","property":"ProofCore"}},
        {"code":"response.model","condition":{"op":"validModel","property":"Model"}},
        {"code":"response.assumptions","condition":{"op":"validAssumptions","property":"Assumptions"}},
        {"code":"response.vacuity_evidence","condition":{"op":"implies",
          "if":{"op":"notEqualsMember","property":"Vacuity","member":"WorkerVacuityKind.None"},
          "then":{"op":"hasItems","property":"ProofCore"}}},
        {"code":"response.claim_payload","condition":{"op":"stateTable","table":"ClaimPayload","arguments":[
          {"op":"property","property":"Outcome"},
          {"op":"hasItems","property":"ProofCore"},
          {"op":"hasItems","property":"Model"}
        ]}}
      ]
    },
    {
      "name": "EffectWitness",
      "type": "WorkerEffectViolationWitness",
      "mode": "predicate",
      "rules": [
        {"code":"valid","condition":{"op":"all","conditions":[
          {"op":"nonBlank","property":"Kind"},
          {"op":"nonBlank","property":"Detail"},
          {"op":"knownFlags","property":"Effects"},
          {"op":"knownFlags","property":"Capabilities"},
          {"op":"any","conditions":[
            {"op":"notEqualsMember","property":"Effects","member":"WorkerEffectSet.None"},
            {"op":"notEqualsMember","property":"Capabilities","member":"WorkerEffectCapabilitySet.None"}
          ]},
          {"op":"implies",
            "if":{"op":"hasItems","property":"ExactExceptionTypeHierarchy"},
            "then":{"op":"flagContains","property":"Effects","member":"WorkerEffectSet.Throws"}},
          {"op":"distinctNonblank","property":"ExactExceptionTypeHierarchy"}
        ]}}
      ]
    },
    {
      "name": "Versions",
      "type": "WorkerVersionSummary",
      "mode": "predicate",
      "rules": [
        {"code":"valid","condition":{"op":"all","conditions":[
          {"op":"equalsMember","property":"ProtocolVersion","member":"WorkerProtocolVersions.Current"},
          {"op":"equalsMember","property":"ManifestSchemaVersion","member":"WorkerManifestVersions.Current"},
          {"op":"equalsMember","property":"CacheSchemaVersion","member":"WorkerCacheVersions.Current"},
          {"op":"nonBlank","property":"WorkerVersion"},
          {"op":"nonBlank","property":"ApiSpecVersion"},
          {"op":"sha256","property":"WorkerBinarySha256"},
          {"op":"sha256","property":"ApiSpecContentSha256"}
        ]}}
      ]
    },
    {
      "name": "Summary",
      "type": "WorkerVerificationSummary",
      "rules": [
        {"code":"summary.cache","condition":{"op":"stateTable","table":"CacheState","arguments":[
          {"op":"property","property":"CacheStatus"},
          {"op":"property","property":"CacheHit"}
        ]}},
        {"code":"summary.versions","condition":{"op":"all","conditions":[
          {"op":"notNull","property":"Versions"},
          {"op":"validPlan","property":"Versions","plan":"Versions"}
        ]}},
        {"code":"summary.elapsed","condition":{"op":"nonNegative","property":"ElapsedMilliseconds"}}
      ]
    },
    {
      "name": "ProtocolError",
      "type": "WorkerProtocolError",
      "mode": "predicate",
      "rules": [
        {"code":"valid","condition":{"op":"all","conditions":[
          {"op":"nonBlank","property":"Code"},
          {"op":"nonBlank","property":"Message"}
        ]}}
      ]
    }
  ],
  "manifestIdentity": {
    "domain": "SharpProof.Worker.ManifestHash",
    "versionMember": "WorkerManifestVersions.Current",
    "rootFields": [
      {"label":"manifest.schemaVersion","property":"SchemaVersion","kind":"int"}
    ],
    "collections": [
      {
        "property": "Callables",
        "lengthLabel": "manifest.callables",
        "entryLabel": "callable",
        "order": [
          {"property":"CallableId","kind":"ordinalString"}
        ],
        "fields": [
          {"label":"callable.id","property":"CallableId","kind":"string"},
          {"label":"callable.selectedFeatures","property":"SelectedFeatures","kind":"enumArray"},
          {"label":"callable.selectionReasons","property":"SelectionReasons","kind":"enumArray"},
          {"label":"callable.location","property":"Location","kind":"location"},
          {"label":"callable.claimIds","property":"ClaimIds","kind":"ordinalStringArray"},
          {"label":"callable.assumptions","property":"Assumptions","kind":"assumptionArray"}
        ]
      },
      {
        "property": "Claims",
        "lengthLabel": "manifest.claims",
        "entryLabel": "claim",
        "order": [
          {"property":"CallableId","kind":"ordinalString"},
          {"property":"Ordinal","kind":"integer"},
          {"property":"ClaimId","kind":"ordinalString"}
        ],
        "fields": [
          {"label":"claim.id","property":"ClaimId","kind":"string"},
          {"label":"claim.callableId","property":"CallableId","kind":"string"},
          {"label":"claim.ordinal","property":"Ordinal","kind":"int"},
          {"label":"claim.kind","property":"Kind","kind":"enum","defaultMember":"WorkerClaimKind.Unspecified"},
          {"label":"claim.evidence","property":"Evidence","kind":"enum","defaultMember":"WorkerClaimEvidence.Unspecified"},
          {"label":"claim.effectContractKind","property":"EffectContractKind","kind":"enum","defaultMember":"WorkerEffectContractKind.Unspecified"},
          {"label":"claim.location","property":"Location","kind":"location"}
        ]
      }
    ]
  },
  "declarations": [
    {"kind":"staticClass","name":"WorkerProtocolVersions","constants":[{"name":"Current","type":"string","value":"10"},{"name":"EmptySha256","type":"string","value":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"}]},
    {"kind":"staticClass","name":"WorkerCacheVersions","constants":[{"name":"Current","type":"int","value":12}]},
    {"kind":"staticClass","name":"WorkerManifestVersions","constants":[{"name":"Current","type":"int","value":4}]},
    {"kind":"staticClass","name":"WorkerLauncherDefaults","constants":[{"name":"TerminationGraceMilliseconds","type":"int","value":1000},{"name":"MaximumTerminationGraceMilliseconds","type":"int","value":300000}]},
