root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4
tab_width = 4
max_line_length = 140
dotnet_diagnostic.IDE0055.severity = warning
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_preserve_single_line_blocks = true
csharp_preserve_single_line_statements = false
csharp_prefer_braces = true:warning

# Keep ordinary modern C# conveniences without using style diagnostics to
# collapse declarations solely to satisfy source-size gates.
csharp_style_expression_bodied_accessors = true:suggestion
csharp_style_expression_bodied_constructors = false:warning
csharp_style_expression_bodied_indexers = when_on_single_line:suggestion
csharp_style_expression_bodied_lambdas = true:suggestion
csharp_style_expression_bodied_local_functions = false:warning
csharp_style_expression_bodied_methods = false:warning
csharp_style_expression_bodied_operators = false:warning
csharp_style_expression_bodied_properties = when_on_single_line:suggestion
csharp_style_implicit_object_creation_when_type_is_apparent = true:suggestion
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_style_prefer_primary_constructors = false:suggestion
csharp_style_prefer_simple_using_statement = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
dotnet_style_collection_initializer = true:suggestion
dotnet_style_object_initializer = true:suggestion
dotnet_style_prefer_collection_expression = true:suggestion

# MSBuild discovers these task entry types by public name.
[SharpProof.BuildTasks/{InvalidatePublishedResult,ResetPublishedVerification,RunVerifier,ValidatePublishedVerificationResult}.cs]
dotnet_diagnostic.CA1515.severity = none

# Domain operations are instance members to satisfy their shared abstraction.
[SharpProof.Dataflow/IntervalDomain.cs]
dotnet_diagnostic.CA1822.severity = none

# This value type's operators are the public domain comparison surface.
[SharpProof.Effects/EffectRegions.cs]
dotnet_diagnostic.CA1036.severity = none

# The flags enum intentionally defines a named composite value.
[SharpProof.Effects/EffectValues.cs]
dotnet_diagnostic.CA2217.severity = none

# The struct is an immutable Roslyn-facing value without custom equality.
[SharpProof.Frontend/FrontendSubset.cs]
dotnet_diagnostic.CA1815.severity = none

# Z3 exceptions and native handles cross the solver boundary deliberately.
[SharpProof.Smt/IrSmtBackend.cs]
dotnet_diagnostic.CA1032.severity = none
dotnet_diagnostic.CA1064.severity = none
dotnet_diagnostic.CA2000.severity = none

# Console entry points must remain synchronous for the host contract.
[SharpProof.Worker{,.Launcher}/Program.cs]
dotnet_diagnostic.CA1849.severity = none

# The worker host is instantiated by its external launcher.
[SharpProof.Worker/SharpProofWorker.cs]
dotnet_diagnostic.CA1515.severity = none

# Lowercase hexadecimal is the package's stable wire-format encoding.
[SharpProof.Worker/{CallableVerifier,VerificationCache,WorkerInputSnapshot}.cs]
dotnet_diagnostic.CA1308.severity = none
