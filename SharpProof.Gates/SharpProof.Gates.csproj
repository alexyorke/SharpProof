<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup Condition="'$(SharpProofSourceCommit)' != ''">
    <AssemblyMetadata Include="SharpProofSourceCommit"
                      Value="$(SharpProofSourceCommit)" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\scripts\SharpProof.SymbolPackageValidator.cs"
             Link="Release\SharpProof.SymbolPackageValidator.cs" />
    <Compile Include="..\scripts\SharpProof.JsonDefaults.cs"
             Link="SharpProof.JsonDefaults.cs" />
    <Reference Include="Microsoft.CodeAnalysis"
               HintPath="$(RoslynTargetsPath)\bincore\Microsoft.CodeAnalysis.dll"
               Private="true" />
    <Reference Include="Microsoft.CodeAnalysis.CSharp"
               HintPath="$(RoslynTargetsPath)\bincore\Microsoft.CodeAnalysis.CSharp.dll"
               Private="true" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SharpProof.Analyzer.Core\SharpProof.Analyzer.Core.csproj" />
    <ProjectReference Include="..\SharpProof.Analyzer\SharpProof.Analyzer.csproj" />
    <ProjectReference Include="..\SharpProof.Attributes\SharpProof.Attributes.csproj" />
    <ProjectReference Include="..\SharpProof.CompilerArtifact\SharpProof.CompilerArtifact.csproj" />
    <ProjectReference Include="..\SharpProof.CompilerCollector\SharpProof.CompilerCollector.csproj" />
    <ProjectReference Include="..\SharpProof.ContractForGenerator\SharpProof.ContractForGenerator.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\SharpProof.Worker\SharpProof.Worker.csproj" />
    <ProjectReference Include="..\SharpProof.Worker.Launcher\SharpProof.Worker.Launcher.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SharpProof.Gates.Test" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Corpus\expected.canonical.snapshot"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="Corpus\proven-to-unknown.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
