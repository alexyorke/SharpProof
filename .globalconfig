is_global = true
# IDE0005 cannot run during command-line builds unless every project emits an
# XML documentation file. Use its compiler-native counterpart so unused imports
# are still reported without changing package contents.
dotnet_diagnostic.IDE0005.severity = none
dotnet_diagnostic.CS8019.severity = warning
# Build-visible dead-code inventory. The diagnostic remains warning-level here
# because reflection, MEF, analyzer registration, and serialization can be
# invisible to static reachability analysis; the build may still promote it to
# an error through WarningsAsErrors.
dotnet_diagnostic.CA1811.severity = warning
dotnet_code_quality.CA1811.api_surface = private, internal
dotnet_diagnostic.IDE0051.severity = warning
dotnet_diagnostic.IDE0052.severity = warning
dotnet_diagnostic.IDE0060.severity = warning
# CA1508 is prohibitively expensive on several analyzer control-flow routines
# and has produced false positives for nullable values assigned across branches.
dotnet_diagnostic.CA1508.severity = none
# CA5390 and CA5403 taint-track every value in search of hard-coded keys and
# certificates; on the artifact codecs they took 3.5 of a 4-minute build, and
# the repository uses no symmetric crypto or certificates.
dotnet_diagnostic.CA5390.severity = none
dotnet_diagnostic.CA5403.severity = none
# CA2000 followed every disposable through its callees, which was 128 of the 270
# analyzer seconds in a full Release build. Checking each method on its own keeps
# the rule enforced. Owning wrappers take their resources through constructors,
# so a constructor argument transfers ownership; any other method that leaves
# ownership with its caller or a cache names that with a justified suppression.
dotnet_code_quality.CA2000.interprocedural_analysis_kind = None
dotnet_code_quality.CA2000.dispose_ownership_transfer_at_constructor = true

# CA1062 (validate arguments of public methods) is enabled explicitly so the
# defensive-coding audit keeps its null guards visible in the build.
dotnet_diagnostic.CA1062.severity = warning
# Friend assemblies expose internal nullable-attribute polyfills, which can make
# the BCL [NotNull] annotation ambiguous to the analyzer; name the guards.
dotnet_code_quality.CA1062.null_check_validation_methods = ThrowIfNull|ThrowIfNullOrEmpty|ThrowIfNullOrWhiteSpace
