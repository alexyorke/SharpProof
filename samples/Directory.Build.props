<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <Import Project="../SharpProof.NonProductionDefaults.props" />
  <PropertyGroup>
    <SharpProofSamplePackageVersion>$(SharpProofPackageVersion)</SharpProofSamplePackageVersion>
    <SharpProofProfile>advisory</SharpProofProfile>
    <SharpProofFeatures>all</SharpProofFeatures>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SharpProof"
                      Version="$(SharpProofSamplePackageVersion)" />
  </ItemGroup>
</Project>
