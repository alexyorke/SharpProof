<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org"
         value="https://api.nuget.org/v3/index.json"
         protocolVersion="3" />
    <add key="dotnet-eng"
         value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-eng/nuget/v3/index.json"
         protocolVersion="3" />
  </packageSources>
  <auditSources>
    <clear />
    <add key="nuget.org"
         value="https://api.nuget.org/v3/index.json"
         protocolVersion="3" />
  </auditSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="dotnet-eng">
      <package pattern="Microsoft.DotNet.*" />
      <package pattern="sn" />
      <package pattern="MicroBuild.Core.Sentinel" />
      <package pattern="Microsoft.Signed.Wix" />
      <package pattern="Microsoft.SymbolUploader.Build.Task" />
    </packageSource>
  </packageSourceMapping>
</configuration>
