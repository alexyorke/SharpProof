<Project>
  <PropertyGroup>
    <SharpProofProductName>SharpProof</SharpProofProductName>
    <SharpProofPublisher>Alex Yorke</SharpProofPublisher>
    <SharpProofVersionPrefix>0.1.0</SharpProofVersionPrefix>
    <SharpProofPackageVersion>$(SharpProofVersionPrefix)-preview.1</SharpProofPackageVersion>
    <SharpProofVsixVersion>$(SharpProofVersionPrefix)</SharpProofVsixVersion>
    <SharpProofProductDescription>SharpProof bounded symbolic C# analysis platform for purity, zero-allocation and capability contracts, invariants, runtime hazards, complexity queries, and Z3-backed proofs. Profile-enabled common bug diagnostics cover async, ownership, concurrency, LINQ, and serialization.</SharpProofProductDescription>
    <SharpProofProjectUrl>https://github.com/alexyorke/SharpProof</SharpProofProjectUrl>
  </PropertyGroup>
</Project>
