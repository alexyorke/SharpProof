<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\SharpProof.PackageMetadata.props" />
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsRoslynAnalyzer>true</IsRoslynAnalyzer>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <PackageId>SharpProof.Migration</PackageId>
    <Title>SharpProof contract migration code fix</Title>
    <Description>Migrates legacy SharpProof string attributes to compiler-bound Contract.Requires and Contract.Ensures calls.</Description>
    <PackageReleaseNotes>Install temporarily with SharpProof.Legacy.Attributes while migrating to the 0.2 compiler-bound contract API.</PackageReleaseNotes>
    <PackageTags>SharpProof;Roslyn;CodeFix;Migration</PackageTags>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_AddMigrationCodeFixToOutput</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="4.14.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.14.0" />
    <PackageReference Include="System.Collections.Immutable" Version="9.0.0" />
    <PackageReference Include="System.Composition.AttributedModel" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemDefinitionGroup>
    <TfmSpecificPackageFile>
      <PackagePath>analyzers/dotnet/cs</PackagePath>
    </TfmSpecificPackageFile>
  </ItemDefinitionGroup>
  <Target Name="_AddMigrationCodeFixToOutput">
    <ItemGroup>
      <TfmSpecificPackageFile Include="
          $(TargetDir)SharpProof.Migration.dll;
          $(TargetDir)System.Composition.AttributedModel.dll;
          $(TargetDir)System.Composition.Convention.dll;
          $(TargetDir)System.Composition.Hosting.dll;
          $(TargetDir)System.Composition.Runtime.dll;
          $(TargetDir)System.Composition.TypedParts.dll" />
    </ItemGroup>
  </Target>
</Project>
