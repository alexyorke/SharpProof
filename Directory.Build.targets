<Project>
  <PropertyGroup>
    <SharpProofDogfoodAnalyzerDirectory Condition="'$(SharpProofDogfoodAnalyzerDirectory)' == ''">$(MSBuildThisFileDirectory)SharpProof.Analyzer\bin\$(Configuration)\netstandard2.0</SharpProofDogfoodAnalyzerDirectory>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <!-- Test frameworks discover fixtures through reflection; test awaits do not
         expose a reusable library synchronization-context contract. -->
    <NoWarn>$(NoWarn);CA1515;CA2007;CA5394</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(SharpProofDogfood)' == 'true'">
    <Analyzer Include="$(SharpProofDogfoodAnalyzerDirectory)\SharpProof.Analyzer.dll" />
    <Analyzer Include="$(MSBuildThisFileDirectory)SharpProof.ContractForGenerator\bin\$(Configuration)\netstandard2.0\SharpProof.ContractForGenerator.dll" />
    <Analyzer Include="$(SharpProofDogfoodAnalyzerDirectory)\SharpProof.Attributes.dll" />
    <Analyzer Include="$(SharpProofDogfoodAnalyzerDirectory)\SharpProof.Contracts.dll" />
    <Analyzer Include="$(SharpProofDogfoodAnalyzerDirectory)\SharpProof.Dataflow.dll" />
    <Analyzer Include="$(SharpProofDogfoodAnalyzerDirectory)\SharpProof.Effects.dll" />
    <Analyzer Include="$(SharpProofDogfoodAnalyzerDirectory)\SharpProof.Frontend.dll" />
    <Analyzer Include="$(SharpProofDogfoodAnalyzerDirectory)\SharpProof.Ir.dll" />
    <Analyzer Include="$(SharpProofDogfoodAnalyzerDirectory)\SharpProof.Specs.dll" />
  </ItemGroup>

  <Target Name="_ValidateSharpProofDogfoodAnalyzer"
          BeforeTargets="CoreCompile"
          Condition="'$(SharpProofDogfood)' == 'true'">
    <Error Condition="!Exists('$(SharpProofDogfoodAnalyzerDirectory)\SharpProof.Analyzer.dll')"
           Text="SharpProof dogfood analyzer was not built at '$(SharpProofDogfoodAnalyzerDirectory)\SharpProof.Analyzer.dll'." />
  </Target>
</Project>
