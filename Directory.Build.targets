<Project>
  <ItemGroup Condition="'$(SharpProofProjectName)' != 'ConsoleLoggingAnalyzer' AND '$(SharpProofProjectName)' != 'DefensiveCodingAnalyzer'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/ConsoleLoggingAnalyzer/ConsoleLoggingAnalyzer.csproj"
                      GlobalPropertiesToRemove="BaseIntermediateOutputPath;MSBuildProjectExtensionsPath;IntermediateOutputPath;BaseOutputPath;OutputPath;OutDir"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(SharpProofProjectName)' != 'DefensiveCodingAnalyzer' AND '$(SharpProofProjectName)' != 'SharpProof.Analyzer.Test' AND '$(RunAnalyzersDuringBuild)' != 'false'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/DefensiveCodingAnalyzer/DefensiveCodingAnalyzer.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all"
                      GlobalPropertiesToRemove="BaseIntermediateOutputPath;BaseOutputPath;IntermediateOutputPath;OutputPath;MSBuildProjectExtensionsPath;ProjectAssetsFile" />
  </ItemGroup>
  <Import Project="$(MSBuildThisFileDirectory)eng/self-application/SharpProof.SelfApplication.props"
          Condition="'$(SharpProofSelfApplication)' == 'true' AND Exists('$(MSBuildThisFileDirectory)eng/self-application/SharpProof.SelfApplication.props')" />

  <Target Name="_RequireSharpProofCanonicalContainer"
          BeforeTargets="Restore;PrepareForBuild"
          Condition="'$(SHARPPROOF_CONTAINER)' != '1' Or !Exists('$(SHARPPROOF_CONTAINER_CONTRACT)')">
    <Error Text="SharpProof repository restore, build, test, pack, and release commands must run through the canonical Docker Compose tooling container. See docs/container-development.md." />
  </Target>

  <Target Name="_CopySharpProofCompilerRuntime"
          AfterTargets="Build"
          Condition="'$(SharpProofProjectName)' == 'SharpProof.Gates' Or
                    '$(SharpProofProjectName)' == 'SharpProof.Gates.Test'">
    <Copy SourceFiles="$(RoslynTargetsPath)\bincore\Microsoft.CodeAnalysis.dll;$(RoslynTargetsPath)\bincore\Microsoft.CodeAnalysis.CSharp.dll"
          DestinationFolder="$(TargetDir)" />
  </Target>

  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <!-- Test frameworks discover fixtures through reflection; test awaits do not
         expose a reusable library synchronization-context contract. -->
    <NoWarn>$(NoWarn);CA1515;CA2007;CA5394</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsRoslynAnalyzer)' == 'true'">
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.DotNet.Arcade.Sdk" />
  <!-- Retain the published preview version instead of Arcade's developer/CI suffix. -->
  <PropertyGroup>
    <Version>$(SharpProofPackageVersion)</Version>
    <PackageVersion>$(SharpProofPackageVersion)</PackageVersion>
    <AssemblyVersion>$(SharpProofAssemblyVersion)</AssemblyVersion>
    <FileVersion>$(SharpProofAssemblyVersion)</FileVersion>
    <InformationalVersion>$(SharpProofPackageVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>true</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
