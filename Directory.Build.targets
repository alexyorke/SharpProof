<Project>
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'ConsoleLoggingAnalyzer'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)eng/ConsoleLoggingAnalyzer/ConsoleLoggingAnalyzer.csproj"
                      GlobalPropertiesToRemove="BaseIntermediateOutputPath;MSBuildProjectExtensionsPath;IntermediateOutputPath;BaseOutputPath;OutputPath;OutDir"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'DefensiveCodingAnalyzer'">
    <_DefensiveAnalyzerProject>$(MSBuildThisFileDirectory)eng/DefensiveCodingAnalyzer/DefensiveCodingAnalyzer.csproj</_DefensiveAnalyzerProject>
    <_DefensiveAnalyzerAssembly>$(MSBuildThisFileDirectory)eng/DefensiveCodingAnalyzer/bin/$(Configuration)/netstandard2.0/SharpProof.DefensiveCodingAnalyzer.dll</_DefensiveAnalyzerAssembly>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'DefensiveCodingAnalyzer' AND '$(RunAnalyzersDuringBuild)' != 'false'">
    <Analyzer Include="$(_DefensiveAnalyzerAssembly)" />
  </ItemGroup>

  <Target Name="_RequireDefensiveCodingAnalyzer"
          BeforeTargets="ResolveReferences"
          Condition="'$(MSBuildProjectName)' != 'DefensiveCodingAnalyzer' AND '$(DesignTimeBuild)' != 'true' AND '$(RunAnalyzersDuringBuild)' != 'false'">
    <Error Condition="!Exists('$(_DefensiveAnalyzerAssembly)')"
           Text="Internal defensive analyzer is missing. Build '$(_DefensiveAnalyzerProject)' in the canonical container before building this project." />
  </Target>
  <Import Project="$(MSBuildThisFileDirectory)eng/self-application/SharpProof.SelfApplication.props"
          Condition="'$(SharpProofSelfApplication)' == 'true' AND Exists('$(MSBuildThisFileDirectory)eng/self-application/SharpProof.SelfApplication.props')" />

  <Target Name="_RequireSharpProofCanonicalContainer"
          BeforeTargets="Restore;PrepareForBuild"
          Condition="'$(SHARPPROOF_CONTAINER)' != '1' Or !Exists('$(SHARPPROOF_CONTAINER_CONTRACT)')">
    <Error Text="SharpProof repository restore, build, test, pack, and release commands must run through the canonical Docker Compose tooling container. See docs/container-development.md." />
  </Target>

  <Target Name="_CopySharpProofCompilerRuntime"
          AfterTargets="Build"
          Condition="'$(MSBuildProjectName)' == 'SharpProof.Gates' Or
                    '$(MSBuildProjectName)' == 'SharpProof.Gates.Test'">
    <Copy SourceFiles="$(RoslynTargetsPath)\bincore\Microsoft.CodeAnalysis.dll;$(RoslynTargetsPath)\bincore\Microsoft.CodeAnalysis.CSharp.dll"
          DestinationFolder="$(TargetDir)" />
  </Target>

  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <!-- Test frameworks discover fixtures through reflection; test awaits do not
         expose a reusable library synchronization-context contract. -->
    <NoWarn>$(NoWarn);CA1515;CA2007;CA5394</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsRoslynAnalyzer)' == 'true'">
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

</Project>
