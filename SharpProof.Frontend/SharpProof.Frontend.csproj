<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <SharpProofUsesMetaAnalyzer>true</SharpProofUsesMetaAnalyzer>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.Common" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="System.Collections.Immutable" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\eng\RoslynSymbolFacts.cs"
             Link="RoslynSymbolFacts.cs" />
    <ProjectReference Include="..\SharpProof.Attributes\SharpProof.Attributes.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\SharpProof.Ir\SharpProof.Ir.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SharpProof.Analyzer" />
    <InternalsVisibleTo Include="SharpProof.Analyzer.Core" />
    <InternalsVisibleTo Include="SharpProof.Effects" />
    <InternalsVisibleTo Include="SharpProof.Contracts" />
    <InternalsVisibleTo Include="SharpProof.CompilerCollector" />
    <InternalsVisibleTo Include="SharpProof.Frontend.Test" />
  </ItemGroup>
  <Target Name="GenerateSharpProofAttributesPayloadIdentity"
          BeforeTargets="CoreCompile"
          DependsOnTargets="ResolveProjectReferences">
    <PropertyGroup>
      <_SharpProofAttributesPayloadIdentitySource>$(IntermediateOutputPath)SharpProof.Attributes.PayloadIdentity.g.cs</_SharpProofAttributesPayloadIdentitySource>
      <_SharpProofAttributesPayloadIdentityTemporary>$(IntermediateOutputPath)SharpProof.Attributes.PayloadIdentity.tmp.cs</_SharpProofAttributesPayloadIdentityTemporary>
    </PropertyGroup>
    <MSBuild Projects="..\SharpProof.Attributes\SharpProof.Attributes.csproj"
             Targets="GetTargetPath"
             BuildInParallel="$(BuildInParallel)"
             Properties="Configuration=$(Configuration);Platform=$(Platform);TargetFramework=netstandard2.0">
      <Output TaskParameter="TargetOutputs"
              ItemName="_SharpProofAttributesTargetPath" />
    </MSBuild>
    <Error Condition="'@(_SharpProofAttributesTargetPath)' == ''"
           Text="SharpProof.Attributes target path was not resolved." />
    <GetFileHash Files="@(_SharpProofAttributesTargetPath)"
                 Algorithm="SHA256">
      <Output TaskParameter="Items"
              ItemName="_SharpProofAttributesHashed" />
    </GetFileHash>
    <Exec Command="pwsh -NoLogo -NoProfile -NonInteractive -File &quot;$(MSBuildProjectDirectory)/../scripts/Get-SharpProofModuleVersionId.ps1&quot; -Path &quot;%(_SharpProofAttributesTargetPath.FullPath)&quot;"
          ConsoleToMSBuild="true"
          StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput"
              ItemName="_SharpProofAttributesModuleVersionId" />
    </Exec>
    <Error Condition="'@(_SharpProofAttributesModuleVersionId)' == ''"
           Text="SharpProof.Attributes module version ID was not resolved." />
    <ItemGroup>
      <_SharpProofAttributesPayloadIdentity
          Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>SharpProof.Attributes.SHA256</_Parameter1>
        <_Parameter2>%(_SharpProofAttributesHashed.FileHash)</_Parameter2>
      </_SharpProofAttributesPayloadIdentity>
      <_SharpProofAttributesPayloadIdentity
          Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>SharpProof.Attributes.MVID</_Parameter1>
        <_Parameter2>@(_SharpProofAttributesModuleVersionId)</_Parameter2>
      </_SharpProofAttributesPayloadIdentity>
    </ItemGroup>
    <WriteCodeFragment Language="C#"
                       OutputFile="$(_SharpProofAttributesPayloadIdentityTemporary)"
                       AssemblyAttributes="@(_SharpProofAttributesPayloadIdentity)" />
    <GetFileHash Files="$(_SharpProofAttributesPayloadIdentityTemporary)"
                 Algorithm="SHA256">
      <Output TaskParameter="Items"
              ItemName="_SharpProofAttributesPayloadIdentityTemporaryHash" />
    </GetFileHash>
    <GetFileHash Files="$(_SharpProofAttributesPayloadIdentitySource)"
                 Algorithm="SHA256"
                 Condition="Exists('$(_SharpProofAttributesPayloadIdentitySource)')">
      <Output TaskParameter="Items"
              ItemName="_SharpProofAttributesPayloadIdentitySourceHash" />
    </GetFileHash>
    <PropertyGroup>
      <_SharpProofAttributesPayloadIdentityTemporaryHashValue>@(_SharpProofAttributesPayloadIdentityTemporaryHash->'%(FileHash)')</_SharpProofAttributesPayloadIdentityTemporaryHashValue>
      <_SharpProofAttributesPayloadIdentitySourceHashValue>@(_SharpProofAttributesPayloadIdentitySourceHash->'%(FileHash)')</_SharpProofAttributesPayloadIdentitySourceHashValue>
    </PropertyGroup>
    <Copy SourceFiles="$(_SharpProofAttributesPayloadIdentityTemporary)"
          DestinationFiles="$(_SharpProofAttributesPayloadIdentitySource)"
          Condition="'$(_SharpProofAttributesPayloadIdentityTemporaryHashValue)' != '$(_SharpProofAttributesPayloadIdentitySourceHashValue)'" />
    <ItemGroup>
      <Compile Include="$(_SharpProofAttributesPayloadIdentitySource)" />
    </ItemGroup>
  </Target>
</Project>
