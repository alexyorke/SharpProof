<?xml version="1.0" encoding="utf-8"?>
<Project>
  <Import Sdk="Microsoft.NET.Sdk" Project="Sdk.props" />

  <PropertyGroup>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>SharpProof.Vsix</RootNamespace>
    <AssemblyName>SharpProof.Vsix</AssemblyName>
    
    <IsPackable>false</IsPackable>
    <GenerateVsixContainer>true</GenerateVsixContainer>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildRuntimeType)' == 'Core'">
    <DeployExtension>false</DeployExtension>
  </PropertyGroup>

  <PropertyGroup>
    <GeneratePkgDefFile>false</GeneratePkgDefFile>
    <IncludeAssemblyInVSIXContainer>false</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>false</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>false</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>false</CopyOutputSymbolsToOutputDirectory>
    <VSSDKTargetPlatformRegRootSuffix>Roslyn</VSSDKTargetPlatformRegRootSuffix>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.5.40034" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <VsixReplacement Include="SharpProofProductName" Value="$(SharpProofProductName)" />
    <VsixReplacement Include="SharpProofPublisher" Value="$(SharpProofPublisher)" />
    <VsixReplacement Include="SharpProofVsixVersion" Value="$(SharpProofVsixVersion)" />
    <VsixReplacement Include="SharpProofProductDescription" Value="$(SharpProofProductDescription)" />
  </ItemGroup>

  <PropertyGroup>
    <StartAction>Program</StartAction>
    <StartProgram>$(DevEnvDir)devenv.exe</StartProgram>
    <StartArguments>/rootsuffix $(VSSDKTargetPlatformRegRootSuffix)</StartArguments>
    <AnalyzerPayloadDirectory>$(MSBuildThisFileDirectory)..\SharpProof.Analyzer\bin\$(Configuration)\netstandard2.0</AnalyzerPayloadDirectory>
  </PropertyGroup>

  <Import Sdk="Microsoft.NET.Sdk" Project="Sdk.targets" />

  <Import Project="$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets" 
          Condition="Exists('$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets')" />

  <ItemGroup>
    <ProjectReference Include="..\SharpProof.CodeFixes\SharpProof.CodeFixes.csproj" />
    <ProjectReference Include="..\SharpProof.Analyzer\SharpProof.Analyzer.csproj" />
    <ProjectReference Include="..\SharpProof.Symbolic\SharpProof.Symbolic.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(AnalyzerPayloadDirectory)\Microsoft.Bcl.AsyncInterfaces.dll;
                      $(AnalyzerPayloadDirectory)\System.Buffers.dll;
                      $(AnalyzerPayloadDirectory)\System.Collections.Immutable.dll;
                      $(AnalyzerPayloadDirectory)\System.IO.Pipelines.dll;
                      $(AnalyzerPayloadDirectory)\System.Memory.dll;
                      $(AnalyzerPayloadDirectory)\System.Numerics.Vectors.dll;
                      $(AnalyzerPayloadDirectory)\System.Reflection.Metadata.dll;
                      $(AnalyzerPayloadDirectory)\System.Runtime.CompilerServices.Unsafe.dll;
                      $(AnalyzerPayloadDirectory)\System.Text.Json.dll;
                      $(AnalyzerPayloadDirectory)\System.Threading.Tasks.Extensions.dll">
      <Link>%(Filename)%(Extension)</Link>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
  </ItemGroup>

  <ItemGroup>
    
    <ProjectReference Update="@(ProjectReference)" AdditionalProperties="TargetFramework=netstandard2.0" />

    
    <ProjectReference Update="@(ProjectReference)" Name="%(Filename)" />
  </ItemGroup>

</Project>
