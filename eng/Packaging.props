<Project>
  <PropertyGroup>
    <Authors>$(SharpProofPublisher)</Authors>
    <PackageCopyright>Copyright (c) $(SharpProofPublisher)</PackageCopyright>
    <Copyright>$(PackageCopyright)</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>$(SharpProofProjectUrl)</PackageProjectUrl>
    <RepositoryUrl>$(SharpProofProjectUrl)</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- Retain the published NuGet.org portable-symbol contract. -->
    <SuppressSymbolPackageFormatValidation>true</SuppressSymbolPackageFormatValidation>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <!-- First publication has no compatible prior baseline. Release maintainers
         explicitly pin a reviewed version once one exists. -->
    <PackageValidationBaselineVersion Condition="'$(SharpProofPackageValidationBaselineVersion)' != ''">$(SharpProofPackageValidationBaselineVersion)</PackageValidationBaselineVersion>
    <RepositoryCommit Condition="'$(RepositoryCommit)' == ''">$(GITHUB_SHA)</RepositoryCommit>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)branding/icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
