<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <Import Project="../../SharpProof.NonProductionDefaults.props" />
  <PropertyGroup>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <SharpProofPilotVersion Condition="'$(SharpProofPilotVersion)' == ''">$(SharpProofPackageVersion)</SharpProofPilotVersion>
    <SharpProofProfile Condition="'$(SharpProofProfile)' == ''">advisory</SharpProofProfile>
    <SharpProofFeatures>all</SharpProofFeatures>
    <SharpProofVerify>true</SharpProofVerify>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SharpProof"
                      Version="$(SharpProofPilotVersion)"
                      PrivateAssets="all" />
    <PackageReference Include="SharpProof.Verifier"
                      Version="$(SharpProofPilotVersion)"
                      PrivateAssets="all" />
  </ItemGroup>
</Project>
