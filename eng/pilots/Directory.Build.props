<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <NuGetAudit>false</NuGetAudit>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <SharpProofPilotVersion Condition="'$(SharpProofPilotVersion)' == ''">$(SharpProofPackageVersion)</SharpProofPilotVersion>
    <SharpProofProfile Condition="'$(SharpProofProfile)' == ''">advisory</SharpProofProfile>
    <SharpProofFeatures>all</SharpProofFeatures>
    <SharpProofVerify>true</SharpProofVerify>
    <OutputType>Library</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SharpProof"
                      Version="$(SharpProofPilotVersion)"
                      PrivateAssets="all" />
    <PackageReference Include="SharpProof.Verifier"
                      Version="$(SharpProofPilotVersion)"
                      PrivateAssets="all" />
  </ItemGroup>
</Project>
