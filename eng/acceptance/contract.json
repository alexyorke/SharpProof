{
  "schemaVersion": 3,
  "flagship": "effects",
  "releaseLine": "1.0.0-preview",
  "supportedTargetFrameworks": [
    "netstandard2.0",
    "net8.0",
    "net472"
  ],
  "analyzer": {
    "defaultProfile": "advisory",
    "defaultFeatures": "all",
    "defaultVerifyPolicy": "advisory",
    "defaultAssumptionPolicy": "allow",
    "defaultDiagnosticSeverity": "Info",
    "diagnosticsEnabledByDefault": true,
    "unsupportedUnannotatedCallableBehavior": "silent",
    "unsupportedSelectedCallableDiagnostic": "SP0047"
  },
  "worker": {
    "protocolVersion": 6,
    "manifestSchemaVersion": 2,
    "compilerArtifactSchemaVersion": 3,
    "maximumParallelism": 4,
    "maximumMemoryMiB": 2048,
    "queryRlimit": 3000000,
    "methodRlimit": 20000000,
    "maximumMethodWallSeconds": 10,
    "maximumProjectWallSeconds": 300,
    "cancellationP95Milliseconds": 250,
    "forcedTerminationMilliseconds": 1000
  },
  "cache": {
    "schemaVersion": 7,
    "maximumMiB": 512,
    "cacheableOutcomes": [
      "Proven",
      "Refuted"
    ]
  },
  "trustedKernel": {
    "paths": [
      "SharpProof.Verify/ProofKernel.cs",
      "SharpProof.Verify/Evidence.cs",
      "SharpProof.Verify/Outcomes.cs"
    ],
    "maximumNonblankLines": 275
  },
  "trustedComputingBase": {
    "measurement": "Aggregate nonblank physical lines across the component's repository-relative paths.",
    "components": [
      {
        "name": "discovery",
        "paths": [
          "SharpProof.Analyzer/FinalCompilationCollector.cs",
          "SharpProof.Analyzer/CompilerArtifact/ClaimManifestBuilder.cs",
          "SharpProof.Analyzer/CompilerArtifact/SemanticClaimIdentity.cs",
          "SharpProof.Contracts/ContractClauseInventoryBuilder.cs"
        ],
        "maximumNonblankLines": 1025
      },
      {
        "name": "lowering",
        "paths": [
          "SharpProof.Analyzer/CompilerArtifact/CompilerCallableLowerer.cs",
          "SharpProof.Analyzer/CompilerArtifact/CompilerManifestArtifactProducer.cs",
          "SharpProof.CompilerArtifact/CompilerLoweredArtifact.cs",
          "SharpProof.CompilerArtifact/PortableIrGraphCodec.cs",
          "SharpProof.Contracts/ContractBinder.cs",
          "SharpProof.Contracts/ContractExpressionBinder.cs",
          "SharpProof.Contracts/ContractIntrinsicValidator.cs",
          "SharpProof.Frontend/RoslynOperationLowerer.cs",
          "SharpProof.Frontend/RoslynProgramLowerer.cs"
        ],
        "maximumNonblankLines": 2970
      },
      {
        "name": "execution",
        "paths": [
          "SharpProof.Worker/CallableVerifier.cs",
          "SharpProof.Worker/SpecResultDomainProjection.cs",
          "SharpProof.Worker/SharpProofWorker.cs"
        ],
        "maximumNonblankLines": 930
      },
      {
        "name": "encoding",
        "paths": [
          "SharpProof.Smt/IrSmtBackend.cs"
        ],
        "maximumNonblankLines": 410
      },
      {
        "name": "replay",
        "paths": [
          "SharpProof.Verify/ProofKernel.cs",
          "SharpProof.Ir/IrInterpreter.cs",
          "SharpProof.Ir/IrProgramInterpreter.cs",
          "SharpProof.Worker/CallableCounterexampleReplayer.cs"
        ],
        "maximumNonblankLines": 711
      },
      {
        "name": "policy",
        "paths": [
          "SharpProof.Worker.Launcher/Program.cs",
          "SharpProof.Worker/CallableClaimResultAssembler.cs"
        ],
        "maximumNonblankLines": 590
      },
      {
        "name": "cacheValidation",
        "paths": [
          "SharpProof.CompilerArtifact/CompilerManifestArtifact.cs",
          "SharpProof.Worker.Protocol/ProtocolJson.cs",
          "SharpProof.Worker.Protocol/WorkerResultAssembler.cs",
          "SharpProof.Worker/WorkerInputSnapshot.cs",
          "SharpProof.Worker/VerificationCache.cs"
        ],
        "maximumNonblankLines": 910
      }
    ]
  },
  "productionSize": {
    "maximumPhysicalLines": 19916,
    "maximumNonblankLines": 18376
  },
  "fuzz": {
    "pullRequestCases": 1000,
    "nightlyCases": 10000,
    "maximumParallelism": 4
  },
  "performance": {
    "warmups": 5,
    "samples": 30,
    "maximumMedianRatio": 1.10,
    "maximumP95Ratio": 1.20,
    "maximumRetainedMemoryRatio": 1.05,
    "maximumRetainedMemoryIncreaseMiB": 32,
    "maximumEnabledRetainedCompilations": 0,
    "maximumEnabledRetainedMemoryIncreaseMiB": 32,
    "ideEdits": 200,
    "ideEditP95Milliseconds": 100,
    "ideEditMaximumMilliseconds": 250
  }
}
