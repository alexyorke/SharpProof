<Project TreatAsLocalProperty="BaseIntermediateOutputPath;BaseOutputPath;IntermediateOutputPath;OutputPath;MSBuildProjectExtensionsPath;ProjectAssetsFile;RestoreOutputPath">
  <!-- NuGet restore does not apply ProjectReference.GlobalPropertiesToRemove.
       Keep this shared tool's assets separate from redirected caller outputs. -->
  <PropertyGroup>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)obj/</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)bin/</BaseOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
    <ProjectAssetsFile>$(BaseIntermediateOutputPath)project.assets.json</ProjectAssetsFile>
    <RestoreOutputPath>$(BaseIntermediateOutputPath)</RestoreOutputPath>
    <IntermediateOutputPath />
    <OutputPath />
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsRoslynAnalyzer>true</IsRoslynAnalyzer>
    <AssemblyName>SharpProof.DefensiveCodingAnalyzer</AssemblyName>
    <NoWarn>$(NoWarn);RS1035;RS2002;RS2003;RS2008</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="System.Collections.Immutable" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
