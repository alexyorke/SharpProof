<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\SharpProof.PackageMetadata.props" />
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>SharpProof.PortableAnalyzer</AssemblyName>
    <RootNamespace>SharpProof</RootNamespace>
    <IsRoslynAnalyzer>true</IsRoslynAnalyzer>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <LangVersion>12.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <!-- The shipping compilation preserves audited source behavior from
         projects that are not themselves Roslyn entry-point assemblies. -->
    <NoWarn>$(NoWarn);CA1720;RS1035;RS2002;RS2003;RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="System.Collections.Immutable" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpProof.Attributes\SharpProof.Attributes.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference
      Include="..\SharpProof.Meta.Analyzers\SharpProof.Meta.Analyzers.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\SharpProof.Analyzer\**\*.cs"
             Exclude="..\SharpProof.Analyzer\bin\**\*;..\SharpProof.Analyzer\obj\**\*;..\SharpProof.Analyzer\AssemblyInfo.cs;..\SharpProof.Analyzer\GlobalUsings.cs"
             LinkBase="Sources\SharpProof.Analyzer" />
    <Compile Include="..\SharpProof.ContractForGenerator\**\*.cs"
             Exclude="..\SharpProof.ContractForGenerator\bin\**\*;..\SharpProof.ContractForGenerator\obj\**\*;..\SharpProof.ContractForGenerator\GlobalUsings.cs"
             LinkBase="Sources\SharpProof.ContractForGenerator" />
    <Compile Include="..\SharpProof.Contracts\**\*.cs"
             Exclude="..\SharpProof.Contracts\bin\**\*;..\SharpProof.Contracts\obj\**\*;..\SharpProof.Contracts\AssemblyInfo.cs;..\SharpProof.Contracts\GlobalUsings.cs"
             LinkBase="Sources\SharpProof.Contracts" />
    <Compile Include="..\SharpProof.Dataflow\**\*.cs"
             Exclude="..\SharpProof.Dataflow\bin\**\*;..\SharpProof.Dataflow\obj\**\*;..\SharpProof.Dataflow\Properties\AssemblyInfo.cs;..\SharpProof.Dataflow\GlobalUsings.cs"
             LinkBase="Sources\SharpProof.Dataflow" />
    <Compile Include="..\SharpProof.Effects\**\*.cs"
             Exclude="..\SharpProof.Effects\bin\**\*;..\SharpProof.Effects\obj\**\*;..\SharpProof.Effects\AssemblyInfo.cs;..\SharpProof.Effects\GlobalUsings.cs"
             LinkBase="Sources\SharpProof.Effects" />
    <Compile Include="..\SharpProof.Frontend\**\*.cs"
             Exclude="..\SharpProof.Frontend\bin\**\*;..\SharpProof.Frontend\obj\**\*;..\SharpProof.Frontend\AssemblyInfo.cs;..\SharpProof.Frontend\GlobalUsings.cs"
             LinkBase="Sources\SharpProof.Frontend" />
    <Compile Include="..\SharpProof.Ir\**\*.cs"
             Exclude="..\SharpProof.Ir\bin\**\*;..\SharpProof.Ir\obj\**\*;..\SharpProof.Ir\AssemblyInfo.cs;..\SharpProof.Ir\AtomicFile.cs;..\SharpProof.Ir\GlobalUsings.cs"
             LinkBase="Sources\SharpProof.Ir" />
    <Compile Include="..\SharpProof.Specs\**\*.cs"
             Exclude="..\SharpProof.Specs\bin\**\*;..\SharpProof.Specs\obj\**\*;..\SharpProof.Specs\GlobalUsings.cs"
             LinkBase="Sources\SharpProof.Specs" />
  </ItemGroup>

  <Target Name="GenerateSharpProofPortableAttributesPayloadIdentity"
          BeforeTargets="CoreCompile"
          DependsOnTargets="ResolveProjectReferences">
    <PropertyGroup>
      <_SharpProofPortableAttributesPayloadIdentitySource>$(IntermediateOutputPath)SharpProof.Attributes.PayloadIdentity.g.cs</_SharpProofPortableAttributesPayloadIdentitySource>
      <_SharpProofPortableAttributesPayloadIdentityTemporary>$(IntermediateOutputPath)SharpProof.Attributes.PayloadIdentity.tmp.cs</_SharpProofPortableAttributesPayloadIdentityTemporary>
    </PropertyGroup>
    <MSBuild Projects="..\SharpProof.Attributes\SharpProof.Attributes.csproj"
             Targets="GetTargetPath"
             BuildInParallel="$(BuildInParallel)"
             Properties="Configuration=$(Configuration);Platform=$(Platform);TargetFramework=netstandard2.0">
      <Output TaskParameter="TargetOutputs"
              ItemName="_SharpProofPortableAttributesTargetPath" />
    </MSBuild>
    <Error Condition="'@(_SharpProofPortableAttributesTargetPath)' == ''"
           Text="SharpProof.Attributes target path was not resolved." />
    <GetFileHash Files="@(_SharpProofPortableAttributesTargetPath)"
                 Algorithm="SHA256">
      <Output TaskParameter="Items"
              ItemName="_SharpProofPortableAttributesHashed" />
    </GetFileHash>
    <ItemGroup>
      <_SharpProofPortableAttributesPayloadIdentity
          Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>SharpProof.Attributes.SHA256</_Parameter1>
        <_Parameter2>%(_SharpProofPortableAttributesHashed.FileHash)</_Parameter2>
      </_SharpProofPortableAttributesPayloadIdentity>
    </ItemGroup>
    <WriteCodeFragment
      Language="C#"
      OutputFile="$(_SharpProofPortableAttributesPayloadIdentityTemporary)"
      AssemblyAttributes="@(_SharpProofPortableAttributesPayloadIdentity)" />
    <GetFileHash
      Files="$(_SharpProofPortableAttributesPayloadIdentityTemporary)"
      Algorithm="SHA256">
      <Output TaskParameter="Items"
              ItemName="_SharpProofPortableAttributesPayloadIdentityTemporaryHash" />
    </GetFileHash>
    <GetFileHash
      Files="$(_SharpProofPortableAttributesPayloadIdentitySource)"
      Algorithm="SHA256"
      Condition="Exists('$(_SharpProofPortableAttributesPayloadIdentitySource)')">
      <Output TaskParameter="Items"
              ItemName="_SharpProofPortableAttributesPayloadIdentitySourceHash" />
    </GetFileHash>
    <PropertyGroup>
      <_SharpProofPortableAttributesPayloadIdentityTemporaryHashValue>@(_SharpProofPortableAttributesPayloadIdentityTemporaryHash->'%(FileHash)')</_SharpProofPortableAttributesPayloadIdentityTemporaryHashValue>
      <_SharpProofPortableAttributesPayloadIdentitySourceHashValue>@(_SharpProofPortableAttributesPayloadIdentitySourceHash->'%(FileHash)')</_SharpProofPortableAttributesPayloadIdentitySourceHashValue>
    </PropertyGroup>
    <Copy
      SourceFiles="$(_SharpProofPortableAttributesPayloadIdentityTemporary)"
      DestinationFiles="$(_SharpProofPortableAttributesPayloadIdentitySource)"
      Condition="'$(_SharpProofPortableAttributesPayloadIdentityTemporaryHashValue)' != '$(_SharpProofPortableAttributesPayloadIdentitySourceHashValue)'" />
    <ItemGroup>
      <Compile Include="$(_SharpProofPortableAttributesPayloadIdentitySource)" />
    </ItemGroup>
  </Target>
</Project>
