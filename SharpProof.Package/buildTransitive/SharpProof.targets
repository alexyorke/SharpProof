<Project>
  <PropertyGroup>
    <_SharpProofAnalyzerDirectory>$([System.IO.Path]::GetFullPath('$(SharpProofAnalyzerDirectory)'))</_SharpProofAnalyzerDirectory>
    <_SharpProofAnalyzerPath>$(_SharpProofAnalyzerDirectory)/SharpProof.Analyzer.dll</_SharpProofAnalyzerPath>
    <_SharpProofContractForGeneratorPath Condition="'$(_SharpProofTestContractForGeneratorPath)' == '' and ('$(_SharpProofContractForGeneratorPath)' == '' or '$(_SharpProofContractForGeneratorPathWasDefault)' == 'true')">$(_SharpProofAnalyzerDirectory)/SharpProof.ContractForGenerator.dll</_SharpProofContractForGeneratorPath>
    <_SharpProofContractForGeneratorPath Condition="'$(_SharpProofTestContractForGeneratorPath)' != ''">$([System.IO.Path]::GetFullPath('$(_SharpProofTestContractForGeneratorPath)'))</_SharpProofContractForGeneratorPath>
    <_SharpProofCollectorDirectory>$([System.IO.Path]::GetFullPath('$(SharpProofCollectorDirectory)'))</_SharpProofCollectorDirectory>
    <_SharpProofCompilerCollectorPathConfigured>$([System.String]::Copy('$(SharpProofCompilerCollectorPath)').Trim())</_SharpProofCompilerCollectorPathConfigured>
    <SharpProofCompilerCollectorPath Condition="'$(_SharpProofCompilerCollectorPathConfigured)' == ''">$(_SharpProofCollectorDirectory)/SharpProof.CompilerCollector.dll</SharpProofCompilerCollectorPath>
    <SharpProofCompilerCollectorPath>$([System.IO.Path]::GetFullPath('$(SharpProofCompilerCollectorPath)'))</SharpProofCompilerCollectorPath>
    <SharpProofProfile Condition="'$(SharpProofProfile)' == ''">advisory</SharpProofProfile>
    <SharpProofFeatures Condition="'$(SharpProofFeatures)' == ''">all</SharpProofFeatures>
    <_SharpProofProfileNormalized>$([System.String]::Copy('$(SharpProofProfile)').Trim().ToLowerInvariant())</_SharpProofProfileNormalized>
    <_SharpProofFeaturesNormalized>$([System.String]::Copy('$(SharpProofFeatures)').Trim().ToLowerInvariant())</_SharpProofFeaturesNormalized>
    <SharpProofVerify Condition="'$(SharpProofVerify)' == '' AND '$(_SharpProofProfileNormalized)' == 'strict'">true</SharpProofVerify>
    <SharpProofVerify Condition="'$(SharpProofVerify)' == ''">false</SharpProofVerify>
    <_SharpProofContractsRuntimeEnabled
        Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(DefineConstants)', '(^|[;,])\s*SHARPPROOF_CONTRACTS\s*($|[;,])'))">true</_SharpProofContractsRuntimeEnabled>
  </PropertyGroup>
  <ItemGroup Condition="'$(_SharpProofProfileNormalized)' != 'off'">
    <Analyzer Include="$(_SharpProofAnalyzerPath)">
      <SharpProofAnalyzerRole>EntryPoint</SharpProofAnalyzerRole>
    </Analyzer>
    <Analyzer Include="$(_SharpProofContractForGeneratorPath)">
      <SharpProofAnalyzerRole>Generator</SharpProofAnalyzerRole>
    </Analyzer>
    <Analyzer Include="
        $(_SharpProofSharedDirectory)/SharpProof.Analyzer.Core.dll;
        $(_SharpProofSharedDirectory)/SharpProof.Contracts.dll;
        $(_SharpProofSharedDirectory)/SharpProof.Dataflow.dll;
        $(_SharpProofSharedDirectory)/SharpProof.Effects.dll;
        $(_SharpProofSharedDirectory)/SharpProof.Frontend.dll;
        $(_SharpProofSharedDirectory)/SharpProof.Ir.dll;
        $(_SharpProofSharedDirectory)/SharpProof.Specs.dll;
        $(_SharpProofSharedDirectory)/System.Buffers.dll;
        $(_SharpProofSharedDirectory)/System.Collections.Immutable.dll;
        $(_SharpProofSharedDirectory)/System.Memory.dll;
        $(_SharpProofSharedDirectory)/System.Numerics.Vectors.dll;
        $(_SharpProofSharedDirectory)/System.Reflection.Metadata.dll;
        $(_SharpProofSharedDirectory)/System.Runtime.CompilerServices.Unsafe.dll;
        $(_SharpProofSharedDirectory)/System.Text.Encoding.CodePages.dll;
        $(_SharpProofSharedDirectory)/System.Threading.Tasks.Extensions.dll">
      <SharpProofAnalyzerRole>Dependency</SharpProofAnalyzerRole>
      <Visible>false</Visible>
    </Analyzer>
  </ItemGroup>
  <ItemGroup Condition="'$(SharpProofVerify)' == 'true' AND '$(_SharpProofProfileNormalized)' != 'off' AND '$(DesignTimeBuild)' != 'true'">
    <Analyzer Include="$(SharpProofCompilerCollectorPath)">
      <SharpProofAnalyzerRole>Collector</SharpProofAnalyzerRole>
    </Analyzer>
    <Analyzer Include="
        $(_SharpProofSharedDirectory)/Microsoft.Bcl.AsyncInterfaces.dll;
        $(_SharpProofSharedDirectory)/SharpProof.CompilerArtifact.dll;
        $(_SharpProofSharedDirectory)/SharpProof.Summaries.dll;
        $(_SharpProofSharedDirectory)/SharpProof.Worker.Protocol.dll;
        $(_SharpProofSharedDirectory)/System.IO.Pipelines.dll;
        $(_SharpProofSharedDirectory)/System.Text.Encodings.Web.dll;
        $(_SharpProofSharedDirectory)/System.Text.Json.dll">
      <SharpProofAnalyzerRole>CollectorDependency</SharpProofAnalyzerRole>
      <Visible>false</Visible>
    </Analyzer>
  </ItemGroup>

  <Target Name="_SharpProofValidateConfiguration"
          BeforeTargets="CoreCompile"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="'$(_SharpProofProfileNormalized)' != 'off' AND '$(NETCoreSdkVersion)' == ''"
           Text="SharpProof could not verify the compiler host because NETCoreSdkVersion is unset. SharpProof analysis requires .NET SDK 9.0.300 or newer (Roslyn 4.14 or newer). Set SharpProofProfile=off to omit the analyzer when the compiler host cannot be verified." />
    <Error Condition="'$(_SharpProofProfileNormalized)' != 'off' AND '$(NETCoreSdkVersion)' != '' AND $([MSBuild]::VersionLessThan('$(NETCoreSdkVersion)', '9.0.300'))"
           Text="SharpProof analysis requires .NET SDK 9.0.300 or newer (Roslyn 4.14 or newer). Set SharpProofProfile=off to omit the analyzer on an older compiler host." />
    <Error Condition="'$(SharpProofMode)' != ''"
           Text="SharpProofMode was removed before preview.1. Use SharpProofProfile and SharpProofFeatures." />
    <Error Condition="'$(SharpProofPortableAnalyzerPath)' != ''"
           Text="SharpProofPortableAnalyzerPath was removed before preview.1. Analyzer layout is package-owned; use SharpProofAnalyzerDirectory only for package testing." />
    <Error Condition="'$(_SharpProofProfileNormalized)' != 'advisory' AND '$(_SharpProofProfileNormalized)' != 'strict' AND '$(_SharpProofProfileNormalized)' != 'off'"
           Text="SharpProofProfile must be advisory, strict, or off." />
    <Error Condition="'$(_SharpProofFeaturesNormalized)' != 'effects' AND '$(_SharpProofFeaturesNormalized)' != 'contracts' AND '$(_SharpProofFeaturesNormalized)' != 'all'"
           Text="SharpProofFeatures must be effects, contracts, or all." />
    <Error Condition="'$(SharpProofVerify)' != 'true' AND '$(SharpProofVerify)' != 'false'"
           Text="SharpProofVerify must be true or false." />
    <Error Condition="'$(_SharpProofProfileNormalized)' == 'strict' AND '$(SharpProofVerify)' != 'true'"
           Text="SharpProofProfile=strict requires SharpProofVerify=true; use the advisory profile to make verification optional." />
    <Error Condition="'$(_SharpProofProfileNormalized)' != 'off' AND '$(_SharpProofContractsRuntimeEnabled)' == 'true'"
           Text="SHARPPROOF_CONTRACTS enables runtime evaluation of ghost contracts and is not supported while SharpProof analysis is enabled. Remove it from DefineConstants or set SharpProofProfile=off." />
  </Target>

  <Target Name="_SharpProofRequireVerifierPackage"
          BeforeTargets="CoreCompile"
          DependsOnTargets="_SharpProofValidateConfiguration"
          Condition="'$(SharpProofVerify)' == 'true' AND '$(_SharpProofProfileNormalized)' != 'off' AND '$(_SharpProofVerifierPackagePresent)' != 'true' AND '$(DesignTimeBuild)' != 'true' AND '$(BuildingProject)' != 'false'">
    <Error Text="SharpProof verification requires the matching SharpProof.Verifier package. Portable advisory analysis remains available without the verifier package." />
  </Target>
</Project>
