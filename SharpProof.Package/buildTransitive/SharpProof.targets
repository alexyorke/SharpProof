<Project>
  <UsingTask TaskName="_SharpProofInvalidatePublishedResult"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ResultPath ParameterType="System.String"
                  Required="true" />
      <ProjectDirectory ParameterType="System.String"
                        Required="true" />
      <RequestPath ParameterType="System.String" />
      <ManifestPath ParameterType="System.String" />
      <InvocationRequestPath ParameterType="System.String" />
      <InvocationResultPath ParameterType="System.String" />
      <InvocationManifestPath ParameterType="System.String" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.Linq" />
      <Code Type="Fragment"
            Language="cs"><![CDATA[
        var projectDirectory = System.IO.Path.GetFullPath(ProjectDirectory);
        System.Func<string, string> resolvePath = path =>
            System.IO.Path.GetFullPath(System.IO.Path.IsPathRooted(path)
                ? path
                : System.IO.Path.Combine(projectDirectory, path));
        var resultPath = resolvePath(ResultPath);
        var protectedPaths = new[] {
            RequestPath, ManifestPath, InvocationRequestPath,
            InvocationResultPath, InvocationManifestPath
        };
        var aliasesInput = protectedPaths
            .Where(path => !string.IsNullOrWhiteSpace(path))
            .Select(resolvePath)
            .Any(path => string.Equals(
                resultPath, path, System.StringComparison.OrdinalIgnoreCase));
        if (!aliasesInput) {
            using (var publication =
                new System.Threading.Mutex(false, @"Local\SharpProof.Publish")) {
                var ownsPublication = false;
                try {
                    try {
                        ownsPublication = publication.WaitOne(
                            System.TimeSpan.FromSeconds(30));
                    }
                    catch (System.Threading.AbandonedMutexException) {
                        ownsPublication = true;
                    }
                    if (!ownsPublication)
                        Log.LogError(
                            "Timed out waiting to invalidate the prior SharpProof result.");
                    else if (System.IO.File.Exists(resultPath))
                        System.IO.File.Delete(resultPath);
                }
                finally {
                    if (ownsPublication) publication.ReleaseMutex();
                }
            }
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <PropertyGroup>
    <SharpProofToolsDirectory Condition="'$(SharpProofToolsDirectory)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\tools\net9'))</SharpProofToolsDirectory>
    <_SharpProofToolsDirectory>$([System.IO.Path]::GetFullPath('$(SharpProofToolsDirectory)'))</_SharpProofToolsDirectory>
    <SharpProofWorkerPath Condition="'$(SharpProofWorkerPath)' == ''">$(_SharpProofToolsDirectory)\SharpProof.Worker.dll</SharpProofWorkerPath>
    <SharpProofLauncherPath Condition="'$(SharpProofLauncherPath)' == ''">$(_SharpProofToolsDirectory)\SharpProof.Worker.Launcher.dll</SharpProofLauncherPath>
    <_SharpProofWorkerPath>$([System.IO.Path]::GetFullPath('$(SharpProofWorkerPath)'))</_SharpProofWorkerPath>
    <_SharpProofLauncherPath>$([System.IO.Path]::GetFullPath('$(SharpProofLauncherPath)'))</_SharpProofLauncherPath>
    <_SharpProofProfileProvided Condition="'$(SharpProofProfile)' != ''">true</_SharpProofProfileProvided>
    <_SharpProofFeaturesProvided Condition="'$(SharpProofFeatures)' != ''">true</_SharpProofFeaturesProvided>
    <_SharpProofLegacyModeProvided Condition="'$(SharpProofMode)' != ''">true</_SharpProofLegacyModeProvided>
    <_SharpProofLegacyModeValue>$(SharpProofMode)</_SharpProofLegacyModeValue>
    <_SharpProofLegacyModeNormalized>$([System.String]::Copy('$(SharpProofMode)').ToLowerInvariant())</_SharpProofLegacyModeNormalized>
    <SharpProofProfile Condition="'$(SharpProofProfile)' == '' AND '$(_SharpProofLegacyModeNormalized)' == 'off'">off</SharpProofProfile>
    <SharpProofProfile Condition="'$(SharpProofProfile)' == ''">advisory</SharpProofProfile>
    <SharpProofFeatures Condition="'$(SharpProofFeatures)' == '' AND '$(_SharpProofLegacyModeNormalized)' == 'effects'">effects</SharpProofFeatures>
    <SharpProofFeatures Condition="'$(SharpProofFeatures)' == '' AND '$(_SharpProofLegacyModeNormalized)' == 'contracts'">contracts</SharpProofFeatures>
    <SharpProofFeatures Condition="'$(SharpProofFeatures)' == ''">all</SharpProofFeatures>
    <_SharpProofProfileNormalized>$([System.String]::Copy('$(SharpProofProfile)').ToLowerInvariant())</_SharpProofProfileNormalized>
    <_SharpProofFeaturesNormalized>$([System.String]::Copy('$(SharpProofFeatures)').ToLowerInvariant())</_SharpProofFeaturesNormalized>
    <_SharpProofEffectiveLegacyMode Condition="'$(_SharpProofProfileNormalized)' == 'off'">off</_SharpProofEffectiveLegacyMode>
    <_SharpProofEffectiveLegacyMode Condition="'$(_SharpProofProfileNormalized)' != 'off' AND '$(_SharpProofFeaturesNormalized)' == 'effects'">effects</_SharpProofEffectiveLegacyMode>
    <_SharpProofEffectiveLegacyMode Condition="'$(_SharpProofProfileNormalized)' != 'off' AND '$(_SharpProofFeaturesNormalized)' == 'contracts'">contracts</_SharpProofEffectiveLegacyMode>
    <_SharpProofEffectiveLegacyMode Condition="'$(_SharpProofProfileNormalized)' != 'off' AND '$(_SharpProofFeaturesNormalized)' == 'all'">all-experimental</_SharpProofEffectiveLegacyMode>
    <SharpProofMode>$(_SharpProofEffectiveLegacyMode)</SharpProofMode>
    <SharpProofVerifyPolicy Condition="'$(SharpProofVerifyPolicy)' == '' AND '$(_SharpProofProfileNormalized)' == 'strict'">require-proven</SharpProofVerifyPolicy>
    <SharpProofVerifyPolicy Condition="'$(SharpProofVerifyPolicy)' == ''">advisory</SharpProofVerifyPolicy>
    <SharpProofAssumptionPolicy Condition="'$(SharpProofAssumptionPolicy)' == '' AND '$(_SharpProofProfileNormalized)' == 'strict'">error</SharpProofAssumptionPolicy>
    <SharpProofAssumptionPolicy Condition="'$(SharpProofAssumptionPolicy)' == ''">allow</SharpProofAssumptionPolicy>
    <SharpProofVerify Condition="'$(SharpProofVerify)' == '' AND '$(_SharpProofProfileNormalized)' == 'strict'">true</SharpProofVerify>
    <SharpProofVerify Condition="'$(SharpProofVerify)' == ''">false</SharpProofVerify>
    <_SharpProofVerifyPolicyNormalized>$([System.String]::Copy('$(SharpProofVerifyPolicy)').ToLowerInvariant())</_SharpProofVerifyPolicyNormalized>
    <_SharpProofAssumptionPolicyNormalized>$([System.String]::Copy('$(SharpProofAssumptionPolicy)').ToLowerInvariant())</_SharpProofAssumptionPolicyNormalized>
  </PropertyGroup>
  <ItemGroup Condition="'$(_SharpProofProfileNormalized)' != 'off'">
    <Analyzer Include="
        $(_SharpProofAnalyzerDirectory)/SharpProof.Analyzer.dll;
        $(SharpProofContractForGeneratorPath)">
      <SharpProofAnalyzerRole>EntryPoint</SharpProofAnalyzerRole>
    </Analyzer>
    <!--
      Roslyn registers dependency locations only for compiler analyzer
      references. Keep this list explicit and managed-only; the previous
      backslash wildcard was not portable to non-Windows hosts.
    -->
    <Analyzer Include="
        $(_SharpProofAnalyzerDirectory)/Microsoft.Bcl.AsyncInterfaces.dll;
        $(_SharpProofAnalyzerDirectory)/SharpProof.Attributes.dll;
        $(_SharpProofAnalyzerDirectory)/SharpProof.CompilerArtifact.dll;
        $(_SharpProofAnalyzerDirectory)/SharpProof.Contracts.dll;
        $(_SharpProofAnalyzerDirectory)/SharpProof.Dataflow.dll;
        $(_SharpProofAnalyzerDirectory)/SharpProof.Effects.dll;
        $(_SharpProofAnalyzerDirectory)/SharpProof.Frontend.dll;
        $(_SharpProofAnalyzerDirectory)/SharpProof.Ir.dll;
        $(_SharpProofAnalyzerDirectory)/SharpProof.Specs.dll;
        $(_SharpProofAnalyzerDirectory)/SharpProof.Worker.Protocol.dll;
        $(_SharpProofAnalyzerDirectory)/System.Buffers.dll;
        $(_SharpProofAnalyzerDirectory)/System.Collections.Immutable.dll;
        $(_SharpProofAnalyzerDirectory)/System.IO.Pipelines.dll;
        $(_SharpProofAnalyzerDirectory)/System.Memory.dll;
        $(_SharpProofAnalyzerDirectory)/System.Numerics.Vectors.dll;
        $(_SharpProofAnalyzerDirectory)/System.Reflection.Metadata.dll;
        $(_SharpProofAnalyzerDirectory)/System.Runtime.CompilerServices.Unsafe.dll;
        $(_SharpProofAnalyzerDirectory)/System.Text.Encoding.CodePages.dll;
        $(_SharpProofAnalyzerDirectory)/System.Text.Encodings.Web.dll;
        $(_SharpProofAnalyzerDirectory)/System.Text.Json.dll;
        $(_SharpProofAnalyzerDirectory)/System.Threading.Tasks.Extensions.dll">
      <SharpProofAnalyzerRole>Dependency</SharpProofAnalyzerRole>
      <Visible>false</Visible>
    </Analyzer>
  </ItemGroup>

  <Target Name="_SharpProofValidateConfiguration"
          BeforeTargets="CoreCompile"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="'$(_SharpProofLegacyModeProvided)' == 'true' AND '$(_SharpProofLegacyModeNormalized)' != 'off' AND '$(_SharpProofLegacyModeNormalized)' != 'effects' AND '$(_SharpProofLegacyModeNormalized)' != 'contracts' AND '$(_SharpProofLegacyModeNormalized)' != 'all-experimental'"
           Text="SharpProofMode must be off, effects, contracts, or all-experimental while the preview compatibility alias remains available." />
    <Error Condition="'$(_SharpProofLegacyModeProvided)' == 'true' AND ('$(_SharpProofProfileProvided)' == 'true' OR '$(_SharpProofFeaturesProvided)' == 'true')"
           Text="Do not combine deprecated SharpProofMode with SharpProofProfile or SharpProofFeatures." />
    <Error Condition="'$(_SharpProofProfileNormalized)' != 'advisory' AND '$(_SharpProofProfileNormalized)' != 'strict' AND '$(_SharpProofProfileNormalized)' != 'off'"
           Text="SharpProofProfile must be advisory, strict, or off." />
    <Error Condition="'$(_SharpProofFeaturesNormalized)' != 'effects' AND '$(_SharpProofFeaturesNormalized)' != 'contracts' AND '$(_SharpProofFeaturesNormalized)' != 'all'"
           Text="SharpProofFeatures must be effects, contracts, or all." />
    <Error Condition="'$(SharpProofVerify)' != 'true' AND '$(SharpProofVerify)' != 'false'"
           Text="SharpProofVerify must be true or false." />
    <Error Condition="'$(_SharpProofProfileNormalized)' == 'strict' AND '$(SharpProofVerify)' != 'true'"
           Text="SharpProofProfile=strict requires SharpProofVerify=true; use the advisory profile to make verification optional." />
    <Warning Condition="'$(_SharpProofLegacyModeProvided)' == 'true'"
             Text="SharpProofMode='$(_SharpProofLegacyModeValue)' is deprecated during preview. Use SharpProofProfile and SharpProofFeatures; all-experimental maps to SharpProofFeatures=all." />
  </Target>

  <Target Name="_SharpProofInitializeVerify"
          BeforeTargets="GenerateMSBuildEditorConfigFileShouldRun;GenerateMSBuildEditorConfigFile">
    <PropertyGroup>
      <_SharpProofVerifyDirectory>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)SharpProof'))))</_SharpProofVerifyDirectory>
      <SharpProofVerifyRequestFile Condition="'$(SharpProofVerifyRequestFile)' == ''">$(_SharpProofVerifyDirectory)\request.json</SharpProofVerifyRequestFile>
      <SharpProofVerifyResultFile Condition="'$(SharpProofVerifyResultFile)' == ''">$(_SharpProofVerifyDirectory)\result.json</SharpProofVerifyResultFile>
      <SharpProofCompilerManifestFile Condition="'$(SharpProofCompilerManifestFile)' == ''">$(_SharpProofVerifyDirectory)\compiler-manifest.json</SharpProofCompilerManifestFile>
      <SharpProofVerifyCacheDirectory Condition="'$(SharpProofVerifyCacheDirectory)' == ''">$(_SharpProofVerifyDirectory)\cache</SharpProofVerifyCacheDirectory>
      <_SharpProofInvocationId Condition="'$(_SharpProofInvocationId)' == ''">$([System.Guid]::NewGuid().ToString('N'))</_SharpProofInvocationId>
      <_SharpProofInvocationDirectory>$(_SharpProofVerifyDirectory)\runs\$(_SharpProofInvocationId)</_SharpProofInvocationDirectory>
      <_SharpProofInvocationRequestFile>$(_SharpProofInvocationDirectory)\request.json</_SharpProofInvocationRequestFile>
      <_SharpProofInvocationResultFile>$(_SharpProofInvocationDirectory)\result.json</_SharpProofInvocationResultFile>
    </PropertyGroup>
    <PropertyGroup Condition="'$(SharpProofVerify)' == 'true' AND '$(_SharpProofProfileNormalized)' != 'off' AND '$(OS)' == 'Windows_NT' AND '$(DesignTimeBuild)' != 'true' AND '$(BuildingProject)' != 'false'">
      <_SharpProofCompilationTargetFramework>$(TargetFramework)</_SharpProofCompilationTargetFramework>
      <_SharpProofCompilerManifestPath>$(_SharpProofInvocationDirectory)\compiler-manifest.json</_SharpProofCompilerManifestPath>
      <_SharpProofProjectDirectory>$(MSBuildProjectDirectory)</_SharpProofProjectDirectory>
    </PropertyGroup>
    <_SharpProofInvalidatePublishedResult
        Condition="'$(SharpProofVerify)' == 'true' AND '$(_SharpProofProfileNormalized)' != 'off' AND '$(OS)' == 'Windows_NT' AND '$(DesignTimeBuild)' != 'true'"
        ResultPath="$(SharpProofVerifyResultFile)"
        ProjectDirectory="$(MSBuildProjectDirectory)"
        RequestPath="$(SharpProofVerifyRequestFile)"
        ManifestPath="$(SharpProofCompilerManifestFile)"
        InvocationRequestPath="$(_SharpProofInvocationRequestFile)"
        InvocationResultPath="$(_SharpProofInvocationResultFile)"
        InvocationManifestPath="$(_SharpProofCompilerManifestPath)" />
  </Target>

  <Target Name="_SharpProofVerifyCore"
          DependsOnTargets="_SharpProofInitializeVerify;ResolveReferences">
    <Error Condition="'$(_SharpProofVerifyPolicyNormalized)' != 'advisory' AND '$(_SharpProofVerifyPolicyNormalized)' != 'warn-on-unknown' AND '$(_SharpProofVerifyPolicyNormalized)' != 'require-proven'"
           Text="SharpProofVerifyPolicy must be advisory, warn-on-unknown, or require-proven." />
    <Error Condition="'$(_SharpProofAssumptionPolicyNormalized)' != 'allow' AND '$(_SharpProofAssumptionPolicyNormalized)' != 'warn' AND '$(_SharpProofAssumptionPolicyNormalized)' != 'error'"
           Text="SharpProofAssumptionPolicy must be allow, warn, or error." />
    <Error Code="SP0049"
           Condition="!Exists('$(_SharpProofCompilerManifestPath)')"
           Text="SharpProof did not receive the required final compiler manifest." />
    <Error Condition="!Exists('$(_SharpProofLauncherPath)')"
           Text="SharpProof verifier launcher was not found at '$(_SharpProofLauncherPath)'." />
    <Error Condition="!Exists('$(_SharpProofWorkerPath)')"
           Text="SharpProof verifier worker was not found at '$(_SharpProofWorkerPath)'." />
    <MakeDir Directories="$(_SharpProofInvocationDirectory)" />
    <Exec Command="&quot;$(SharpProofDotNetHost)&quot; &quot;$(_SharpProofLauncherPath)&quot; verify --worker &quot;$(_SharpProofWorkerPath)&quot; --request &quot;$(_SharpProofInvocationRequestFile)&quot; --result &quot;$(_SharpProofInvocationResultFile)&quot; --publish-request &quot;$(SharpProofVerifyRequestFile)&quot; --publish-result &quot;$(SharpProofVerifyResultFile)&quot; --compiler-manifest &quot;$(_SharpProofCompilerManifestPath)&quot; --publish-compiler-manifest &quot;$(SharpProofCompilerManifestFile)&quot; --verify-policy &quot;$(_SharpProofVerifyPolicyNormalized)&quot; --assumption-policy &quot;$(_SharpProofAssumptionPolicyNormalized)&quot; --query-rlimit &quot;$(SharpProofVerifyQueryRlimit)&quot; --method-rlimit &quot;$(SharpProofVerifyMethodRlimit)&quot; --method-wall-ms &quot;$(SharpProofVerifyMethodWallTimeMilliseconds)&quot; --project-wall-ms &quot;$(SharpProofVerifyProjectWallTimeMilliseconds)&quot; --max-parallelism &quot;$(SharpProofVerifyMaxParallelism)&quot; --max-expression-depth &quot;$(SharpProofVerifyMaximumExpressionDepth)&quot; --process-memory-bytes &quot;$(SharpProofVerifyProcessMemoryLimitBytes)&quot; --max-worker-processes &quot;$(SharpProofVerifyMaxWorkerProcesses)&quot; --termination-grace-ms &quot;$(SharpProofVerifyTerminationGraceMilliseconds)&quot; --cache-enabled &quot;$(SharpProofVerifyCacheEnabled)&quot; --cache-directory &quot;$(SharpProofVerifyCacheDirectory)&quot; --cache-maximum-bytes &quot;$(SharpProofVerifyCacheMaximumBytes)&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          StandardOutputImportance="High"
          StandardErrorImportance="High"
          IgnoreExitCode="true">
      <Output TaskParameter="ExitCode"
              PropertyName="_SharpProofVerifierExitCode" />
    </Exec>
    <RemoveDir Directories="$(_SharpProofInvocationDirectory)" />
    <Error Condition="'$(_SharpProofVerifierExitCode)' != '0'"
           Text="SharpProof verifier failed with exit code $(_SharpProofVerifierExitCode)." />
    <Message Importance="High"
             Text="SharpProof verifier result: $(SharpProofVerifyResultFile)" />
  </Target>

  <Target Name="SharpProofVerify"
          AfterTargets="CoreCompile"
          DependsOnTargets="_SharpProofInitializeVerify;_SharpProofVerifyCore"
          Condition="'$(SharpProofVerify)' == 'true' AND '$(_SharpProofProfileNormalized)' != 'off' AND '$(OS)' == 'Windows_NT' AND '$(DesignTimeBuild)' != 'true' AND '$(BuildingProject)' != 'false'" />

  <Target Name="SharpProofRejectUnsupportedWorkerHost"
          AfterTargets="CoreCompile"
           Condition="'$(SharpProofVerify)' == 'true' AND '$(_SharpProofProfileNormalized)' != 'off' AND '$(OS)' != 'Windows_NT' AND '$(DesignTimeBuild)' != 'true' AND '$(BuildingProject)' != 'false'">
    <Error Text="SharpProof out-of-process verification is supported only on Windows x64. Portable analyzer profiles remain available on this host." />
  </Target>
</Project>
