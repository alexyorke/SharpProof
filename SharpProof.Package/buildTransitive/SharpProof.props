<Project>
  <PropertyGroup>
    <_SharpProofPortablePackagePresent>true</_SharpProofPortablePackagePresent>
    <SharpProofAnalyzerDirectory Condition="'$(SharpProofAnalyzerDirectory)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../tools/analyzers/dotnet/cs'))</SharpProofAnalyzerDirectory>
    <_SharpProofContractForGeneratorPathWasDefault Condition="'$(_SharpProofContractForGeneratorPath)' == ''">true</_SharpProofContractForGeneratorPathWasDefault>
    <_SharpProofContractForGeneratorPath Condition="'$(_SharpProofContractForGeneratorPath)' == ''">$(_SharpProofAnalyzerDirectory)/SharpProof.ContractForGenerator.dll</_SharpProofContractForGeneratorPath>
    <_SharpProofSharedDirectory Condition="'$(_SharpProofSharedDirectory)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../tools/shared/netstandard2.0'))</_SharpProofSharedDirectory>
    <SharpProofCollectorDirectory Condition="'$(SharpProofCollectorDirectory)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../tools/collector'))</SharpProofCollectorDirectory>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="SharpProofProfile;SharpProofFeatures;SharpProofSpecificationPacks" />
  </ItemGroup>
</Project>
