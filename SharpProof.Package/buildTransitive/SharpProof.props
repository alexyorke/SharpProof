<Project>
  <PropertyGroup>
    <_SharpProofPortablePackagePresent>true</_SharpProofPortablePackagePresent>
    <SharpProofAnalyzerDirectory Condition="'$(SharpProofAnalyzerDirectory)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../tools/analyzers/dotnet/cs'))</SharpProofAnalyzerDirectory>
    <_SharpProofAnalyzerDirectory>$([System.IO.Path]::GetFullPath('$(SharpProofAnalyzerDirectory)'))</_SharpProofAnalyzerDirectory>
    <SharpProofContractForGeneratorPath Condition="'$(SharpProofContractForGeneratorPath)' == ''">$(_SharpProofAnalyzerDirectory)/SharpProof.ContractForGenerator.dll</SharpProofContractForGeneratorPath>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="SharpProofProfile" />
    <CompilerVisibleProperty Include="SharpProofFeatures" />
    <CompilerVisibleProperty Include="SharpProofMode" />
  </ItemGroup>
</Project>
