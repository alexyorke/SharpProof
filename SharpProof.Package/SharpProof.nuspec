<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>SharpProof</id>
    <version>$version$</version>
    <title>SharpProof</title>
    <authors>Alex Yorke</authors>
    <license type="expression">MIT</license>
    <readme>README.md</readme>
    <projectUrl>https://github.com/alexyorke/SharpProof</projectUrl>
    <description>SharpProof soundness-first C# effect analysis for purity, zero-allocation, capabilities, exception contracts, and compiler-bound preconditions. Unsupported code is handled conservatively and proof-producing features are opt-in.</description>
    <releaseNotes>Breaking 0.2 preview with opt-in effect analysis, compiler-bound preconditions, fail-closed language gating, and conservative external boundaries.</releaseNotes>
    <copyright>Copyright (c) Alex Yorke</copyright>
    <tags>SharpProof Roslyn Analyzer Purity StaticAnalysis MethodEffects Capabilities ZeroAllocations ExceptionContracts Preconditions Contracts</tags>
    <repository type="git" url="https://github.com/alexyorke/SharpProof" commit="$repositorycommit$" />
    <dependencies>
      <group targetFramework=".NETStandard2.0">
        <dependency id="SharpProof.Attributes" version="[$version$]" />
      </group>
    </dependencies>
  </metadata>
  <files>
