<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\SharpProof.PackageMetadata.props" />
  <PropertyGroup>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <NuspecFile>SharpProof.nuspec</NuspecFile>
    <NuspecBasePath>$(MSBuildProjectDirectory)</NuspecBasePath>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>
  <PropertyGroup>
    <PackageId>SharpProof</PackageId>
    <Title>$(SharpProofProductName)</Title>
    <Description>$(SharpProofProductDescription)</Description>
    <PackageReleaseNotes>SharpProof 1.0 preview with opt-in effect analysis, compiler-bound contracts, accountable bounded postcondition verification, fail-closed language gating, and conservative external boundaries.</PackageReleaseNotes>
    <Copyright>Copyright (c) Alex Yorke</Copyright>
    <PackageTags>SharpProof;Roslyn;Analyzer;Purity;StaticAnalysis;MethodEffects;Capabilities;ZeroAllocations;ExceptionContracts;Preconditions;Contracts</PackageTags>
    <NoPackageAnalysis>true</NoPackageAnalysis>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SharpProof.Attributes\SharpProof.Attributes.csproj"
                      PrivateAssets="all"
                      TreatAsPackageReference="false" />
    <ProjectReference Include="..\SharpProof.CompilerCollector\SharpProof.CompilerCollector.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      PrivateAssets="all"
                      TreatAsPackageReference="false" />
    <ProjectReference Include="..\SharpProof.PortableAnalyzer\SharpProof.PortableAnalyzer.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      PrivateAssets="all"
                      TreatAsPackageReference="false" />
  </ItemGroup>
  <Target Name="_SharpProofPrepareNuspecProperties"
          BeforeTargets="GenerateNuspec">
    <PropertyGroup>
      <NuspecProperties>version=$(SharpProofPackageVersion);configuration=$(Configuration);repositorycommit=$(RepositoryCommit)</NuspecProperties>
    </PropertyGroup>
  </Target>
</Project>
