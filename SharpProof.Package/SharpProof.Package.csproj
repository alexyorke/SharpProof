<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\SharpProof.PackageMetadata.props" />
  <PropertyGroup>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>
  <PropertyGroup>
    <PackageId>SharpProof</PackageId>
    <Title>$(SharpProofProductName)</Title>
    <Description>$(SharpProofProductDescription)</Description>
    <PackageReleaseNotes>Breaking 0.2 preview with opt-in effect analysis, compiler-bound preconditions, fail-closed language gating, and conservative external boundaries.</PackageReleaseNotes>
    <Copyright>Copyright (c) Alex Yorke</Copyright>
    <PackageTags>SharpProof;Roslyn;Analyzer;Purity;StaticAnalysis;MethodEffects;Capabilities;ZeroAllocations;ExceptionContracts;Preconditions;Contracts;SMT;Z3</PackageTags>
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_AddAnalyzersToOutput</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SharpProof.Analyzer\SharpProof.Analyzer.csproj" />
    <ProjectReference Include="..\SharpProof.ContractForGenerator\SharpProof.ContractForGenerator.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      PrivateAssets="all" />
    <ProjectReference Include="..\SharpProof.Worker\SharpProof.Worker.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      PrivateAssets="all" />
    <ProjectReference Include="..\SharpProof.Worker.Launcher\SharpProof.Worker.Launcher.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <None Include="buildTransitive/SharpProof.props" Pack="true" PackagePath="buildTransitive/SharpProof.props" />
    <None Include="buildTransitive/SharpProof.targets" Pack="true" PackagePath="buildTransitive/SharpProof.targets" />
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="\" />
  </ItemGroup>
  <PropertyGroup>
    <AnalyzerPayloadDirectory>..\SharpProof.Analyzer\bin\$(Configuration)\netstandard2.0</AnalyzerPayloadDirectory>
    <ContractForGeneratorPayloadPath>..\SharpProof.ContractForGenerator\bin\$(Configuration)\netstandard2.0\SharpProof.ContractForGenerator.dll</ContractForGeneratorPayloadPath>
    <AttributesPayloadPath>..\SharpProof.Attributes\bin\$(Configuration)\netstandard2.0\SharpProof.Attributes.dll</AttributesPayloadPath>
    <WorkerPayloadDirectory>..\SharpProof.Worker\bin\$(Configuration)\net9.0</WorkerPayloadDirectory>
    <LauncherPayloadDirectory>..\SharpProof.Worker.Launcher\bin\$(Configuration)\net9.0</LauncherPayloadDirectory>
  </PropertyGroup>
  <Target Name="_AddAnalyzersToOutput">
    <ItemGroup>
      <TfmSpecificPackageFile Include="
          $(AnalyzerPayloadDirectory)\SharpProof.Analyzer.dll;
          $(ContractForGeneratorPayloadPath);
          $(AnalyzerPayloadDirectory)\Microsoft.Bcl.AsyncInterfaces.dll;
          $(AnalyzerPayloadDirectory)\SharpProof.Attributes.dll;
          $(AnalyzerPayloadDirectory)\SharpProof.CompilerArtifact.dll;
          $(AnalyzerPayloadDirectory)\SharpProof.Contracts.dll;
          $(AnalyzerPayloadDirectory)\SharpProof.Dataflow.dll;
          $(AnalyzerPayloadDirectory)\SharpProof.Effects.dll;
          $(AnalyzerPayloadDirectory)\SharpProof.Frontend.dll;
          $(AnalyzerPayloadDirectory)\SharpProof.Ir.dll;
          $(AnalyzerPayloadDirectory)\SharpProof.Specs.dll;
          $(AnalyzerPayloadDirectory)\SharpProof.Worker.Protocol.dll;
          $(AnalyzerPayloadDirectory)\System.Buffers.dll;
          $(AnalyzerPayloadDirectory)\System.Collections.Immutable.dll;
          $(AnalyzerPayloadDirectory)\System.IO.Pipelines.dll;
          $(AnalyzerPayloadDirectory)\System.Memory.dll;
          $(AnalyzerPayloadDirectory)\System.Numerics.Vectors.dll;
          $(AnalyzerPayloadDirectory)\System.Reflection.Metadata.dll;
          $(AnalyzerPayloadDirectory)\System.Runtime.CompilerServices.Unsafe.dll;
          $(AnalyzerPayloadDirectory)\System.Text.Encoding.CodePages.dll;
          $(AnalyzerPayloadDirectory)\System.Text.Encodings.Web.dll;
          $(AnalyzerPayloadDirectory)\System.Text.Json.dll;
          $(AnalyzerPayloadDirectory)\System.Threading.Tasks.Extensions.dll"
                                 PackagePath="tools/analyzers/dotnet/cs" />
      <TfmSpecificPackageFile Include="$(AttributesPayloadPath)" PackagePath="lib/netstandard2.0" />
      <TfmSpecificPackageFile Include="
          $(WorkerPayloadDirectory)\Microsoft.Z3.dll;
          $(WorkerPayloadDirectory)\SharpProof.CompilerArtifact.dll;
          $(WorkerPayloadDirectory)\SharpProof.Dataflow.dll;
          $(WorkerPayloadDirectory)\SharpProof.Ir.dll;
          $(WorkerPayloadDirectory)\SharpProof.Smt.dll;
          $(WorkerPayloadDirectory)\SharpProof.Specs.dll;
          $(WorkerPayloadDirectory)\SharpProof.Verify.dll;
          $(WorkerPayloadDirectory)\SharpProof.Worker.Protocol.dll;
          $(WorkerPayloadDirectory)\SharpProof.Worker.dll;
          $(WorkerPayloadDirectory)\SharpProof.Worker.deps.json;
          $(WorkerPayloadDirectory)\SharpProof.Worker.runtimeconfig.json;
          $(WorkerPayloadDirectory)\System.IO.Pipelines.dll;
          $(WorkerPayloadDirectory)\System.Text.Encodings.Web.dll;
          $(WorkerPayloadDirectory)\System.Text.Json.dll"
                              PackagePath="tools/net9" />
      <TfmSpecificPackageFile Include="$(WorkerPayloadDirectory)\runtimes\win-x64\native\libz3.dll"
                              PackagePath="tools/net9/runtimes/win-x64/native" />
      <TfmSpecificPackageFile Include="$(WorkerPayloadDirectory)\runtimes\win\lib\net9.0\System.Text.Encodings.Web.dll"
                              PackagePath="tools/net9/runtimes/win/lib/net9.0" />
      <TfmSpecificPackageFile Include="$(LauncherPayloadDirectory)\SharpProof.Worker.Launcher.dll;$(LauncherPayloadDirectory)\SharpProof.Worker.Launcher.deps.json;$(LauncherPayloadDirectory)\SharpProof.Worker.Launcher.runtimeconfig.json"
                              PackagePath="tools/net9" />
    </ItemGroup>
  </Target>
</Project>
