<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\SharpProof.PackageMetadata.props" />
  <Import Project="..\SharpProof.CustomNuspec.props" />
  <PropertyGroup>
    <NuspecFile>SharpProof.nuspec</NuspecFile>
    <PackageId>SharpProof</PackageId>
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SharpProof.Verifier\SharpProof.Verifier.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      PrivateAssets="all"
                      TreatAsPackageReference="false" />
  </ItemGroup>
  <Target Name="_SharpProofPreparePackageNuspecProperties"
          BeforeTargets="GenerateNuspec"
          DependsOnTargets="_SharpProofPrepareCommonNuspecProperties">
    <PropertyGroup>
      <NuspecProperties>$(_SharpProofNuspecPrefix);$(_SharpProofNuspecSuffix)</NuspecProperties>
    </PropertyGroup>
  </Target>
</Project>
