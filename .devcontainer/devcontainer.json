{
  "name": "SharpProof Linux amd64",
  "dockerComposeFile": "../compose.yaml",
  "service": "dev",
  "workspaceFolder": "/workspace/SharpProof",
  "containerUser": "sharpproof",
  "remoteUser": "sharpproof",
  "overrideCommand": false,
  "shutdownAction": "stopCompose",
  "postCreateCommand": "sharpproof-dev-init",
  "postStartCommand": "sp contract",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "dotnet.defaultSolution": "SharpProof.sln"
      },
      "extensions": [
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit",
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}
