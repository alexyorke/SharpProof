<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>SharpProof.ArchitectureTest</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <Target Name="_WriteArchitectureInventory" BeforeTargets="Build">
    <ItemGroup>
      <_ArchitectureProject Include="$(MSBuildProjectDirectory)/../*/*.csproj" />
      <_ArchitectureProject Include="$(MSBuildProjectDirectory)/../../tests/*/*.csproj" />
    </ItemGroup>
    <MSBuild Projects="@(_ArchitectureProject)" Targets="_SharpProofGetArchitectureItems" BuildInParallel="false">
      <Output TaskParameter="TargetOutputs" ItemName="_ArchitectureItem" />
    </MSBuild>
    <MakeDir Directories="$(TargetDir)" />
    <WriteLinesToFile File="$(TargetDir)architecture-items.tsv"
                      Lines="@(_ArchitectureItem->'%(ProjectName)|%(Kind)|%(Identity)')"
                      Overwrite="true" Encoding="UTF-8" />
  </Target>
  <ItemGroup>
    <!-- Shared test helpers from eng/testing. -->
    <Compile Include="../../eng/testing/RepositoryRoot.cs" Link="RepositoryRoot.cs" />
    <Compile Include="../../eng/testing/TestRepository.cs" Link="TestRepository.cs" />
  </ItemGroup>
</Project>
