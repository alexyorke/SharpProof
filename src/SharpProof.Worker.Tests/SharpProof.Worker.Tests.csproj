<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>SharpProof.Worker.Test</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Restore this test project as its project-reference closure, without
         evaluating unrelated projects in the solution. -->
    <RestoreUseStaticGraphEvaluation>true</RestoreUseStaticGraphEvaluation>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\eng\testing\ContainerNativeLibrarySetup.cs"
             Link="ContainerNativeLibrarySetup.cs" />
    <ProjectReference Include="..\SharpProof.Analyzer\SharpProof.Analyzer.csproj" />
    <ProjectReference Include="..\SharpProof.Attributes\SharpProof.Attributes.csproj" />
    <ProjectReference Include="..\SharpProof.CompilerCollector\SharpProof.CompilerCollector.csproj" />
    <ProjectReference Include="..\SharpProof.Worker\SharpProof.Worker.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shared test helpers from eng/testing. -->
    <Compile Include="../../eng/testing/AllocationWitnessKinds.cs" Link="AllocationWitnessKinds.cs" />
    <Compile Include="../../eng/testing/GoldenTest.cs" Link="GoldenTest.cs" />
    <Compile Include="../../eng/testing/ImmutableFixtureRows.cs" Link="ImmutableFixtureRows.cs" />
    <Compile Include="../../eng/testing/ProcessRunner.cs" Link="ProcessRunner.cs" />
    <Compile Include="../../eng/testing/RepositoryRoot.cs" Link="RepositoryRoot.cs" />
    <Compile Include="../../eng/testing/RuntimeAssemblyTestHost.cs" Link="RuntimeAssemblyTestHost.cs" />
    <Compile Include="../../eng/testing/TempDirectory.cs" Link="TempDirectory.cs" />
    <Compile Include="../../eng/testing/TestCompilation.cs" Link="TestCompilation.cs" />
    <Compile Include="../../eng/testing/TestMetadataReferences.cs" Link="TestMetadataReferences.cs" />
    <Compile Include="../../eng/testing/TestRepository.cs" Link="TestRepository.cs" />
  </ItemGroup>
</Project>
