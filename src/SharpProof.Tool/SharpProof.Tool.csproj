<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable Condition="'$(SharpProofPackTool)' != 'true'">false</IsPackable>
    <IsPackable Condition="'$(SharpProofPackTool)' == 'true' Or '$(SharpProofDeveloperPackages)' == 'true'">true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotnet-sharpproof</ToolCommandName>
    <PackageId>SharpProof.Tool</PackageId>
    <Description>Optional SharpProof setup checks, stored evidence explanations, verification comparisons, and NUnit regression export.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>$(SharpProofProjectUrl)</RepositoryUrl>
    <PackageProjectUrl>$(SharpProofProjectUrl)</PackageProjectUrl>
    <Authors>$(SharpProofPublisher)</Authors>
    <PackageIcon>icon.png</PackageIcon>
    <PackageIconFullPath>$(MSBuildThisFileDirectory)../../eng/branding/icon.png</PackageIconFullPath>
    <PackageTags>SharpProof;formal-verification;smt;z3;contracts;diagnostics;dotnet-tool</PackageTags>
    <Copyright>Copyright (c) $(SharpProofPublisher)</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SharpProof.Worker.Protocol\SharpProof.Worker.Protocol.csproj" />
    <None Update="README.md" Pack="true" PackagePath="/" />
    <None Include="../../THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="SharpProof.Tool.Test" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyMetadata Include="SharpProof.TestSdk" Value="$(MicrosoftNETTestSdkVersion)" />
    <AssemblyMetadata Include="SharpProof.NUnit" Value="$(NUnitVersion)" />
    <AssemblyMetadata Include="SharpProof.NUnitAdapter" Value="$(NUnit3TestAdapterVersion)" />
    <Compile Include="../../eng/shared/InputValidation.cs" Link="Reporting/InputValidation.cs" />
    <EmbeddedResource Include="../SharpProof.Templates/content/container/compose.yaml.template"
                      LogicalName="SharpProof.Tool.compose.yaml.template" />
    <EmbeddedResource Include="../SharpProof.Templates/content/container/Directory.Build.props.template"
                      LogicalName="SharpProof.Tool.Directory.Build.props.template" />
    <ProjectReference Include="../SharpProof.CompilerArtifact/SharpProof.CompilerArtifact.csproj" />
    <ProjectReference Include="../SharpProof.Specs/SharpProof.Specs.csproj" />
    <ProjectReference Include="../SharpProof.Frontend/SharpProof.Frontend.csproj" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="NuGet.Configuration" />
    <InternalsVisibleTo Include="SharpProof.DeveloperExperience.Test" />
  </ItemGroup>
</Project>
