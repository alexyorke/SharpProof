<Project>
  <PropertyGroup>
    <_SharpProofProfileWasDefaulted Condition="'$(SharpProofProfile)' == ''">true</_SharpProofProfileWasDefaulted>
    <_SharpProofProfileWasDefaulted Condition="'$(SharpProofProfile)' != ''">false</_SharpProofProfileWasDefaulted>
    <_SharpProofFeaturesWasDefaulted Condition="'$(SharpProofFeatures)' == ''">true</_SharpProofFeaturesWasDefaulted>
    <_SharpProofFeaturesWasDefaulted Condition="'$(SharpProofFeatures)' != ''">false</_SharpProofFeaturesWasDefaulted>
    <SharpProofProfile Condition="'$(SharpProofProfile)' == '' AND '$(_SharpProofVerifierPackagePresent)' == 'true'">strict</SharpProofProfile>
    <SharpProofProfile Condition="'$(SharpProofProfile)' == ''">advisory</SharpProofProfile>
    <SharpProofFeatures Condition="'$(SharpProofFeatures)' == ''">all</SharpProofFeatures>
    <_SharpProofProfileNormalized>$([System.String]::Copy('$(SharpProofProfile)').Trim().ToLowerInvariant())</_SharpProofProfileNormalized>
    <_SharpProofFeaturesNormalized>$([System.String]::Copy('$(SharpProofFeatures)').Trim().ToLowerInvariant())</_SharpProofFeaturesNormalized>
    <SharpProofVerify Condition="'$(SharpProofVerify)' == '' AND '$(_SharpProofProfileNormalized)' == 'strict'">true</SharpProofVerify>
    <SharpProofVerify Condition="'$(SharpProofVerify)' == ''">false</SharpProofVerify>
  </PropertyGroup>

  <Target Name="_SharpProofValidateConsumerConfiguration"
          BeforeTargets="CoreCompile"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Code="SPB001" Condition="'$(SharpProofMode)' != ''"
           Text="SharpProofMode is not supported. Use SharpProofProfile and SharpProofFeatures." />
    <Error Code="SPB001" Condition="'$(SharpProofAnalyzerDirectory)' != ''"
           Text="SharpProofAnalyzerDirectory is not supported. Analyzer paths are derived from the package import location." />
    <Error Code="SPB001" Condition="'$(SharpProofCollectorDirectory)' != ''"
           Text="SharpProofCollectorDirectory is not supported. Collector paths are derived from the package import location." />
    <Error Code="SPB001" Condition="'$(SharpProofCompilerCollectorPath)' != ''"
           Text="SharpProofCompilerCollectorPath is not supported. Collector paths are derived from the package import location." />
    <Error Code="SPB001" Condition="'$(SharpProofToolsDirectory)' != ''"
           Text="SharpProofToolsDirectory is not supported. Verifier tools are derived from the package import location." />
    <Error Code="SPB001" Condition="'$(SharpProofPortableAnalyzerPath)' != ''"
           Text="SharpProofPortableAnalyzerPath is not supported. Analyzer layout is package-owned." />
    <Error Code="SPB002" Condition="'$(_SharpProofProfileNormalized)' != 'advisory' AND '$(_SharpProofProfileNormalized)' != 'strict' AND '$(_SharpProofProfileNormalized)' != 'off'"
           Text="SharpProofProfile must be advisory, strict, or off. The value is '$(SharpProofProfile)'." />
    <Error Code="SPB003" Condition="'$(_SharpProofFeaturesNormalized)' != 'effects' AND '$(_SharpProofFeaturesNormalized)' != 'contracts' AND '$(_SharpProofFeaturesNormalized)' != 'all'"
           Text="SharpProofFeatures must be effects, contracts, or all. The value is '$(SharpProofFeatures)'." />
    <Error Code="SPB004" Condition="'$(SharpProofVerify)' != 'true' AND '$(SharpProofVerify)' != 'false'"
           Text="SharpProofVerify must be true or false. The value is '$(SharpProofVerify)'." />
    <Error Code="SPB005" Condition="'$(_SharpProofProfileNormalized)' == 'strict' AND '$(SharpProofVerify)' != 'true'"
           Text="SharpProofProfile=strict requires SharpProofVerify=true; use the advisory profile to make verification optional." />
    <Error Code="SPB006" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(DefineConstants)', '(^|[;,])\s*SHARPPROOF_CONTRACTS\s*($|[;,])'))"
           Text="SHARPPROOF_CONTRACTS is reserved and unsupported in every SharpProof profile. Contract clauses do not check conditions at runtime, and direct Result/Old calls throw. Remove it from DefineConstants." />
  </Target>
</Project>
