<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>SharpProof</id>
    <version>$version$</version>
    <title>SharpProof</title>
    <authors>$authors$</authors>
    <license type="expression">$license$</license>
    <readme>$readme$</readme>
    <icon>icon.png</icon>
    <projectUrl>$projecturl$</projectUrl>
    <description>Complete SharpProof analysis and postcondition verification with one PackageReference and automatic MSBuild integration on Windows, macOS, and glibc Linux x64/ARM64. Unsupported selected code remains visibly incomplete.</description>
    <releaseNotes>Verification is enabled by default using the .NET 10 SDK. Explicit advisory or off profiles retain portable analyzer-only workflows.</releaseNotes>
    <copyright>$copyright$</copyright>
    <tags>SharpProof Roslyn Analyzer Purity StaticAnalysis MethodEffects Capabilities ZeroAllocations ExceptionContracts Preconditions Contracts</tags>
    <repository type="$repositorytype$" url="$repositoryurl$" commit="$repositorycommit$" />
    <dependencies>
      <group targetFramework=".NETStandard2.0">
        <dependency id="SharpProof.Verifier" version="[$version$]" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="README.md" />
    <file src="..\..\eng\branding\icon.png" target="" />
    <file src="..\..\LICENSE" />
    <file src="..\..\THIRD-PARTY-NOTICES.txt" />
  </files>
</package>
