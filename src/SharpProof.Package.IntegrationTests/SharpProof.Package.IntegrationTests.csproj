<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>SharpProof.Package.Test</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <PackageDownload Include="Microsoft.NETFramework.ReferenceAssemblies"
                    Version="[1.0.3]" />
    <PackageDownload Include="Microsoft.NETFramework.ReferenceAssemblies.net472"
                    Version="[1.0.3]" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Framework"
                      PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Utilities.Core"
                      PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp"
                      PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SharpProof.BuildTasks\SharpProof.BuildTasks.csproj" />
    <ProjectReference Include="..\SharpProof.Analyzer\SharpProof.Analyzer.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\SharpProof.Attributes\SharpProof.Attributes.csproj" />
    <ProjectReference Include="..\..\tests\SharpProof.CompilerProbe.TestAsset\SharpProof.CompilerProbe.TestAsset.csproj" />
    <ProjectReference Include="..\SharpProof.Package\SharpProof.Package.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\SharpProof.Verifier\SharpProof.Verifier.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      PrivateAssets="all"
                      TreatAsPackageReference="false" />
    <ProjectReference Include="..\SharpProof.Worker\SharpProof.Worker.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shared test helpers from eng/testing. -->
    <Compile Include="../../eng/testing/AllocationWitnessKinds.cs" Link="AllocationWitnessKinds.cs" />
    <Compile Include="../../eng/testing/DictionaryAnalyzerConfigOptions.cs" Link="DictionaryAnalyzerConfigOptions.cs" />
    <Compile Include="../../eng/testing/GoldenTest.cs" Link="GoldenTest.cs" />
    <Compile Include="../../eng/testing/ImmutableFixtureRows.cs" Link="ImmutableFixtureRows.cs" />
    <Compile Include="../../eng/testing/ProcessRunner.cs" Link="ProcessRunner.cs" />
    <Compile Include="../../eng/testing/RepositoryRoot.cs" Link="RepositoryRoot.cs" />
    <Compile Include="../../eng/testing/TempDirectory.cs" Link="TempDirectory.cs" />
    <Compile Include="../../eng/testing/TestMetadataReferences.cs" Link="TestMetadataReferences.cs" />
    <Compile Include="../../eng/testing/TestRepository.cs" Link="TestRepository.cs" />
  </ItemGroup>
</Project>
