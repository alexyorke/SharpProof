<Project TreatAsLocalProperty="_SharpProofContractsExportCompleted;_SharpProofCompilerCaptureNonce;_SharpProofCompilerCaptureRequestPath;TargetsTriggeredByCompilation;_SharpProofVerifyActive;_SharpProofVerifyDirectory;_SharpProofInvocationRunsDirectory;_SharpProofInvocationIdIsSafe;_SharpProofExpectedInvocationDirectory;_SharpProofInvocationDirectoryFullPath;_SharpProofInvocationDirectoryIsCanonical;_SharpProofInvocationDirectoryMatchesExpected;_SharpProofInvocationDirectoryParent;_SharpProofInvocationDirectoryIsContained;_SharpProofCompilerManifestStagingPath;_SharpProofCleanupVerifyDirectory;_SharpProofCleanupRunsDirectory;_SharpProofCleanupInvocationIdIsSafe;_SharpProofCleanupExpectedInvocationDirectory;_SharpProofCleanupInvocationDirectoryFullPath;_SharpProofCleanupInvocationDirectoryIsCanonical;_SharpProofCleanupInvocationDirectoryMatchesExpected;_SharpProofCleanupInvocationDirectoryParent;_SharpProofCleanupInvocationDirectoryIsContained;_SharpProofCleanVerifyDirectory;_SharpProofCleanCompilerManifestStagingPath;_SharpProofToolsDirectory">
  <Import Project="$(MSBuildThisFileDirectory)SharpProof.targets" Condition="'$(_SharpProofPortableTargetsImported)' != 'true' AND Exists('$(MSBuildThisFileDirectory)SharpProof.targets')" />
  <!-- NuGet imports package props before NETCoreSdkVersion is initialized by the SDK. -->
  <PropertyGroup>
    <!-- Build tasks execute inside the consumer MSBuild runtime; the portable analyzer supports older SDKs. -->
    <_SharpProofVerifierHostSupported Condition="'$(NETCoreSdkVersion)' == ''">false</_SharpProofVerifierHostSupported>
    <_SharpProofVerifierHostSupported Condition="'$(NETCoreSdkVersion)' != '' AND $([MSBuild]::VersionLessThan('$(NETCoreSdkVersion)', '10.0.100'))">false</_SharpProofVerifierHostSupported>
  </PropertyGroup>
  <PropertyGroup>
    <_SharpProofToolsDirectory Condition="'$(_SharpProofTestToolsDirectory)' != ''">$([System.IO.Path]::GetFullPath('$(_SharpProofTestToolsDirectory)'))</_SharpProofToolsDirectory>
    <_SharpProofToolsDirectory>$([System.IO.Path]::GetFullPath('$(_SharpProofToolsDirectory)'))</_SharpProofToolsDirectory>
    <_SharpProofWorkerPathConfigured>$([System.String]::Copy('$(SharpProofWorkerPath)').Trim())</_SharpProofWorkerPathConfigured>
    <_SharpProofLauncherPathConfigured>$([System.String]::Copy('$(SharpProofLauncherPath)').Trim())</_SharpProofLauncherPathConfigured>
    <SharpProofWorkerPath Condition="'$(_SharpProofWorkerPathConfigured)' == ''">$(_SharpProofToolsDirectory)/SharpProof.Worker.dll</SharpProofWorkerPath>
    <SharpProofLauncherPath Condition="'$(_SharpProofLauncherPathConfigured)' == ''">$(_SharpProofToolsDirectory)/SharpProof.Worker.dll</SharpProofLauncherPath>
    <_SharpProofWorkerPath>$([System.IO.Path]::GetFullPath('$(SharpProofWorkerPath)'))</_SharpProofWorkerPath>
    <_SharpProofLauncherPath>$([System.IO.Path]::GetFullPath('$(SharpProofLauncherPath)'))</_SharpProofLauncherPath>
    <_SharpProofWorkerProtocolPath>$([System.IO.Path]::Combine('$(_SharpProofToolsDirectory)', 'SharpProof.Worker.Protocol.dll'))</_SharpProofWorkerProtocolPath>
    <_SharpProofWorkerProtocolPath Condition="'$(_SharpProofTestWorkerProtocolPath)' != ''">$([System.IO.Path]::GetFullPath('$(_SharpProofTestWorkerProtocolPath)'))</_SharpProofWorkerProtocolPath>
    <_SharpProofBuildTasksPath Condition="'$(_SharpProofTestBuildTasksPath)' != ''">$([System.IO.Path]::GetFullPath('$(_SharpProofTestBuildTasksPath)'))</_SharpProofBuildTasksPath>
    <!-- Every compilation restamps this project's contract export or removes
         it, so an export never outlives the sources it describes. -->
    <TargetsTriggeredByCompilation>$(TargetsTriggeredByCompilation);_SharpProofStampContractsExport</TargetsTriggeredByCompilation>
  </PropertyGroup>
  <Target Name="_SharpProofSetVerifyActive"
          BeforeTargets="GenerateMSBuildEditorConfigFileShouldRun;GenerateMSBuildEditorConfigFile;CoreCompile">
    <PropertyGroup>
      <_SharpProofVerifyActive>false</_SharpProofVerifyActive>
      <_SharpProofVerifyActive Condition="'$(SharpProofVerify)' == 'true' AND '$(_SharpProofProfileNormalized)' != 'off' AND '$(DesignTimeBuild)' != 'true' AND '$(BuildingProject)' != 'false'">true</_SharpProofVerifyActive>
    </PropertyGroup>
  </Target>
  <UsingTask TaskName="SharpProof.BuildTasks.InvalidatePublishedResult"
             AssemblyFile="$(_SharpProofBuildTasksPath)"
             Condition="'$(MSBuildRuntimeType)' == 'Core'" />
  <UsingTask TaskName="SharpProof.BuildTasks.RunVerifier"
             AssemblyFile="$(_SharpProofBuildTasksPath)"
             Condition="'$(MSBuildRuntimeType)' == 'Core'" />
  <UsingTask TaskName="SharpProof.BuildTasks.ValidatePublishedVerificationResult"
             AssemblyFile="$(_SharpProofBuildTasksPath)"
             Condition="'$(MSBuildRuntimeType)' == 'Core'" />
  <UsingTask TaskName="SharpProof.BuildTasks.ResetPublishedVerification"
             AssemblyFile="$(_SharpProofBuildTasksPath)"
             Condition="'$(MSBuildRuntimeType)' == 'Core'" />
  <UsingTask TaskName="SharpProof.BuildTasks.StampContractsExport"
             AssemblyFile="$(_SharpProofBuildTasksPath)"
             Condition="'$(MSBuildRuntimeType)' == 'Core'" />
  <!-- Full MSBuild delegates modern .NET tasks to the SDK's separate task host. -->
  <UsingTask TaskName="SharpProof.BuildTasks.InvalidatePublishedResult"
             AssemblyFile="$(_SharpProofBuildTasksPath)" Runtime="NET" TaskFactory="TaskHostFactory"
             Condition="'$(MSBuildRuntimeType)' == 'Full' AND '$(UsingMicrosoftNETSdk)' == 'true' AND $([MSBuild]::VersionGreaterThanOrEquals('$(MSBuildVersion)', '18.0'))" />
  <UsingTask TaskName="SharpProof.BuildTasks.RunVerifier"
             AssemblyFile="$(_SharpProofBuildTasksPath)" Runtime="NET" TaskFactory="TaskHostFactory"
             Condition="'$(MSBuildRuntimeType)' == 'Full' AND '$(UsingMicrosoftNETSdk)' == 'true' AND $([MSBuild]::VersionGreaterThanOrEquals('$(MSBuildVersion)', '18.0'))" />
  <UsingTask TaskName="SharpProof.BuildTasks.ValidatePublishedVerificationResult"
             AssemblyFile="$(_SharpProofBuildTasksPath)" Runtime="NET" TaskFactory="TaskHostFactory"
             Condition="'$(MSBuildRuntimeType)' == 'Full' AND '$(UsingMicrosoftNETSdk)' == 'true' AND $([MSBuild]::VersionGreaterThanOrEquals('$(MSBuildVersion)', '18.0'))" />
  <UsingTask TaskName="SharpProof.BuildTasks.ResetPublishedVerification"
             AssemblyFile="$(_SharpProofBuildTasksPath)" Runtime="NET" TaskFactory="TaskHostFactory"
             Condition="'$(MSBuildRuntimeType)' == 'Full' AND '$(UsingMicrosoftNETSdk)' == 'true' AND $([MSBuild]::VersionGreaterThanOrEquals('$(MSBuildVersion)', '18.0'))" />
  <UsingTask TaskName="SharpProof.BuildTasks.StampContractsExport"
             AssemblyFile="$(_SharpProofBuildTasksPath)" Runtime="NET" TaskFactory="TaskHostFactory"
             Condition="'$(MSBuildRuntimeType)' == 'Full' AND '$(UsingMicrosoftNETSdk)' == 'true' AND $([MSBuild]::VersionGreaterThanOrEquals('$(MSBuildVersion)', '18.0'))" />

  <PropertyGroup>
    <SharpProofVerifyPolicy Condition="'$(SharpProofVerifyPolicy)' == '' AND '$(_SharpProofProfileNormalized)' == 'strict'">require-proven</SharpProofVerifyPolicy>
    <SharpProofVerifyPolicy Condition="'$(SharpProofVerifyPolicy)' == ''">advisory</SharpProofVerifyPolicy>
    <SharpProofAssumptionPolicy Condition="'$(SharpProofAssumptionPolicy)' == '' AND '$(_SharpProofProfileNormalized)' == 'strict'">error</SharpProofAssumptionPolicy>
    <SharpProofAssumptionPolicy Condition="'$(SharpProofAssumptionPolicy)' == ''">allow</SharpProofAssumptionPolicy>
    <_SharpProofVerifyPolicyNormalized>$([System.String]::Copy('$(SharpProofVerifyPolicy)').Trim().ToLowerInvariant())</_SharpProofVerifyPolicyNormalized>
    <_SharpProofAssumptionPolicyNormalized>$([System.String]::Copy('$(SharpProofAssumptionPolicy)').Trim().ToLowerInvariant())</_SharpProofAssumptionPolicyNormalized>
  </PropertyGroup>
  <Target Name="_SharpProofValidateRuntimeClosure"
          Condition="'$(_SharpProofVerifyActive)' == 'true' AND '$(_SharpProofVerifierHostSupported)' == 'true'">
    <Error Code="SPB026" Condition="'$(_SharpProofToolsDirectory)' != '$(_SharpProofPackageToolsDirectory)' OR '$(_SharpProofWorkerPath)' != '$(_SharpProofPackageWorkerPath)' OR '$(_SharpProofLauncherPath)' != '$(_SharpProofPackageLauncherPath)' OR '$(_SharpProofWorkerProtocolPath)' != '$(_SharpProofPackageWorkerProtocolPath)' OR '$(_SharpProofBuildTasksPath)' != '$(_SharpProofPackageBuildTasksPath)'"
           Text="SharpProof verifier runtime paths must resolve to the exact package-owned runtime closure." />
    <Error Code="SPB027" Condition="!Exists('$(_SharpProofPackageNativeZ3Path)')"
           Text="SharpProof verifier package native payload is missing from its build-tool closure: '$(_SharpProofPackageNativeZ3Path)'. Restore the SharpProof.Verifier package again." />
  </Target>

  <Target Name="_SharpProofResolveVerificationPaths">
    <PropertyGroup>
      <_SharpProofVerifyDirectory>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)SharpProof'))))</_SharpProofVerifyDirectory>
      <_SharpProofConfiguredRequestFile>$(SharpProofVerifyRequestFile)</_SharpProofConfiguredRequestFile>
      <_SharpProofConfiguredResultFile>$(SharpProofVerifyResultFile)</_SharpProofConfiguredResultFile>
      <_SharpProofConfiguredCompilerManifestFile>$(SharpProofCompilerManifestFile)</_SharpProofConfiguredCompilerManifestFile>
      <SharpProofVerifyRequestFile Condition="'$(SharpProofVerifyRequestFile)' == ''">$([System.IO.Path]::Combine('$(_SharpProofVerifyDirectory)', 'request.json'))</SharpProofVerifyRequestFile>
      <SharpProofVerifyResultFile Condition="'$(SharpProofVerifyResultFile)' == ''">$([System.IO.Path]::Combine('$(_SharpProofVerifyDirectory)', 'result.json'))</SharpProofVerifyResultFile>
      <SharpProofCompilerManifestFile Condition="'$(SharpProofCompilerManifestFile)' == ''">$([System.IO.Path]::Combine('$(_SharpProofVerifyDirectory)', 'compiler-manifest.json'))</SharpProofCompilerManifestFile>
      <_SharpProofEffectiveRequestFile>$(SharpProofVerifyRequestFile)</_SharpProofEffectiveRequestFile>
      <_SharpProofConfiguredRequestFullPath Condition="'$(_SharpProofConfiguredRequestFile)' != '' AND '$(TargetFrameworks)' != ''">$([System.IO.Path]::GetFullPath('$(_SharpProofConfiguredRequestFile)'))</_SharpProofConfiguredRequestFullPath>
      <_SharpProofEffectiveRequestFile Condition="'$(_SharpProofConfiguredRequestFile)' != '' AND '$(TargetFrameworks)' != ''">$([System.IO.Path]::Combine($([System.IO.Path]::GetDirectoryName('$(_SharpProofConfiguredRequestFullPath)')), '$(TargetFramework)', $([System.IO.Path]::GetFileName('$(_SharpProofConfiguredRequestFullPath)'))))</_SharpProofEffectiveRequestFile>
      <_SharpProofEffectiveResultFile>$(SharpProofVerifyResultFile)</_SharpProofEffectiveResultFile>
      <_SharpProofConfiguredResultFullPath Condition="'$(_SharpProofConfiguredResultFile)' != '' AND '$(TargetFrameworks)' != ''">$([System.IO.Path]::GetFullPath('$(_SharpProofConfiguredResultFile)'))</_SharpProofConfiguredResultFullPath>
      <_SharpProofEffectiveResultFile Condition="'$(_SharpProofConfiguredResultFile)' != '' AND '$(TargetFrameworks)' != ''">$([System.IO.Path]::Combine($([System.IO.Path]::GetDirectoryName('$(_SharpProofConfiguredResultFullPath)')), '$(TargetFramework)', $([System.IO.Path]::GetFileName('$(_SharpProofConfiguredResultFullPath)'))))</_SharpProofEffectiveResultFile>
      <_SharpProofEffectiveCompilerManifestFile>$(SharpProofCompilerManifestFile)</_SharpProofEffectiveCompilerManifestFile>
      <_SharpProofConfiguredCompilerManifestFullPath Condition="'$(_SharpProofConfiguredCompilerManifestFile)' != '' AND '$(TargetFrameworks)' != ''">$([System.IO.Path]::GetFullPath('$(_SharpProofConfiguredCompilerManifestFile)'))</_SharpProofConfiguredCompilerManifestFullPath>
      <_SharpProofEffectiveCompilerManifestFile Condition="'$(_SharpProofConfiguredCompilerManifestFile)' != '' AND '$(TargetFrameworks)' != ''">$([System.IO.Path]::Combine($([System.IO.Path]::GetDirectoryName('$(_SharpProofConfiguredCompilerManifestFullPath)')), '$(TargetFramework)', $([System.IO.Path]::GetFileName('$(_SharpProofConfiguredCompilerManifestFullPath)'))))</_SharpProofEffectiveCompilerManifestFile>
      <_SharpProofEffectiveSarifFile>$(SharpProofVerifySarifFile)</_SharpProofEffectiveSarifFile>
      <_SharpProofConfiguredSarifFullPath Condition="'$(SharpProofVerifySarifFile)' != '' AND '$(TargetFrameworks)' != ''">$([System.IO.Path]::GetFullPath('$(SharpProofVerifySarifFile)'))</_SharpProofConfiguredSarifFullPath>
      <_SharpProofEffectiveSarifFile Condition="'$(SharpProofVerifySarifFile)' != '' AND '$(TargetFrameworks)' != ''">$([System.IO.Path]::Combine($([System.IO.Path]::GetDirectoryName('$(_SharpProofConfiguredSarifFullPath)')), '$(TargetFramework)', $([System.IO.Path]::GetFileName('$(_SharpProofConfiguredSarifFullPath)'))))</_SharpProofEffectiveSarifFile>
    </PropertyGroup>
  </Target>

  <Target Name="_SharpProofInitializeVerify"
          DependsOnTargets="_SharpProofValidateRuntimeClosure;_SharpProofResolveVerificationPaths"
          BeforeTargets="GenerateMSBuildEditorConfigFileShouldRun;GenerateMSBuildEditorConfigFile">
    <PropertyGroup>
      <_SharpProofVerifyCacheDirectoryNormalized>$([System.String]::Copy('$(SharpProofVerifyCacheDirectory)').Trim())</_SharpProofVerifyCacheDirectoryNormalized>
      <_SharpProofVerifyCacheEnabledNormalized>$([System.String]::Copy('$(SharpProofVerifyCacheEnabled)').Trim().ToLowerInvariant())</_SharpProofVerifyCacheEnabledNormalized>
      <_SharpProofEffectiveCacheDirectory Condition="'$(_SharpProofVerifyCacheDirectoryNormalized)' == ''">$([System.IO.Path]::Combine('$(_SharpProofVerifyDirectory)', 'cache'))</_SharpProofEffectiveCacheDirectory>
      <_SharpProofEffectiveCacheDirectory Condition="'$(_SharpProofVerifyCacheDirectoryNormalized)' != ''">$(SharpProofVerifyCacheDirectory)</_SharpProofEffectiveCacheDirectory>
      <_SharpProofActiveCacheDirectory Condition="'$(_SharpProofVerifyCacheEnabledNormalized)' == 'true'">$(_SharpProofEffectiveCacheDirectory)</_SharpProofActiveCacheDirectory>
      <_SharpProofInvocationRunsDirectory>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(_SharpProofVerifyDirectory)', 'runs'))))</_SharpProofInvocationRunsDirectory>
      <_SharpProofInvocationId Condition="'$(_SharpProofInvocationId)' == ''">$([System.Guid]::NewGuid().ToString('N'))</_SharpProofInvocationId>
      <_SharpProofInvocationIdIsSafe>$([System.Text.RegularExpressions.Regex]::IsMatch('$(_SharpProofInvocationId)', '\A[0-9a-f]{32}\z'))</_SharpProofInvocationIdIsSafe>
      <_SharpProofExpectedInvocationDirectory>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(_SharpProofInvocationRunsDirectory)', '$(_SharpProofInvocationId)'))))</_SharpProofExpectedInvocationDirectory>
      <_SharpProofInvocationDirectory>$(_SharpProofExpectedInvocationDirectory)</_SharpProofInvocationDirectory>
      <_SharpProofInvocationDirectoryFullPath>$([System.IO.Path]::GetFullPath('$(_SharpProofInvocationDirectory)'))</_SharpProofInvocationDirectoryFullPath>
      <_SharpProofInvocationDirectoryIsCanonical>$([System.String]::Equals('$(_SharpProofInvocationDirectory)', '$(_SharpProofInvocationDirectoryFullPath)', System.StringComparison.Ordinal))</_SharpProofInvocationDirectoryIsCanonical>
      <_SharpProofInvocationDirectoryMatchesExpected>$([System.String]::Equals('$(_SharpProofInvocationDirectoryFullPath)', '$(_SharpProofExpectedInvocationDirectory)', System.StringComparison.Ordinal))</_SharpProofInvocationDirectoryMatchesExpected>
      <_SharpProofInvocationDirectoryParent>$([System.IO.Path]::GetDirectoryName('$(_SharpProofInvocationDirectoryFullPath)'))</_SharpProofInvocationDirectoryParent>
      <_SharpProofInvocationDirectoryIsContained>$([System.String]::Equals('$(_SharpProofInvocationDirectoryParent)', '$(_SharpProofInvocationRunsDirectory)', System.StringComparison.Ordinal))</_SharpProofInvocationDirectoryIsContained>
      <_SharpProofInvocationRequestFile>$([System.IO.Path]::Combine('$(_SharpProofInvocationDirectory)', 'request.json'))</_SharpProofInvocationRequestFile>
      <_SharpProofInvocationResultFile>$([System.IO.Path]::Combine('$(_SharpProofInvocationDirectory)', 'result.json'))</_SharpProofInvocationResultFile>
    </PropertyGroup>
    <Error Code="SPB028" Condition="'$(_SharpProofInvocationIdIsSafe)' != 'True'"
           Text="SharpProof invocation ID must be an exact safe identifier of 32 lowercase hexadecimal characters." />
    <Error Code="SPB029" Condition="'$(_SharpProofInvocationDirectoryIsCanonical)' != 'True' OR '$(_SharpProofInvocationDirectoryMatchesExpected)' != 'True' OR '$(_SharpProofInvocationDirectoryIsContained)' != 'True'"
           Text="SharpProof invocation directory must resolve canonically to a direct child of the package-owned runs directory." />
    <PropertyGroup Condition="'$(_SharpProofVerifyActive)' == 'true' AND '$(_SharpProofVerifierHostSupported)' == 'true'">
      <_SharpProofCompilationTargetFramework>$(TargetFramework)</_SharpProofCompilationTargetFramework>
      <_SharpProofCompilerManifestStagingPath>$([System.IO.Path]::Combine('$(_SharpProofVerifyDirectory)', 'compiler-manifest.staging.json'))</_SharpProofCompilerManifestStagingPath>
      <_SharpProofCompilerManifestPath Condition="'$(_SharpProofCompilerManifestPath)' == ''">$(_SharpProofCompilerManifestStagingPath)</_SharpProofCompilerManifestPath>
      <_SharpProofCompilerCaptureNonce>$([System.Guid]::NewGuid().ToString('N'))</_SharpProofCompilerCaptureNonce>
      <_SharpProofCompilerCaptureRequestPath>$([System.IO.Path]::Combine('$(_SharpProofVerifyDirectory)', 'compiler-capture.request'))</_SharpProofCompilerCaptureRequestPath>
      <!-- The collector writes this project's contract export here; the
           stamp step publishes it as contracts-export.json. -->
      <_SharpProofContractsExportPath>$([System.IO.Path]::Combine('$(_SharpProofVerifyDirectory)', 'contracts-export.unstamped.json'))</_SharpProofContractsExportPath>
      <TargetsTriggeredByCompilation>$(TargetsTriggeredByCompilation);_SharpProofValidateCompilerCapture</TargetsTriggeredByCompilation>
      <_SharpProofProjectDirectory>$(MSBuildProjectDirectory)</_SharpProofProjectDirectory>
    </PropertyGroup>
    <ItemGroup Condition="'$(_SharpProofVerifyActive)' == 'true' AND '$(_SharpProofVerifierHostSupported)' == 'true'">
      <!-- A rejected capture is removed, so the next build must recollect even
           when the preceding compiler emitted an otherwise current assembly. -->
      <CustomAdditionalCompileOutputs Include="$(_SharpProofCompilerManifestPath)" />
      <CustomAdditionalCompileOutputs Include="$(_SharpProofContractsExportPath)" />
      <CustomAdditionalCompileOutputs Include="$([System.IO.Path]::Combine('$(_SharpProofVerifyDirectory)', 'contracts-export.json'))" />
      <_SharpProofCompilerOwnedOutput Remove="@(_SharpProofCompilerOwnedOutput)" />
      <_SharpProofCompilerOwnedOutput Include="$(_SharpProofCompilerCaptureRequestPath)" />
      <_SharpProofCompilerOwnedOutput Include="$(_SharpProofCompilerCaptureRequestPath).completed" />
      <_SharpProofCompilerOwnedOutput Include="$(TargetPath)" Condition="'$(TargetPath)' != ''" />
      <_SharpProofCompilerOwnedOutput Include="@(IntermediateAssembly)" />
      <_SharpProofCompilerOwnedOutput Include="$(IntermediateOutputPath)apphost$(_NativeExecutableExtension)" Condition="'$(UseAppHost)' == 'true' AND '$(_IsExecutable)' == 'true'" />
      <_SharpProofCompilerOwnedOutput Include="$(TargetDir)$(AssemblyName)$(_NativeExecutableExtension)" Condition="'$(UseAppHost)' == 'true' AND '$(_IsExecutable)' == 'true'" />
      <_SharpProofCompilerOwnedOutput Include="$(DocumentationFile)" Condition="'$(DocumentationFile)' != ''" />
      <_SharpProofCompilerOwnedOutput Include="$(IntermediateOutputPath)$(TargetName).pdb" Condition="'$(TargetName)' != ''" />
      <_SharpProofCompilerOwnedOutput Include="$([System.IO.Path]::ChangeExtension('$(TargetPath)', '.pdb'))" Condition="'$(TargetPath)' != ''" />
      <_SharpProofCompilerOwnedOutput Include="$(IntermediateRefAssembly)" Condition="'$(IntermediateRefAssembly)' != ''" />
      <_SharpProofCompilerOwnedOutput Include="$(IntermediateOutputPath)ref/$(TargetName)$(TargetExt)" />
      <_SharpProofCompilerOwnedOutput Include="$(IntermediateOutputPath)refint/$(TargetName)$(TargetExt)" />
      <_SharpProofCompilerOwnedOutput Include="$(GeneratedAssemblyInfoFile)" Condition="'$(GeneratedAssemblyInfoFile)' != ''" />
      <_SharpProofCompilerOwnedOutput Include="$(IntermediateOutputPath)$(MSBuildProjectName).AssemblyInfo.cs" />
      <_SharpProofCompilerOwnedOutput Include="$(GeneratedGlobalUsingsFile)" Condition="'$(GeneratedGlobalUsingsFile)' != ''" />
      <_SharpProofCompilerOwnedOutput Include="$(IntermediateOutputPath)$(MSBuildProjectName).GlobalUsings.g.cs" />
      <_SharpProofCompilerOwnedOutput Include="$(GeneratedMSBuildEditorConfigFile)" Condition="'$(GeneratedMSBuildEditorConfigFile)' != ''" />
      <_SharpProofCompilerOwnedOutput Include="$(IntermediateOutputPath)$(MSBuildProjectName).GeneratedMSBuildEditorConfig.editorconfig" />
      <_SharpProofCompilerOwnedOutput Include="$(ProjectDepsFilePath)" Condition="'$(ProjectDepsFilePath)' != ''" />
      <_SharpProofCompilerOwnedOutput Include="$(ProjectRuntimeConfigFilePath)" Condition="'$(ProjectRuntimeConfigFilePath)' != ''" />
      <_SharpProofCompilerOwnedOutput Include="$(ProjectRuntimeConfigDevFilePath)" Condition="'$(ProjectRuntimeConfigDevFilePath)' != ''" />
    </ItemGroup>
    <SharpProof.BuildTasks.InvalidatePublishedResult
        Condition="'$(_SharpProofVerifierHostSupported)' == 'true' AND '$(DesignTimeBuild)' != 'true' AND '$(BuildingProject)' != 'false'"
        ResultPath="$(_SharpProofEffectiveResultFile)"
        ProjectDirectory="$(MSBuildProjectDirectory)"
        RequestPath="$(_SharpProofEffectiveRequestFile)"
        ManifestPath="$(_SharpProofEffectiveCompilerManifestFile)"
        SarifPath="$(_SharpProofEffectiveSarifFile)"
        InvocationRequestPath="$(_SharpProofInvocationRequestFile)"
        InvocationResultPath="$(_SharpProofInvocationResultFile)"
        InvocationManifestPath="$(_SharpProofCompilerManifestPath)"
        CompilerCaptureRequestPath="$(_SharpProofCompilerCaptureRequestPath)"
        CompilerCaptureNonce="$(_SharpProofCompilerCaptureNonce)"
        WorkerPath="$(_SharpProofWorkerPath)"
        LauncherPath="$(_SharpProofLauncherPath)"
        WorkerProtocolPath="$(_SharpProofWorkerProtocolPath)"
        CompilerOutputPaths="@(_SharpProofCompilerOwnedOutput)"
        CompilerInputPaths="@(Compile);@(AdditionalFiles);@(ReferencePath);@(ReferencePathWithRefAssemblies);@(Analyzer);@(EditorConfigFiles);@(GlobalAnalyzerConfigFiles);$(MSBuildProjectFullPath);$(MSBuildAllProjects)"
        CachePath="$(_SharpProofActiveCacheDirectory)" />
  </Target>

  <!-- The SDK calls this hook from inside CoreCompile only when it executes,
       unlike AfterTargets hooks that also run when CoreCompile is skipped. -->
  <Target Name="_SharpProofValidateCompilerCapture"
          Condition="'$(_SharpProofVerifyActive)' == 'true' AND '$(_SharpProofVerifierHostSupported)' == 'true'">
    <ItemGroup>
      <_SharpProofCompletedCapture Remove="@(_SharpProofCompletedCapture)" />
    </ItemGroup>
    <ReadLinesFromFile File="$(_SharpProofCompilerCaptureRequestPath).completed"
                       Condition="Exists('$(_SharpProofCompilerCaptureRequestPath).completed')">
      <Output TaskParameter="Lines" ItemName="_SharpProofCompletedCapture" />
    </ReadLinesFromFile>
    <Delete Files="$(_SharpProofCompilerManifestPath)"
            Condition="'@(_SharpProofCompletedCapture)' != '$(_SharpProofCompilerCaptureNonce)'" />
    <Error Code="SPB031"
           Condition="'@(_SharpProofCompletedCapture)' != '$(_SharpProofCompilerCaptureNonce)' OR !Exists('$(_SharpProofCompilerManifestPath)')"
           Text="SharpProof did not receive a fresh final compiler manifest for this compilation. Ensure the SharpProof compiler collector runs when verification is enabled." />
  </Target>

  <!-- Stamps the collector's contract export with the reference and
       implementation images this compilation produced. Without a completed
       capture of this very compilation the previous export is removed. -->
  <Target Name="_SharpProofStampContractsExport"
          Condition="'$(_SharpProofVerifierHostSupported)' == 'true' AND '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_SharpProofContractsExportDirectory>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)SharpProof'))))</_SharpProofContractsExportDirectory>
      <_SharpProofContractsExportCompleted>false</_SharpProofContractsExportCompleted>
    </PropertyGroup>
    <ItemGroup>
      <_SharpProofContractsExportCapture Remove="@(_SharpProofContractsExportCapture)" />
    </ItemGroup>
    <ReadLinesFromFile File="$(_SharpProofCompilerCaptureRequestPath).completed"
                       Condition="'$(_SharpProofVerifyActive)' == 'true' AND '$(_SharpProofCompilerCaptureRequestPath)' != '' AND Exists('$(_SharpProofCompilerCaptureRequestPath).completed')">
      <Output TaskParameter="Lines" ItemName="_SharpProofContractsExportCapture" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <_SharpProofContractsExportCompleted Condition="'$(_SharpProofCompilerCaptureNonce)' != '' AND '@(_SharpProofContractsExportCapture)' == '$(_SharpProofCompilerCaptureNonce)'">true</_SharpProofContractsExportCompleted>
    </PropertyGroup>
    <SharpProof.BuildTasks.StampContractsExport
        UnstampedPath="$([System.IO.Path]::Combine('$(_SharpProofContractsExportDirectory)', 'contracts-export.unstamped.json'))"
        OutputPath="$([System.IO.Path]::Combine('$(_SharpProofContractsExportDirectory)', 'contracts-export.json'))"
        ImplementationAssembly="@(IntermediateAssembly->'%(FullPath)')"
        ReferenceAssembly="@(IntermediateRefAssembly->'%(FullPath)')"
        CaptureCompleted="$(_SharpProofContractsExportCompleted)"
        ProjectDirectory="$(MSBuildProjectDirectory)" />
  </Target>

  <!-- A referencing project asks for this project's stamped contract export
       with the same global properties it resolved the reference with. -->
  <Target Name="SharpProofGetContractsExport"
          Returns="@(_SharpProofContractsExportOutput)">
    <PropertyGroup>
      <_SharpProofContractsExportOutputPath>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)SharpProof', 'contracts-export.json'))))</_SharpProofContractsExportOutputPath>
    </PropertyGroup>
    <ItemGroup>
      <_SharpProofContractsExportOutput Remove="@(_SharpProofContractsExportOutput)" />
      <_SharpProofContractsExportOutput Include="$(_SharpProofContractsExportOutputPath)"
                                        Condition="Exists('$(_SharpProofContractsExportOutputPath)')" />
    </ItemGroup>
  </Target>

  <!-- Each project reference built in this build may publish a contract
       export. It reaches the compiler collector as an additional file with
       dedicated metadata; the collector accepts it only when its stamp names
       the reference image this compilation resolved. It follows reference
       resolution and never forces it: an invocation that does not resolve
       references passes no export. -->
  <Target Name="_SharpProofResolveContractExports"
          DependsOnTargets="_SharpProofSetVerifyActive"
          AfterTargets="ResolveProjectReferences"
          BeforeTargets="_SharpProofInitializeVerify;GenerateMSBuildEditorConfigFileShouldRun;GenerateMSBuildEditorConfigFile;CoreCompile"
          Condition="'$(_SharpProofVerifierHostSupported)' == 'true' AND '$(DesignTimeBuild)' != 'true' AND '$(BuildingProject)' != 'false'">
    <ItemGroup>
      <_SharpProofContractExport Remove="@(_SharpProofContractExport)" />
    </ItemGroup>
    <MSBuild Projects="@(_MSBuildProjectReferenceExistent)"
             Targets="SharpProofGetContractsExport"
             BuildInParallel="$(BuildInParallel)"
             SkipNonexistentTargets="true"
             Properties="%(_MSBuildProjectReferenceExistent.SetConfiguration); %(_MSBuildProjectReferenceExistent.SetPlatform); %(_MSBuildProjectReferenceExistent.SetTargetFramework)"
             RemoveProperties="%(_MSBuildProjectReferenceExistent.GlobalPropertiesToRemove)$(_GlobalPropertiesToRemoveFromProjectReferences)"
             Condition="'$(_SharpProofVerifyActive)' == 'true' AND '%(_MSBuildProjectReferenceExistent.ReferenceOutputAssembly)' != 'false'">
      <Output TaskParameter="TargetOutputs" ItemName="_SharpProofContractExport" />
    </MSBuild>
    <ItemGroup Condition="'$(_SharpProofVerifyActive)' == 'true'">
      <AdditionalFiles Include="@(_SharpProofContractExport)" SharpProofContractsExport="true" />
    </ItemGroup>
  </Target>

  <Target Name="_SharpProofCleanupInvocation"
          Condition="'$(_SharpProofInvocationId)' != ''">
    <PropertyGroup>
      <_SharpProofCleanupVerifyDirectory>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)SharpProof'))))</_SharpProofCleanupVerifyDirectory>
      <_SharpProofCleanupRunsDirectory>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(_SharpProofCleanupVerifyDirectory)', 'runs'))))</_SharpProofCleanupRunsDirectory>
      <_SharpProofCleanupInvocationIdIsSafe>$([System.Text.RegularExpressions.Regex]::IsMatch('$(_SharpProofInvocationId)', '\A[0-9a-f]{32}\z'))</_SharpProofCleanupInvocationIdIsSafe>
      <_SharpProofCleanupExpectedInvocationDirectory>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(_SharpProofCleanupRunsDirectory)', '$(_SharpProofInvocationId)'))))</_SharpProofCleanupExpectedInvocationDirectory>
      <_SharpProofInvocationDirectory Condition="'$(_SharpProofInvocationDirectory)' == ''">$(_SharpProofCleanupExpectedInvocationDirectory)</_SharpProofInvocationDirectory>
      <_SharpProofCleanupInvocationDirectoryFullPath>$([System.IO.Path]::GetFullPath('$(_SharpProofInvocationDirectory)'))</_SharpProofCleanupInvocationDirectoryFullPath>
      <_SharpProofCleanupInvocationDirectoryIsCanonical>$([System.String]::Equals('$(_SharpProofInvocationDirectory)', '$(_SharpProofCleanupInvocationDirectoryFullPath)', System.StringComparison.Ordinal))</_SharpProofCleanupInvocationDirectoryIsCanonical>
      <_SharpProofCleanupInvocationDirectoryMatchesExpected>$([System.String]::Equals('$(_SharpProofCleanupInvocationDirectoryFullPath)', '$(_SharpProofCleanupExpectedInvocationDirectory)', System.StringComparison.Ordinal))</_SharpProofCleanupInvocationDirectoryMatchesExpected>
      <_SharpProofCleanupInvocationDirectoryParent>$([System.IO.Path]::GetDirectoryName('$(_SharpProofCleanupInvocationDirectoryFullPath)'))</_SharpProofCleanupInvocationDirectoryParent>
      <_SharpProofCleanupInvocationDirectoryIsContained>$([System.String]::Equals('$(_SharpProofCleanupInvocationDirectoryParent)', '$(_SharpProofCleanupRunsDirectory)', System.StringComparison.Ordinal))</_SharpProofCleanupInvocationDirectoryIsContained>
    </PropertyGroup>
    <Error Code="SPB028" Condition="'$(_SharpProofCleanupInvocationIdIsSafe)' != 'True'"
           Text="SharpProof invocation ID must be an exact safe identifier of 32 lowercase hexadecimal characters." />
    <Error Code="SPB029" Condition="'$(_SharpProofCleanupInvocationDirectoryIsCanonical)' != 'True' OR '$(_SharpProofCleanupInvocationDirectoryMatchesExpected)' != 'True' OR '$(_SharpProofCleanupInvocationDirectoryIsContained)' != 'True'"
           Text="SharpProof invocation cleanup directory must resolve canonically to a direct child of the package-owned runs directory." />
    <RemoveDir Directories="$(_SharpProofCleanupInvocationDirectoryFullPath)" />
  </Target>

  <Target Name="_SharpProofVerifyCore"
          DependsOnTargets="_SharpProofInitializeVerify;ResolveReferences">
    <Error Code="SPB021" Condition="'$(_SharpProofVerifierHostSupported)' != 'true' AND '$(_SharpProofVerifierHostIsMusl)' == 'true'"
           Text="SharpProof verification does not support musl Linux such as Alpine (runtime '$(_SharpProofVerifierRuntimeIdentifier)'): the packaged solver needs glibc. Build in a glibc-based image, or use SharpProofProfile=advisory with SharpProofVerify=false for analysis without proofs." />
    <Error Code="SPB020" Condition="'$(_SharpProofVerifierHostSupported)' != 'true' AND '$(_SharpProofVerifierHostIsMusl)' != 'true'"
           Text="SharpProof verification is not supported on this build host. It requires .NET SDK 10.0.100 or newer, a build process whose architecture matches the operating system (an x64 dotnet under ARM64 emulation is rejected), and either Core MSBuild on Windows, macOS or glibc Linux (x64 or ARM64), or Visual Studio 2026/MSBuild 18+ on Windows. Detected: .NET SDK '$(NETCoreSdkVersion)', MSBuild $(MSBuildVersion) ($(MSBuildRuntimeType)), OS architecture $(_SharpProofVerifierHostArchitecture), process architecture $(_SharpProofVerifierProcessArchitecture). Portable analysis remains available with SharpProofProfile=advisory and SharpProofVerify=false." />
    <Error Code="SPB022" Condition="'$(_SharpProofVerifyPolicyNormalized)' != 'advisory' AND '$(_SharpProofVerifyPolicyNormalized)' != 'warn-on-unknown' AND '$(_SharpProofVerifyPolicyNormalized)' != 'require-proven'"
           Text="SharpProofVerifyPolicy must be advisory, warn-on-unknown, or require-proven. The value is '$(SharpProofVerifyPolicy)'." />
    <Error Code="SPB023" Condition="'$(_SharpProofAssumptionPolicyNormalized)' != 'allow' AND '$(_SharpProofAssumptionPolicyNormalized)' != 'warn' AND '$(_SharpProofAssumptionPolicyNormalized)' != 'error'"
           Text="SharpProofAssumptionPolicy must be allow, warn, or error. The value is '$(SharpProofAssumptionPolicy)'." />
    <Error Code="SPB031"
           Condition="!Exists('$(_SharpProofCompilerManifestPath)')"
           Text="SharpProof did not receive the required final compiler manifest." />
    <Error Code="SPB024" Condition="!Exists('$(_SharpProofLauncherPath)')"
           Text="SharpProof verifier launcher was not found at '$(_SharpProofLauncherPath)'." />
    <Error Code="SPB025" Condition="!Exists('$(_SharpProofWorkerPath)')"
           Text="SharpProof verifier worker was not found at '$(_SharpProofWorkerPath)'." />
    <MakeDir Directories="$(_SharpProofInvocationDirectory)" />
    <ItemGroup>
      <_SharpProofVerifierArgument Remove="@(_SharpProofVerifierArgument)" />
      <_SharpProofVerifierArgument Include="$([MSBuild]::Escape('$(_SharpProofLauncherPath)'))" />
      <_SharpProofVerifierArgument Include="verify" />
      <_SharpProofVerifierArgument Include="--worker" />
      <_SharpProofVerifierArgument Include="$([MSBuild]::Escape('$(_SharpProofWorkerPath)'))" />
      <_SharpProofVerifierArgument Include="--request" />
      <_SharpProofVerifierArgument Include="$([MSBuild]::Escape('$(_SharpProofInvocationRequestFile)'))" />
      <_SharpProofVerifierArgument Include="--result" />
      <_SharpProofVerifierArgument Include="$([MSBuild]::Escape('$(_SharpProofInvocationResultFile)'))" />
      <_SharpProofVerifierArgument Include="--publish-request" />
      <_SharpProofVerifierArgument Include="$([MSBuild]::Escape('$(_SharpProofEffectiveRequestFile)'))" />
      <_SharpProofVerifierArgument Include="--publish-result" />
      <_SharpProofVerifierArgument Include="$([MSBuild]::Escape('$(_SharpProofEffectiveResultFile)'))" />
      <_SharpProofVerifierArgument Include="--compiler-manifest" />
      <_SharpProofVerifierArgument Include="$([MSBuild]::Escape('$(_SharpProofCompilerManifestPath)'))" />
      <_SharpProofVerifierArgument Include="--publish-compiler-manifest" />
      <_SharpProofVerifierArgument Include="$([MSBuild]::Escape('$(_SharpProofEffectiveCompilerManifestFile)'))" />
      <_SharpProofVerifierArgument Include="--verify-policy" />
      <_SharpProofVerifierArgument Include="$(_SharpProofVerifyPolicyNormalized)" />
      <_SharpProofVerifierArgument Include="--assumption-policy" />
      <_SharpProofVerifierArgument Include="$(_SharpProofAssumptionPolicyNormalized)" />
      <_SharpProofVerifierArgument Include="--query-rlimit" />
      <_SharpProofVerifierArgument Include="$(SharpProofVerifyQueryRlimit)" />
      <_SharpProofVerifierArgument Include="--method-rlimit" />
      <_SharpProofVerifierArgument Include="$(SharpProofVerifyMethodRlimit)" />
      <_SharpProofVerifierArgument Include="--method-wall-ms" />
      <_SharpProofVerifierArgument Include="$(SharpProofVerifyMethodWallTimeMilliseconds)" />
      <_SharpProofVerifierArgument Include="--project-wall-ms" />
      <_SharpProofVerifierArgument Include="$(SharpProofVerifyProjectWallTimeMilliseconds)" />
      <_SharpProofVerifierArgument Include="--max-parallelism" />
      <_SharpProofVerifierArgument Include="$(SharpProofVerifyMaxParallelism)" />
      <_SharpProofVerifierArgument Include="--max-expression-depth" />
      <_SharpProofVerifierArgument Include="$(SharpProofVerifyMaximumExpressionDepth)" />
      <_SharpProofVerifierArgument Include="--termination-grace-ms" />
      <_SharpProofVerifierArgument Include="$(SharpProofVerifyTerminationGraceMilliseconds)" />
      <_SharpProofVerifierArgument Include="--cache-enabled" />
      <_SharpProofVerifierArgument Include="$(SharpProofVerifyCacheEnabled)" />
      <_SharpProofVerifierArgument Include="--cache-directory" />
      <_SharpProofVerifierArgument Include="$([MSBuild]::Escape('$(_SharpProofEffectiveCacheDirectory)'))" />
      <_SharpProofVerifierArgument Include="--cache-maximum-bytes" />
      <_SharpProofVerifierArgument Include="$(SharpProofVerifyCacheMaximumBytes)" />
      <_SharpProofVerifierArgument Include="--publish-sarif"
                                   Condition="'$(_SharpProofEffectiveSarifFile)' != ''" />
      <_SharpProofVerifierArgument Include="$([MSBuild]::Escape('$(_SharpProofEffectiveSarifFile)'))"
                                   Condition="'$(_SharpProofEffectiveSarifFile)' != ''" />
    </ItemGroup>
    <SharpProof.BuildTasks.RunVerifier
        Executable="$(_SharpProofDotNetHost)"
        Arguments="@(_SharpProofVerifierArgument)"
        WorkingDirectory="$(MSBuildProjectDirectory)"
        ProjectWallTimeMilliseconds="$(SharpProofVerifyProjectWallTimeMilliseconds)"
        TerminationGraceMilliseconds="$(SharpProofVerifyTerminationGraceMilliseconds)">
      <Output TaskParameter="ExitCode"
              PropertyName="_SharpProofVerifierExitCode" />
      <Output TaskParameter="HasStructuredError"
              PropertyName="_SharpProofVerifierHasStructuredError" />
    </SharpProof.BuildTasks.RunVerifier>
    <Error Code="SPB030" Condition="'$(_SharpProofVerifierExitCode)' != '0' AND '$(_SharpProofVerifierHasStructuredError)' != 'true'"
           Text="SharpProof verifier failed with exit code $(_SharpProofVerifierExitCode). See docs/build-errors.md for the exit codes." />
    <Message Importance="High"
             Text="SharpProof verifier result: $(_SharpProofEffectiveResultFile)" />
    <Message Condition="'$(_SharpProofEffectiveSarifFile)' != ''"
             Importance="High"
             Text="SharpProof verifier SARIF result: $(_SharpProofEffectiveSarifFile)" />
    <CallTarget Targets="_SharpProofCleanupInvocation" />
    <OnError ExecuteTargets="_SharpProofCleanupInvocation" />
  </Target>

  <Target Name="SharpProofVerify"
          AfterTargets="CoreCompile"
          DependsOnTargets="_SharpProofVerifyCore"
          Condition="'$(_SharpProofVerifyActive)' == 'true' AND '$(_SharpProofVerifierHostSupported)' == 'true'">
  </Target>

  <Target Name="SharpProofResetPublishedVerification"
          BeforeTargets="Clean"
          DependsOnTargets="_SharpProofResolveVerificationPaths"
          Condition="'$(_SharpProofVerifierHostSupported)' == 'true' AND '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_SharpProofCleanVerifyDirectory>$(_SharpProofVerifyDirectory)</_SharpProofCleanVerifyDirectory>
      <_SharpProofCleanCompilerManifestStagingPath>$([System.IO.Path]::Combine('$(_SharpProofCleanVerifyDirectory)', 'compiler-manifest.staging.json'))</_SharpProofCleanCompilerManifestStagingPath>
      <_SharpProofCleanRequestFile>$(_SharpProofEffectiveRequestFile)</_SharpProofCleanRequestFile>
      <_SharpProofCleanResultFile>$(_SharpProofEffectiveResultFile)</_SharpProofCleanResultFile>
      <_SharpProofCleanManifestFile>$(_SharpProofEffectiveCompilerManifestFile)</_SharpProofCleanManifestFile>
      <_SharpProofCleanSarifFile>$(_SharpProofEffectiveSarifFile)</_SharpProofCleanSarifFile>
    </PropertyGroup>
    <Delete Files="$(_SharpProofCleanVerifyDirectory)/contracts-export.json;$(_SharpProofCleanVerifyDirectory)/contracts-export.unstamped.json" />
    <SharpProof.BuildTasks.ResetPublishedVerification
        RequestPath="$(_SharpProofCleanRequestFile)"
        ResultPath="$(_SharpProofCleanResultFile)"
        ManifestPath="$(_SharpProofCleanManifestFile)"
        SarifPath="$(_SharpProofCleanSarifFile)"
        WorkerPath="$(_SharpProofPackageWorkerPath)"
        CompilerManifestStagingPath="$(_SharpProofCleanCompilerManifestStagingPath)"
        CompilerCaptureRequestPath="$(_SharpProofCleanVerifyDirectory)/compiler-capture.request"
        ProjectDirectory="$(MSBuildProjectDirectory)" />
  </Target>

  <Target Name="SharpProofRejectUnsupportedWorkerHost"
          AfterTargets="CoreCompile"
          Condition="'$(_SharpProofVerifyActive)' == 'true' AND '$(_SharpProofVerifierHostSupported)' != 'true'">
    <Error Code="SPB021" Condition="'$(_SharpProofVerifierHostIsMusl)' == 'true'" Text="SharpProof verification does not support musl Linux such as Alpine (runtime '$(_SharpProofVerifierRuntimeIdentifier)'): the packaged solver needs glibc. Build in a glibc-based image, or use SharpProofProfile=advisory with SharpProofVerify=false for analysis without proofs." />
    <Error Code="SPB020" Condition="'$(_SharpProofVerifierHostIsMusl)' != 'true'" Text="SharpProof verification is not supported on this build host. It requires .NET SDK 10.0.100 or newer, a build process whose architecture matches the operating system (an x64 dotnet under ARM64 emulation is rejected), and either Core MSBuild on Windows, macOS or glibc Linux (x64 or ARM64), or Visual Studio 2026/MSBuild 18+ on Windows. Detected: .NET SDK '$(NETCoreSdkVersion)', MSBuild $(MSBuildVersion) ($(MSBuildRuntimeType)), OS architecture $(_SharpProofVerifierHostArchitecture), process architecture $(_SharpProofVerifierProcessArchitecture). Portable analysis remains available with SharpProofProfile=advisory and SharpProofVerify=false." />
  </Target>
</Project>
