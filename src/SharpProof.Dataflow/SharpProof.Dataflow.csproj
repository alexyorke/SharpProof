  <ItemGroup>
    <InternalsVisibleTo Include="SharpProof.Dataflow.Tests" />
    <InternalsVisibleTo Include="SharpProof.Analyzer" />
    <InternalsVisibleTo Include="SharpProof.Compiler.Semantics" />
