<Project>
  <!-- Private restore caches also supply Arcade's early package-import root. -->
  <PropertyGroup Condition="'$(RestorePackagesPath)' != '' and '$(NuGetPackageRoot)' == ''">
    <NuGetPackageRoot>$([MSBuild]::NormalizeDirectory('$(RestorePackagesPath)'))</NuGetPackageRoot>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.DotNet.Arcade.Sdk" />
  <PropertyGroup>
    <SharpProofProjectName>$(MSBuildProjectName)</SharpProofProjectName>
    <SignAssembly>false</SignAssembly>
    <Company>$(SharpProofPublisher)</Company>
    <Authors>$(SharpProofPublisher)</Authors>
    <RepositoryUrl>$(SharpProofProjectUrl)</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon />
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <Serviceable>false</Serviceable>
    <NeutralLanguage />
    <RestoreIgnoreFailedSources>false</RestoreIgnoreFailedSources>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/bin/**;**/obj/**</DefaultItemExcludes>
  </PropertyGroup>
  <PropertyGroup>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- Keep exact source available offline, including generated and linked files. -->
    <EmbedAllSources>true</EmbedAllSources>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(ContinuousIntegrationBuild)' == 'true'">true</RestoreLockedMode>
    <LangVersion Condition="'$(LangVersion)' == ''">12.0</LangVersion>
    <Nullable Condition="'$(Nullable)' == ''">enable</Nullable>
    <ImplicitUsings Condition="'$(ImplicitUsings)' == ''">enable</ImplicitUsings>
    <IsPackable Condition="'$(IsPackable)' == ''">false</IsPackable>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <!-- Run every built-in .NET analyzer rule, including rules disabled by default. -->
    <AnalysisLevel>latest-all</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <WarningsAsErrors>$(WarningsAsErrors);CA1811;CS8019;IDE0051;IDE0052;IDE0060;NU1901;NU1902;NU1903;NU1904;SPINT001;SPINT002;SPINT003;SPINT004;SPINT005</WarningsAsErrors>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <SharpProofTestProject Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(SharpProofProjectName)', '\.(Integration)?Tests$'))">true</SharpProofTestProject>
  </PropertyGroup>

  <PropertyGroup Condition="'$(SharpProofTestProject)' == 'true'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <!-- The repository analyzers skip test projects; they read this property. -->
    <CompilerVisibleProperty Include="SharpProofTestProject" />
  </ItemGroup>

  <PropertyGroup>
    <SharpProofProductionProject Condition="
      '$(SharpProofTestProject)' != 'true' And
      !$([System.Text.RegularExpressions.Regex]::IsMatch('$(MSBuildProjectFullPath)', '[/\\]samples[/\\]')) And
      !$([System.Text.RegularExpressions.Regex]::IsMatch('$(SharpProofProjectName)', '^SharpProof\.(Testing|Package|Verifier|Smoke\.Net472|CompilerProbe\.TestAsset)$'))">true</SharpProofProductionProject>
    <NoWarn Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(SharpProofProjectName)', '^SharpProof\.(Analyzer|CompilerCollector)$'))">$(NoWarn);RS2002;RS2003</NoWarn>
    <CopyLocalLockFileAssemblies Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(SharpProofProjectName)', '^SharpProof\.(Analyzer|CompilerCollector)$'))">true</CopyLocalLockFileAssemblies>
    <SharpProofUsesIrIdentifiers Condition="
      '$(SharpProofProjectName)' == 'SharpProof.Analyzer' Or
      '$(SharpProofProjectName)' == 'SharpProof.Compiler.Semantics' Or
      '$(SharpProofProjectName)' == 'SharpProof.CompilerArtifact' Or
      '$(SharpProofProjectName)' == 'SharpProof.CompilerCollector' Or
      '$(SharpProofProjectName)' == 'SharpProof.Compiler.Semantics.Tests' Or
      '$(SharpProofProjectName)' == 'SharpProof.Frontend' Or
      '$(SharpProofProjectName)' == 'SharpProof.Frontend.Tests' Or
      '$(SharpProofProjectName)' == 'SharpProof.Fuzz' Or
      '$(SharpProofProjectName)' == 'SharpProof.Ir.Tests' Or
      '$(SharpProofProjectName)' == 'SharpProof.Smt' Or
      '$(SharpProofProjectName)' == 'SharpProof.Specs' Or
      '$(SharpProofProjectName)' == 'SharpProof.Testing' Or
      '$(SharpProofProjectName)' == 'SharpProof.Testing.Tests' Or
      '$(SharpProofProjectName)' == 'SharpProof.Worker' Or
      '$(SharpProofProjectName)' == 'SharpProof.Worker.Tests'">true</SharpProofUsesIrIdentifiers>
  </PropertyGroup>

  <PropertyGroup Condition="'$(SharpProofProductionProject)' == 'true' AND $([System.String]::Copy('$(SharpProofProjectName)').StartsWith('SharpProof.')) AND '$(SharpProofProjectName)' != 'SharpProof.Attributes'">
    <!-- Tooling carries symbols into Roslyn shadow copies and MSBuild task hosts. -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup Condition="'$(SharpProofUsesIrIdentifiers)' == 'true'">
    <!--
      These aliases keep the internal IR vocabulary readable while all ID
      kinds share one type-safe scoped implementation.
    -->
    <Compile Include="$(MSBuildThisFileDirectory)src\SharpProof.Ir\IrIdentifierAliases.cs"
             Link="IrIdentifierAliases.cs" />
  </ItemGroup>

  <PropertyGroup Condition="'$(SharpProofProjectName)' == 'ConsoleLoggingAnalyzer' OR
                        '$(SharpProofProjectName)' == 'DefensiveCodingAnalyzer' OR
                        '$(SharpProofProjectName)' == 'SharpProof.Analyzer' OR
                        '$(SharpProofProjectName)' == 'SharpProof.Compiler.Semantics' OR
                        '$(SharpProofProjectName)' == 'SharpProof.CompilerArtifact' OR
                        '$(SharpProofProjectName)' == 'SharpProof.CompilerCollector' OR
                        '$(SharpProofProjectName)' == 'SharpProof.CompilerProbe.TestAsset' OR
                        '$(SharpProofProjectName)' == 'SharpProof.Dataflow' OR
                        '$(SharpProofProjectName)' == 'SharpProof.Frontend' OR
                        '$(SharpProofProjectName)' == 'SharpProof.Fuzz' OR
                        '$(SharpProofProjectName)' == 'SharpProof.Gates' OR
                        '$(SharpProofProjectName)' == 'SharpProof.Host' OR
                        '$(SharpProofProjectName)' == 'SharpProof.Ir' OR
                        '$(SharpProofProjectName)' == 'SharpProof.Smt' OR
                        '$(SharpProofProjectName)' == 'SharpProof.Specs' OR
                        '$(SharpProofProjectName)' == 'SharpProof.Testing' OR
                        '$(SharpProofProjectName)' == 'SharpProof.Tool' OR
                        '$(SharpProofProjectName)' == 'SharpProof.Worker' OR
                        '$(SharpProofProjectName)' == 'SharpProof.Worker.Protocol'">
    <SharpProofHasParameterGuard>true</SharpProofHasParameterGuard>
    <DefineConstants>$(DefineConstants);SHARPPROOF_PARAMETER_GUARD_$([System.String]::Copy('$(SharpProofProjectName)').Replace('.', '_').ToUpperInvariant())</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(SharpProofHasParameterGuard)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)eng/ParameterGuard.cs" Link="InternalParameterGuard.cs" />
    <Using Include="SharpProof.Internal.$([System.String]::Copy('$(SharpProofProjectName)').Replace('.', '')).ParameterGuard" Alias="RepositoryParameterGuard" />
  </ItemGroup>

  <ItemGroup Condition="'$(SharpProofTestProject)' == 'true' AND '$(SharpProofProjectName)' != 'SharpProof.Architecture.Tests' AND '$(SharpProofProjectName)' != 'SharpProof.Attributes.Tests'">
    <Compile Include="$(MSBuildThisFileDirectory)eng/testing/ParameterGuardContractTests.cs" Link="ParameterGuardContractTests.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(SharpProofTestProject)' == 'true'">
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsRoslynAnalyzer)' == 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(SharpProofProductionProject)' == 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers"
                      PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)eng/analyzers/BannedSymbols.txt" Link="BannedSymbols.txt" />
  </ItemGroup>

  <PropertyGroup Condition="'$(SharpProofProductionProject)' == 'true'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors>$(WarningsAsErrors);RS0030</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup Condition="'$(SharpProofProjectName)' == 'SharpProof.Attributes'">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers"
                      PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildProjectDirectory)\PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="$(MSBuildProjectDirectory)\PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <PropertyGroup Condition="'$(SharpProofProjectName)' == 'SharpProof.Attributes'">
    <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017;RS0041</WarningsAsErrors>
  </PropertyGroup>
</Project>
