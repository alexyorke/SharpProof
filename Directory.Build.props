<Project>
  <Import Project="$(MSBuildThisFileDirectory)SharpProof.Release.props" />
  <PropertyGroup>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(ContinuousIntegrationBuild)' == 'true'">true</RestoreLockedMode>
    <LangVersion Condition="'$(LangVersion)' == ''">12.0</LangVersion>
    <Nullable Condition="'$(Nullable)' == ''">enable</Nullable>
    <ImplicitUsings Condition="'$(ImplicitUsings)' == ''">enable</ImplicitUsings>
    <IsPackable Condition="'$(IsPackable)' == ''">false</IsPackable>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <!-- Run every built-in .NET analyzer rule, including rules disabled by default. -->
    <AnalysisLevel>latest-all</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <WarningsAsErrors>$(WarningsAsErrors);CA1811;CS8019;IDE0051;IDE0052;IDE0060;NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <SharpProofTestProject Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(MSBuildProjectName)', 'Test$'))">true</SharpProofTestProject>
  </PropertyGroup>

  <PropertyGroup Condition="'$(SharpProofTestProject)' == 'true'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <PropertyGroup>
    <SharpProofProductionProject Condition="
      '$(SharpProofTestProject)' != 'true' And
      !$([System.Text.RegularExpressions.Regex]::IsMatch('$(MSBuildProjectFullPath)', '[/\\](samples|eng[/\\]pilots)[/\\]')) And
      !$([System.Text.RegularExpressions.Regex]::IsMatch('$(MSBuildProjectName)', '^SharpProof\.(Testing|Package|Verifier|Smoke\.Net472|CompilerProbe\.TestAsset)$'))">true</SharpProofProductionProject>
    <NoWarn Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(MSBuildProjectName)', '^SharpProof\.(Analyzer\.Core|Analyzer|CompilerCollector)$'))">$(NoWarn);RS2002;RS2003</NoWarn>
    <CopyLocalLockFileAssemblies Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(MSBuildProjectName)', '^SharpProof\.(Analyzer\.Core|Analyzer|CompilerCollector)$'))">true</CopyLocalLockFileAssemblies>
    <SharpProofUsesIrIdentifiers Condition="
      '$(MSBuildProjectName)' == 'SharpProof.Analyzer.Core' Or
      '$(MSBuildProjectName)' == 'SharpProof.CompilerArtifact' Or
      '$(MSBuildProjectName)' == 'SharpProof.CompilerCollector' Or
      '$(MSBuildProjectName)' == 'SharpProof.Contracts' Or
      '$(MSBuildProjectName)' == 'SharpProof.Frontend' Or
      '$(MSBuildProjectName)' == 'SharpProof.Frontend.Test' Or
      '$(MSBuildProjectName)' == 'SharpProof.Fuzz' Or
      '$(MSBuildProjectName)' == 'SharpProof.Ir.Test' Or
      '$(MSBuildProjectName)' == 'SharpProof.Smt' Or
      '$(MSBuildProjectName)' == 'SharpProof.Specs' Or
      '$(MSBuildProjectName)' == 'SharpProof.Summaries' Or
      '$(MSBuildProjectName)' == 'SharpProof.Summaries.Test' Or
      '$(MSBuildProjectName)' == 'SharpProof.Testing' Or
      '$(MSBuildProjectName)' == 'SharpProof.Testing.Test' Or
      '$(MSBuildProjectName)' == 'SharpProof.Verify' Or
      '$(MSBuildProjectName)' == 'SharpProof.Verify.Test' Or
      '$(MSBuildProjectName)' == 'SharpProof.Worker' Or
      '$(MSBuildProjectName)' == 'SharpProof.Worker.Test'">true</SharpProofUsesIrIdentifiers>
  </PropertyGroup>

  <ItemGroup Condition="'$(SharpProofUsesIrIdentifiers)' == 'true'">
    <!--
      These aliases keep the internal IR vocabulary readable while all ID
      kinds share one type-safe scoped implementation.
    -->
    <Compile Include="$(MSBuildThisFileDirectory)SharpProof.Ir\IrIdentifierAliases.cs"
             Link="IrIdentifierAliases.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(SharpProofTestProject)' == 'true'">
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'SharpProof.Analyzer.Test' OR
                        '$(MSBuildProjectName)' == 'SharpProof.ArchitectureTest' OR
                        '$(MSBuildProjectName)' == 'SharpProof.ContractForGenerator.Test' OR
                        '$(MSBuildProjectName)' == 'SharpProof.Contracts.Test' OR
                        '$(MSBuildProjectName)' == 'SharpProof.Effects.Test' OR
                        '$(MSBuildProjectName)' == 'SharpProof.Frontend.Test' OR
                        '$(MSBuildProjectName)' == 'SharpProof.Ir.Test' OR
                        '$(MSBuildProjectName)' == 'SharpProof.Meta.Analyzers.Test' OR
                        '$(MSBuildProjectName)' == 'SharpProof.Package.Test' OR
                        '$(MSBuildProjectName)' == 'SharpProof.Specs.Test' OR
                        '$(MSBuildProjectName)' == 'SharpProof.Worker.Test'">
    <Compile Include="$(MSBuildThisFileDirectory)eng\testing\TestRepository.cs"
             Link="TestRepository.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'SharpProof.ArchitectureTest' OR
                        '$(MSBuildProjectName)' == 'SharpProof.Package.Test' OR
                        '$(MSBuildProjectName)' == 'SharpProof.Specs.Test'">
    <Compile Include="$(MSBuildThisFileDirectory)eng\testing\ProcessRunner.cs"
             Link="ProcessRunner.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'SharpProof.Package.Test' OR
                        '$(MSBuildProjectName)' == 'SharpProof.ArchitectureTest' OR
                        '$(MSBuildProjectName)' == 'SharpProof.Gates.Test' OR
                        '$(MSBuildProjectName)' == 'SharpProof.Worker.Test'">
    <Compile Include="$(MSBuildThisFileDirectory)eng\testing\TempDirectory.cs"
             Link="TempDirectory.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'SharpProof.Contracts.Test' OR
                        '$(MSBuildProjectName)' == 'SharpProof.Package.Test' OR
                        '$(MSBuildProjectName)' == 'SharpProof.Worker.Test'">
    <Compile Include="$(MSBuildThisFileDirectory)eng\testing\TestMetadataReferences.cs"
             Link="TestMetadataReferences.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'SharpProof.Contracts.Test' OR
                        '$(MSBuildProjectName)' == 'SharpProof.Worker.Test'">
    <Compile Include="$(MSBuildThisFileDirectory)eng\testing\TestCompilation.cs"
             Link="TestCompilation.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'SharpProof.Package.Test' OR
                        '$(MSBuildProjectName)' == 'SharpProof.Worker.Test'">
    <Compile Include="$(MSBuildThisFileDirectory)eng\testing\AllocationWitnessKinds.cs"
             Link="AllocationWitnessKinds.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsRoslynAnalyzer)' == 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'SharpProof.Analyzer.Test' OR
                        '$(MSBuildProjectName)' == 'SharpProof.ContractForGenerator.Test' OR
                        '$(MSBuildProjectName)' == 'SharpProof.Gates' OR
                        '$(MSBuildProjectName)' == 'SharpProof.Package.Test'">
    <Compile Include="$(MSBuildThisFileDirectory)eng\testing\DictionaryAnalyzerConfigOptions.cs"
             Link="DictionaryAnalyzerConfigOptions.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'SharpProof.Analyzer.Test' OR
                        '$(MSBuildProjectName)' == 'SharpProof.ContractForGenerator.Test' OR
                        '$(MSBuildProjectName)' == 'SharpProof.Meta.Analyzers.Test'">
    <Compile Include="$(MSBuildThisFileDirectory)eng\testing\DiagnosticDescriptorCatalogAssertions.cs"
             Link="DiagnosticDescriptorCatalogAssertions.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'SharpProof.Effects.Test' OR
                        '$(MSBuildProjectName)' == 'SharpProof.Specs.Test'">
    <Compile Include="$(MSBuildThisFileDirectory)eng\testing\ApiSpecTestFacets.cs"
             Link="ApiSpecTestFacets.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'SharpProof.Analyzer.Test' OR
                        '$(MSBuildProjectName)' == 'SharpProof.Effects.Test'">
    <Compile Include="$(MSBuildThisFileDirectory)eng\testing\RuntimeAssemblyTestHost.cs"
             Link="RuntimeAssemblyTestHost.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(SharpProofProductionProject)' == 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers"
                      PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt"
                     Link="BannedSymbols.txt" />
  </ItemGroup>

  <PropertyGroup Condition="'$(SharpProofProductionProject)' == 'true'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors>$(WarningsAsErrors);RS0030</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'SharpProof.Attributes'">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers"
                      PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildProjectDirectory)\PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="$(MSBuildProjectDirectory)\PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'SharpProof.Attributes'">
    <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017</WarningsAsErrors>
  </PropertyGroup>
</Project>
