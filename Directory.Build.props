<Project>
  <Import Project="$(MSBuildThisFileDirectory)SharpProof.Release.props" />
  <PropertyGroup>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(ContinuousIntegrationBuild)' == 'true'">true</RestoreLockedMode>
    <Nullable Condition="'$(Nullable)' == ''">enable</Nullable>
    <ImplicitUsings Condition="'$(ImplicitUsings)' == ''">enable</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <!-- Run every built-in .NET analyzer rule, including rules disabled by default. -->
    <AnalysisLevel>latest-all</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <WarningsAsErrors>$(WarningsAsErrors);CA1811;CS8019;IDE0051;IDE0052;IDE0060;NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <SharpProofTestProject Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(MSBuildProjectName)', 'Test$'))">true</SharpProofTestProject>
  </PropertyGroup>

  <PropertyGroup>
    <SharpProofProductionProject Condition="
      '$(MSBuildProjectName)' == 'SharpProof.Analyzer' Or
      '$(MSBuildProjectName)' == 'SharpProof.Attributes' Or
      '$(MSBuildProjectName)' == 'SharpProof.CompilerCollector' Or
      '$(MSBuildProjectName)' == 'SharpProof.ContractForGenerator' Or
      '$(MSBuildProjectName)' == 'SharpProof.CompilerArtifact' Or
      '$(MSBuildProjectName)' == 'SharpProof.Contracts' Or
      '$(MSBuildProjectName)' == 'SharpProof.Dataflow' Or
      '$(MSBuildProjectName)' == 'SharpProof.Effects' Or
      '$(MSBuildProjectName)' == 'SharpProof.Frontend' Or
      '$(MSBuildProjectName)' == 'SharpProof.Ir' Or
      '$(MSBuildProjectName)' == 'SharpProof.Meta.Analyzers' Or
      '$(MSBuildProjectName)' == 'SharpProof.PortableAnalyzer' Or
      '$(MSBuildProjectName)' == 'SharpProof.Smt' Or
      '$(MSBuildProjectName)' == 'SharpProof.Specs' Or
      '$(MSBuildProjectName)' == 'SharpProof.Verify' Or
      '$(MSBuildProjectName)' == 'SharpProof.Worker' Or
      '$(MSBuildProjectName)' == 'SharpProof.Worker.Launcher' Or
      '$(MSBuildProjectName)' == 'SharpProof.Worker.Protocol'">true</SharpProofProductionProject>
    <SharpProofUsesIrIdentifiers Condition="
      '$(MSBuildProjectName)' == 'SharpProof.Analyzer' Or
      '$(MSBuildProjectName)' == 'SharpProof.CompilerArtifact' Or
      '$(MSBuildProjectName)' == 'SharpProof.CompilerCollector' Or
      '$(MSBuildProjectName)' == 'SharpProof.Contracts' Or
      '$(MSBuildProjectName)' == 'SharpProof.Frontend' Or
      '$(MSBuildProjectName)' == 'SharpProof.Frontend.Test' Or
      '$(MSBuildProjectName)' == 'SharpProof.Fuzz' Or
      '$(MSBuildProjectName)' == 'SharpProof.Fuzz.Test' Or
      '$(MSBuildProjectName)' == 'SharpProof.Ir.Test' Or
      '$(MSBuildProjectName)' == 'SharpProof.Smt' Or
      '$(MSBuildProjectName)' == 'SharpProof.Specs' Or
      '$(MSBuildProjectName)' == 'SharpProof.Testing' Or
      '$(MSBuildProjectName)' == 'SharpProof.Testing.Test' Or
      '$(MSBuildProjectName)' == 'SharpProof.Verify' Or
      '$(MSBuildProjectName)' == 'SharpProof.Verify.Test' Or
      '$(MSBuildProjectName)' == 'SharpProof.Worker' Or
      '$(MSBuildProjectName)' == 'SharpProof.Worker.Test'">true</SharpProofUsesIrIdentifiers>
  </PropertyGroup>

  <ItemGroup Condition="'$(SharpProofUsesIrIdentifiers)' == 'true'">
    <!--
      These aliases keep the internal IR vocabulary readable while all ID
      kinds share one type-safe scoped implementation.
    -->
    <Compile Include="$(MSBuildThisFileDirectory)SharpProof.Ir\IrIdentifierAliases.cs"
             Link="IrIdentifierAliases.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(SharpProofProductionProject)' == 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers"
                      PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt"
                     Link="BannedSymbols.txt" />
  </ItemGroup>

  <PropertyGroup Condition="'$(SharpProofProductionProject)' == 'true'">
    <WarningsAsErrors>$(WarningsAsErrors);RS0030</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'SharpProof.Attributes'">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers"
                      PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildProjectDirectory)\PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="$(MSBuildProjectDirectory)\PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'SharpProof.Attributes'">
    <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017</WarningsAsErrors>
  </PropertyGroup>
</Project>
