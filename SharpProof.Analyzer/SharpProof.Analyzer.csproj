<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsRoslynAnalyzer>true</IsRoslynAnalyzer>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion> 
    <ImplicitUsings>enable</ImplicitUsings> 
    <GeneratedPurityBuiltInSummaryDirectory Condition="'$(GeneratedPurityBuiltInSummaryDirectory)' == ''">$(BaseIntermediateOutputPath)$(Configuration)\$(TargetFramework)\GeneratedPurity</GeneratedPurityBuiltInSummaryDirectory>
    <GeneratedPurityArtifactSpecSourcePath Condition="'$(GeneratedPurityArtifactSpecSourcePath)' == ''">$(MSBuildThisFileDirectory)BuiltInEffectSummaryArtifactSpec.json</GeneratedPurityArtifactSpecSourcePath>
    <GeneratedPurityArtifactSpecPath Condition="'$(GeneratedPurityArtifactSpecPath)' == ''">$(GeneratedPurityBuiltInSummaryDirectory)\BuiltInEffectSummaryArtifactSpec.json</GeneratedPurityArtifactSpecPath>
    <GeneratedPurityToolProjectPath Condition="'$(GeneratedPurityToolProjectPath)' == ''">$(MSBuildThisFileDirectory)..\Tools\SharpProof.EffectSummary\SharpProof.EffectSummary.csproj</GeneratedPurityToolProjectPath>
    <GeneratedPurityToolDllPath Condition="'$(GeneratedPurityToolDllPath)' == ''">$(MSBuildThisFileDirectory)..\Tools\SharpProof.EffectSummary\bin\$(Configuration)\net8.0\SharpProof.EffectSummary.dll</GeneratedPurityToolDllPath>
    <GeneratedPurityGenerationStampPath Condition="'$(GeneratedPurityGenerationStampPath)' == ''">$(GeneratedPurityBuiltInSummaryDirectory)\generation.$(NETCoreSdkVersion).stamp</GeneratedPurityGenerationStampPath>
    <MicrosoftZ3ManagedDllPath Condition="'$(MicrosoftZ3ManagedDllPath)' == ''">$(NuGetPackageRoot)microsoft.z3\4.12.2\lib\netstandard2.0\Microsoft.Z3.dll</MicrosoftZ3ManagedDllPath>
  </PropertyGroup>

  <ItemGroup>
    
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="4.14.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />

    
    <PackageReference Include="System.Collections.Immutable" Version="9.0.0" /> 
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
  </ItemGroup>

  
  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpProof.Symbolic\SharpProof.Symbolic.csproj" />
    <ProjectReference Include="..\SearchLib\SearchLib.csproj" />
    <Compile Include="..\Shared\BclPurityFallbackHeuristics.cs" Link="Engine\BclPurityFallbackHeuristics.cs" />
    <Compile Include="..\Shared\Constants.cs" Link="Engine\Constants.cs" />
    <None Include="$(MicrosoftZ3ManagedDllPath)" CopyToOutputDirectory="PreserveNewest" Link="Microsoft.Z3.dll" />
  </ItemGroup>
  
  <Target Name="BuildBuiltInEffectSummaryTool">
    <MSBuild Projects="$(GeneratedPurityToolProjectPath)"
             Targets="Build"
             Properties="Configuration=$(Configuration)" />
  </Target>

  <Target Name="GenerateBuiltInEffectSummaries"
          BeforeTargets="AssignTargetPaths"
          DependsOnTargets="BuildBuiltInEffectSummaryTool"
          Inputs="$(GeneratedPurityArtifactSpecSourcePath);$(GeneratedPurityToolDllPath)"
          Outputs="$(GeneratedPurityGenerationStampPath)">
    <RemoveDir Directories="$(GeneratedPurityBuiltInSummaryDirectory)"
               Condition="Exists('$(GeneratedPurityBuiltInSummaryDirectory)')" />
    <MakeDir Directories="$(GeneratedPurityBuiltInSummaryDirectory)" />

    <Copy SourceFiles="$(GeneratedPurityArtifactSpecSourcePath)"
          DestinationFiles="$(GeneratedPurityArtifactSpecPath)" />

    <Exec Command='dotnet &quot;$(GeneratedPurityToolDllPath)&quot; --artifact-spec &quot;$(GeneratedPurityArtifactSpecPath)&quot;' />

    <WriteLinesToFile File="$(GeneratedPurityGenerationStampPath)"
                      Lines="$(NETCoreSdkVersion)"
                      Overwrite="true" />
  </Target>

  <Target Name="IncludeGeneratedPurityBuiltInSummaries"
          BeforeTargets="AssignTargetPaths"
          DependsOnTargets="GenerateBuiltInEffectSummaries">
    <ItemGroup Condition="Exists('$(GeneratedPurityBuiltInSummaryDirectory)')">
      <_GeneratedPurityBuiltInSummary Include="$(GeneratedPurityBuiltInSummaryDirectory)\*.SharpProof.EffectSummary.json" />
      <EmbeddedResource Include="@(_GeneratedPurityBuiltInSummary)">
        <LogicalName>SharpProof.Analyzer.GeneratedPurity.%(Filename)%(Extension)</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

</Project> 
