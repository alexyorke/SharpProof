<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsRoslynAnalyzer>true</IsRoslynAnalyzer>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion> 
    <ImplicitUsings>enable</ImplicitUsings> 
    <GeneratedPurityBuiltInSummaryDirectory Condition="'$(GeneratedPurityBuiltInSummaryDirectory)' == ''">$(BaseIntermediateOutputPath)$(Configuration)\$(TargetFramework)\GeneratedPurity</GeneratedPurityBuiltInSummaryDirectory>
    <GeneratedPurityArtifactSpecSourcePath Condition="'$(GeneratedPurityArtifactSpecSourcePath)' == ''">$(MSBuildThisFileDirectory)BuiltInEffectSummaryArtifactSpec.json</GeneratedPurityArtifactSpecSourcePath>
    <GeneratedPurityArtifactSpecPath Condition="'$(GeneratedPurityArtifactSpecPath)' == ''">$(GeneratedPurityBuiltInSummaryDirectory)\BuiltInEffectSummaryArtifactSpec.json</GeneratedPurityArtifactSpecPath>
    <GeneratedPurityToolProjectPath Condition="'$(GeneratedPurityToolProjectPath)' == ''">$(MSBuildThisFileDirectory)..\Tools\SharpProof.EffectSummary\SharpProof.EffectSummary.csproj</GeneratedPurityToolProjectPath>
    <GeneratedPurityToolDllPath Condition="'$(GeneratedPurityToolDllPath)' == ''">$(MSBuildThisFileDirectory)..\Tools\SharpProof.EffectSummary\bin\$(Configuration)\net8.0\SharpProof.EffectSummary.dll</GeneratedPurityToolDllPath>
    <GeneratedPurityGenerationStampPath Condition="'$(GeneratedPurityGenerationStampPath)' == ''">$(GeneratedPurityBuiltInSummaryDirectory)\generation.$(NETCoreSdkVersion).stamp</GeneratedPurityGenerationStampPath>
    <GeneratedPurityBuiltInSummaryStagingDirectory Condition="'$(GeneratedPurityBuiltInSummaryStagingDirectory)' == ''">$(GeneratedPurityBuiltInSummaryDirectory).staging</GeneratedPurityBuiltInSummaryStagingDirectory>
    <GeneratedPurityStagingArtifactSpecPath Condition="'$(GeneratedPurityStagingArtifactSpecPath)' == ''">$(GeneratedPurityBuiltInSummaryStagingDirectory)\BuiltInEffectSummaryArtifactSpec.json</GeneratedPurityStagingArtifactSpecPath>
    <SharpProofSkipGeneratedEffectSummaries Condition="'$(SharpProofSkipGeneratedEffectSummaries)' == ''">false</SharpProofSkipGeneratedEffectSummaries>
    <MicrosoftZ3ManagedDllPath Condition="'$(MicrosoftZ3ManagedDllPath)' == ''">$(NuGetPackageRoot)microsoft.z3\4.12.2\lib\netstandard2.0\Microsoft.Z3.dll</MicrosoftZ3ManagedDllPath>
  </PropertyGroup>

  <ItemGroup>
    
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="4.14.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />

    
    <PackageReference Include="System.Collections.Immutable" Version="9.0.0" /> 
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
  </ItemGroup>

  
  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpProof.Symbolic\SharpProof.Symbolic.csproj" />
    <ProjectReference Include="..\SearchLib\SearchLib.csproj" />
    <Compile Include="..\Shared\BclPurityFallbackHeuristics.cs" Link="Engine\BclPurityFallbackHeuristics.cs" />
    <Compile Include="..\Shared\Constants.cs" Link="Engine\Constants.cs" />
    <None Include="$(MicrosoftZ3ManagedDllPath)" CopyToOutputDirectory="PreserveNewest" Link="Microsoft.Z3.dll" />
    <_GeneratedPuritySummaryOutputs Include="$(GeneratedPurityBuiltInSummaryDirectory)\*.SharpProof.EffectSummary.json" />
  </ItemGroup>
  
  <Target Name="BuildBuiltInEffectSummaryTool"
          Condition="'$(SharpProofSkipGeneratedEffectSummaries)' != 'true'">
    <MSBuild Projects="$(GeneratedPurityToolProjectPath)"
             Targets="Build"
             Properties="Configuration=$(Configuration)" />
  </Target>

  <Target Name="GenerateBuiltInEffectSummaries"
          BeforeTargets="AssignTargetPaths"
          DependsOnTargets="BuildBuiltInEffectSummaryTool"
          Condition="'$(SharpProofSkipGeneratedEffectSummaries)' != 'true'"
          Inputs="$(GeneratedPurityArtifactSpecSourcePath);$(GeneratedPurityToolDllPath)"
          Outputs="$(GeneratedPurityGenerationStampPath);$(GeneratedPurityArtifactSpecPath);@(_GeneratedPuritySummaryOutputs)">
    <RemoveDir Directories="$(GeneratedPurityBuiltInSummaryStagingDirectory)"
               Condition="Exists('$(GeneratedPurityBuiltInSummaryStagingDirectory)')" />
    <MakeDir Directories="$(GeneratedPurityBuiltInSummaryStagingDirectory)" />

    <Copy SourceFiles="$(GeneratedPurityArtifactSpecSourcePath)"
          DestinationFiles="$(GeneratedPurityStagingArtifactSpecPath)" />

    <Exec Command='dotnet &quot;$(GeneratedPurityToolDllPath)&quot; --artifact-spec &quot;$(GeneratedPurityStagingArtifactSpecPath)&quot;' IgnoreExitCode="true" ConsoleToMSBuild="true">
      <Output TaskParameter="ExitCode" PropertyName="_SharpProofEffectSummaryExitCode" />
    </Exec>

    <Error Condition="'$(_SharpProofEffectSummaryExitCode)' != '0'"
           Text="SharpProof effect-summary generation failed with exit code $(_SharpProofEffectSummaryExitCode). Check artifact spec '$(GeneratedPurityStagingArtifactSpecPath)' and tool '$(GeneratedPurityToolDllPath)'. The previous generated summaries were left untouched." />

    <ItemGroup>
      <_SharpProofStagedSummaryFiles Include="$(GeneratedPurityBuiltInSummaryStagingDirectory)\*.SharpProof.EffectSummary.json" />
    </ItemGroup>

    <Error Condition="'@(_SharpProofStagedSummaryFiles)' == ''"
           Text="SharpProof effect-summary generation produced no summary resources from '$(GeneratedPurityStagingArtifactSpecPath)'. The previous generated summaries were left untouched." />

    <RemoveDir Directories="$(GeneratedPurityBuiltInSummaryDirectory)"
               Condition="Exists('$(GeneratedPurityBuiltInSummaryDirectory)')" />
    <MakeDir Directories="$(GeneratedPurityBuiltInSummaryDirectory)" />

    <Copy SourceFiles="$(GeneratedPurityStagingArtifactSpecPath)"
          DestinationFiles="$(GeneratedPurityArtifactSpecPath)" />

    <Copy SourceFiles="@(_SharpProofStagedSummaryFiles)"
          DestinationFolder="$(GeneratedPurityBuiltInSummaryDirectory)" />

    <WriteLinesToFile Condition="'$(_SharpProofEffectSummaryExitCode)' == '0'"
                      File="$(GeneratedPurityGenerationStampPath)"
                      Lines="$(NETCoreSdkVersion)"
                      Overwrite="true" />

    <RemoveDir Directories="$(GeneratedPurityBuiltInSummaryStagingDirectory)"
               Condition="Exists('$(GeneratedPurityBuiltInSummaryStagingDirectory)')" />
  </Target>

  <Target Name="IncludeGeneratedPurityBuiltInSummaries"
          BeforeTargets="AssignTargetPaths"
          DependsOnTargets="GenerateBuiltInEffectSummaries"
          Condition="'$(SharpProofSkipGeneratedEffectSummaries)' != 'true'">
    <ItemGroup Condition="Exists('$(GeneratedPurityBuiltInSummaryDirectory)')">
      <_GeneratedPurityBuiltInSummary Include="$(GeneratedPurityBuiltInSummaryDirectory)\*.SharpProof.EffectSummary.json" />
      <EmbeddedResource Include="@(_GeneratedPurityBuiltInSummary)">
        <LogicalName>SharpProof.Analyzer.GeneratedPurity.%(Filename)%(Extension)</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

</Project> 
