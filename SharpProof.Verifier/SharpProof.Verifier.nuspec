<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>SharpProof.Verifier</id>
    <version>$version$</version>
    <title>SharpProof Verifier</title>
    <authors>$authors$</authors>
    <license type="expression">$license$</license>
    <readme>$readme$</readme>
    <projectUrl>$projecturl$</projectUrl>
    <description>Container-only Linux amd64 postcondition verifier for SharpProof, including the worker, launcher, MSBuild integration, and the pinned native Z3 payload.</description>
    <releaseNotes>Initial container-first Linux amd64 verifier package for the soundness-first SharpProof preview.</releaseNotes>
    <copyright>Copyright (c) Alex Yorke</copyright>
    <tags>SharpProof Verifier Contracts SMT Z3 Linux Container x64</tags>
    <repository type="$repositorytype$" url="$repositoryurl$" commit="$repositorycommit$" />
    <dependencies>
      <group targetFramework=".NETStandard2.0">
        <dependency id="SharpProof" version="[$version$]" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="buildTransitive\SharpProof.Verifier.props" target="buildTransitive" />
    <file src="buildTransitive\SharpProof.Verifier.targets" target="buildTransitive" />
    <file src="..\README.md" />
    <file src="..\LICENSE" />
    <file src="..\THIRD-PARTY-NOTICES.txt" />
    <file src="$nativeroot$/z3/4.12.2/linux-x64/Microsoft.Z3.dll" target="tools/net9" />
    <file src="..\SharpProof.Worker\bin\$configuration$\net9.0\SharpProof.*.pdb" target="tools\net9" />
    <file src="..\SharpProof.Worker\bin\$configuration$\net9.0\SharpProof.CompilerArtifact.dll" target="tools\net9" />
    <file src="..\SharpProof.Worker\bin\$configuration$\net9.0\SharpProof.Dataflow.dll" target="tools\net9" />
