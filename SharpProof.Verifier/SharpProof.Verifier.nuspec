<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>SharpProof.Verifier</id>
    <version>$version$</version>
    <title>SharpProof Verifier</title>
    <authors>$authors$</authors>
    <license type="expression">$license$</license>
    <readme>$readme$</readme>
    <icon>icon.png</icon>
    <projectUrl>$projecturl$</projectUrl>
    <description>Complete one-package postcondition verifier for SharpProof on native Windows, macOS, and glibc Linux, each on x64 and ARM64. Includes automatic MSBuild integration, worker, launcher, and pinned native Z3 payloads.</description>
    <releaseNotes>Automatic verification with one PackageReference on Windows, macOS, and glibc Linux x64/ARM64 using the .NET 10 SDK. Windows solver payloads include their C++ runtime.</releaseNotes>
    <copyright>$copyright$</copyright>
    <tags>SharpProof Verifier Contracts SMT Z3 Windows Linux Container macOS ARM64 x64</tags>
    <repository type="$repositorytype$" url="$repositoryurl$" commit="$repositorycommit$" />
    <dependencies>
      <group targetFramework=".NETStandard2.0">
        <dependency id="SharpProof.Attributes" version="[$version$]" />
      </group>
    </dependencies>
  </metadata>
