<Project TreatAsLocalProperty="_SharpProofVerifyDirectory;_SharpProofInvocationRunsDirectory;_SharpProofInvocationIdIsSafe;_SharpProofExpectedInvocationDirectory;_SharpProofInvocationDirectoryFullPath;_SharpProofInvocationDirectoryIsCanonical;_SharpProofInvocationDirectoryMatchesExpected;_SharpProofInvocationDirectoryParent;_SharpProofInvocationDirectoryIsContained;_SharpProofCompilerManifestPathConfigured;_SharpProofCompilerManifestSourcePath;_SharpProofPublicationTopologyPath;_SharpProofCleanupVerifyDirectory;_SharpProofCleanupRunsDirectory;_SharpProofCleanupInvocationIdIsSafe;_SharpProofCleanupExpectedInvocationDirectory;_SharpProofCleanupInvocationDirectoryFullPath;_SharpProofCleanupInvocationDirectoryIsCanonical;_SharpProofCleanupInvocationDirectoryMatchesExpected;_SharpProofCleanupInvocationDirectoryParent;_SharpProofCleanupInvocationDirectoryIsContained">
  <PropertyGroup>
    <_SharpProofCompilerManifestPathConfigured>$([System.String]::Copy("$(_SharpProofCompilerManifestPath)"))</_SharpProofCompilerManifestPathConfigured>
    <_SharpProofProjectLanguageSupported Condition="'$(MSBuildProjectExtension)' == '.csproj'">true</_SharpProofProjectLanguageSupported>
    <_SharpProofProjectLanguageSupported Condition="'$(MSBuildProjectExtension)' != '.csproj'">false</_SharpProofProjectLanguageSupported>
    <_SharpProofToolsDirectory>$([System.IO.Path]::GetFullPath("$(SharpProofToolsDirectory)"))</_SharpProofToolsDirectory>
    <_SharpProofWorkerPathConfigured>$([System.String]::Copy("$(SharpProofWorkerPath)"))</_SharpProofWorkerPathConfigured>
    <_SharpProofLauncherPathConfigured>$([System.String]::Copy("$(SharpProofLauncherPath)"))</_SharpProofLauncherPathConfigured>
    <SharpProofWorkerPath Condition="$(_SharpProofWorkerPathConfigured) == ''">$(_SharpProofToolsDirectory)/SharpProof.Worker.dll</SharpProofWorkerPath>
    <SharpProofLauncherPath Condition="$(_SharpProofLauncherPathConfigured) == ''">$(_SharpProofToolsDirectory)/SharpProof.Worker.Launcher.dll</SharpProofLauncherPath>
    <_SharpProofWorkerPath>$([System.IO.Path]::GetFullPath("$(SharpProofWorkerPath)"))</_SharpProofWorkerPath>
    <_SharpProofLauncherPath>$([System.IO.Path]::GetFullPath("$(SharpProofLauncherPath)"))</_SharpProofLauncherPath>
    <_SharpProofWorkerProtocolPath>$([System.IO.Path]::Combine("$(_SharpProofToolsDirectory)", 'SharpProof.Worker.Protocol.dll'))</_SharpProofWorkerProtocolPath>
    <_SharpProofWorkerProtocolPath Condition="$(_SharpProofTestWorkerProtocolPath) != ''">$([System.IO.Path]::GetFullPath("$(_SharpProofTestWorkerProtocolPath)"))</_SharpProofWorkerProtocolPath>
    <_SharpProofBuildTasksPath Condition="$(_SharpProofTestBuildTasksPath) != ''">$([System.IO.Path]::GetFullPath("$(_SharpProofTestBuildTasksPath)"))</_SharpProofBuildTasksPath>
    <_SharpProofPackageBuildTasksPath Condition="$(_SharpProofTestBuildTasksPath) != ''">$([System.IO.Path]::GetFullPath("$(_SharpProofTestBuildTasksPath)"))</_SharpProofPackageBuildTasksPath>
  </PropertyGroup>
  <UsingTask TaskName="SharpProof.BuildTasks.InvalidatePublishedResult"
             AssemblyFile="$(_SharpProofBuildTasksPath)" />
  <UsingTask TaskName="SharpProof.BuildTasks.RunVerifier"
             AssemblyFile="$(_SharpProofBuildTasksPath)" />
  <UsingTask TaskName="SharpProof.BuildTasks.ValidatePublishedVerificationResult"
             AssemblyFile="$(_SharpProofBuildTasksPath)" />
  <UsingTask TaskName="SharpProof.BuildTasks.ResetPublishedVerification"
             AssemblyFile="$(_SharpProofBuildTasksPath)" />
  <UsingTask TaskName="SharpProof.BuildTasks.PersistPublishedVerification"
             AssemblyFile="$(_SharpProofBuildTasksPath)" />

  <PropertyGroup>
    <SharpProofVerifyPolicy Condition="'$(SharpProofVerifyPolicy)' == '' AND '$(_SharpProofProfileNormalized)' == 'strict'">require-proven</SharpProofVerifyPolicy>
    <SharpProofVerifyPolicy Condition="'$(SharpProofVerifyPolicy)' == ''">advisory</SharpProofVerifyPolicy>
    <SharpProofAssumptionPolicy Condition="'$(SharpProofAssumptionPolicy)' == '' AND '$(_SharpProofProfileNormalized)' == 'strict'">error</SharpProofAssumptionPolicy>
    <SharpProofAssumptionPolicy Condition="'$(SharpProofAssumptionPolicy)' == ''">allow</SharpProofAssumptionPolicy>
    <_SharpProofVerifyPolicyNormalized>$([System.String]::Copy('$(SharpProofVerifyPolicy)').ToLowerInvariant())</_SharpProofVerifyPolicyNormalized>
    <_SharpProofAssumptionPolicyNormalized>$([System.String]::Copy('$(SharpProofAssumptionPolicy)').ToLowerInvariant())</_SharpProofAssumptionPolicyNormalized>
  </PropertyGroup>

  <Target Name="_SharpProofValidateRuntimeClosure"
          Condition="'$(_SharpProofProjectLanguageSupported)' == 'true' AND '$(SharpProofVerify)' == 'true' AND '$(_SharpProofProfileNormalized)' != 'off' AND '$(_SharpProofVerifierHostSupported)' == 'true' AND '$(DesignTimeBuild)' != 'true' AND '$(BuildingProject)' != 'false'">
    <Error Code="SP0054" Condition="$(_SharpProofToolsDirectory) != $(_SharpProofPackageToolsDirectory) OR $(_SharpProofWorkerPath) != $(_SharpProofPackageWorkerPath) OR $(_SharpProofLauncherPath) != $(_SharpProofPackageLauncherPath) OR $(_SharpProofWorkerProtocolPath) != $(_SharpProofPackageWorkerProtocolPath) OR $(_SharpProofBuildTasksPath) != $(_SharpProofPackageBuildTasksPath)"
           Text="SharpProof verifier runtime paths must resolve to the exact package-owned runtime closure." />
    <Error Code="SP0054" Condition="!Exists($(_SharpProofPackageNativeZ3Path))"
           Text="SharpProof verifier package native payload is missing from its build-tool closure." />
  </Target>

  <Target Name="SharpProofRejectUnsupportedProjectLanguage"
          BeforeTargets="CoreCompile"
          Condition="'$(_SharpProofProjectLanguageSupported)' != 'true' AND '$(SharpProofVerify)' == 'true' AND '$(_SharpProofProfileNormalized)' != 'off' AND '$(DesignTimeBuild)' != 'true' AND '$(BuildingProject)' != 'false'">
    <Error Code="SP0054"
           Text="SharpProof verification supports only C# projects; set SharpProofProfile=off for non-C# projects." />
  </Target>

  <Target Name="_SharpProofRejectSkippedAnalyzers"
          BeforeTargets="CoreCompile"
          Condition="'$(_SharpProofProjectLanguageSupported)' == 'true' AND '$(SharpProofVerify)' == 'true' AND '$(_SharpProofProfileNormalized)' != 'off' AND '$(_SharpProofVerifierHostSupported)' == 'true' AND '$(DesignTimeBuild)' != 'true' AND '$(BuildingProject)' != 'false'">
    <Error Code="SP0054"
           Condition="'$(RunAnalyzers)' == 'false' OR
                      ('$(RunAnalyzers)' == '' AND '$(RunAnalyzersDuringBuild)' == 'false') OR
                      ('$(RunAnalyzers)' == '' AND '$(RunAnalyzersDuringBuild)' == '' AND
                       '$(IsImplicitlyTriggeredBuild)' == 'true' AND
                       '$(UsingMicrosoftNETSdk)' == 'true' AND
                       '$(OptimizeImplicitlyTriggeredBuild)' != 'false' AND
                       ('$(TreatWarningsAsErrors)' != 'true' OR
                        '$(OptimizeImplicitlyTriggeredBuild)' == 'true'))"
           Text="SharpProof verification requires compiler analyzers; RunAnalyzers and RunAnalyzersDuringBuild must remain enabled." />
  </Target>

  <Target Name="_SharpProofInvalidateBeforeDependencies"
          DependsOnTargets="_SharpProofValidateRuntimeClosure"
          BeforeTargets="ResolveReferences"
          Condition="'$(_SharpProofProjectLanguageSupported)' == 'true' AND '$(SharpProofVerify)' == 'true' AND '$(_SharpProofProfileNormalized)' != 'off' AND '$(_SharpProofVerifierHostSupported)' == 'true' AND '$(DesignTimeBuild)' != 'true' AND '$(BuildingProject)' != 'false' AND ('$(TargetFrameworks)' == '' OR '$(TargetFramework)' != '')">
    <PropertyGroup>
      <_SharpProofEarlyVerifyDirectory>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine("$(MSBuildProjectDirectory)", "$(IntermediateOutputPath)SharpProof"))))</_SharpProofEarlyVerifyDirectory>
      <_SharpProofEarlyRequestFile Condition="$(SharpProofVerifyRequestFile) == ''">$([System.IO.Path]::Combine("$(_SharpProofEarlyVerifyDirectory)", 'request.json'))</_SharpProofEarlyRequestFile>
      <_SharpProofEarlyRequestFile Condition="$(SharpProofVerifyRequestFile) != ''">$(SharpProofVerifyRequestFile)</_SharpProofEarlyRequestFile>
      <_SharpProofEarlyResultFile Condition="$(SharpProofVerifyResultFile) == ''">$([System.IO.Path]::Combine("$(_SharpProofEarlyVerifyDirectory)", 'result.json'))</_SharpProofEarlyResultFile>
      <_SharpProofEarlyResultFile Condition="$(SharpProofVerifyResultFile) != ''">$(SharpProofVerifyResultFile)</_SharpProofEarlyResultFile>
      <_SharpProofEarlyManifestFile Condition="$(SharpProofCompilerManifestFile) == ''">$([System.IO.Path]::Combine("$(_SharpProofEarlyVerifyDirectory)", 'compiler-manifest.json'))</_SharpProofEarlyManifestFile>
      <_SharpProofEarlyManifestFile Condition="$(SharpProofCompilerManifestFile) != ''">$(SharpProofCompilerManifestFile)</_SharpProofEarlyManifestFile>
      <_SharpProofEarlyConfiguredRequestFullPath Condition="$(SharpProofVerifyRequestFile) != '' AND $(TargetFrameworks) != ''">$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine("$(MSBuildProjectDirectory)", "$(SharpProofVerifyRequestFile)"))))</_SharpProofEarlyConfiguredRequestFullPath>
      <_SharpProofEarlyConfiguredResultFullPath Condition="$(SharpProofVerifyResultFile) != '' AND $(TargetFrameworks) != ''">$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine("$(MSBuildProjectDirectory)", "$(SharpProofVerifyResultFile)"))))</_SharpProofEarlyConfiguredResultFullPath>
      <_SharpProofEarlyConfiguredManifestFullPath Condition="$(SharpProofCompilerManifestFile) != '' AND $(TargetFrameworks) != ''">$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine("$(MSBuildProjectDirectory)", "$(SharpProofCompilerManifestFile)"))))</_SharpProofEarlyConfiguredManifestFullPath>
      <_SharpProofEarlyRequestFile Condition="$(SharpProofVerifyRequestFile) != '' AND $(TargetFrameworks) != ''">$([System.IO.Path]::Combine($([System.IO.Path]::GetDirectoryName("$(_SharpProofEarlyConfiguredRequestFullPath)")), '$(TargetFramework)', $([System.IO.Path]::GetFileName("$(_SharpProofEarlyConfiguredRequestFullPath)"))))</_SharpProofEarlyRequestFile>
      <_SharpProofEarlyResultFile Condition="$(SharpProofVerifyResultFile) != '' AND $(TargetFrameworks) != ''">$([System.IO.Path]::Combine($([System.IO.Path]::GetDirectoryName("$(_SharpProofEarlyConfiguredResultFullPath)")), '$(TargetFramework)', $([System.IO.Path]::GetFileName("$(_SharpProofEarlyConfiguredResultFullPath)"))))</_SharpProofEarlyResultFile>
      <_SharpProofEarlyManifestFile Condition="$(SharpProofCompilerManifestFile) != '' AND $(TargetFrameworks) != ''">$([System.IO.Path]::Combine($([System.IO.Path]::GetDirectoryName("$(_SharpProofEarlyConfiguredManifestFullPath)")), '$(TargetFramework)', $([System.IO.Path]::GetFileName("$(_SharpProofEarlyConfiguredManifestFullPath)"))))</_SharpProofEarlyManifestFile>
      <_SharpProofEarlyCompilerManifestSourceFile Condition="$(_SharpProofCompilerManifestPathConfigured) == ''">$([System.IO.Path]::Combine("$(_SharpProofEarlyVerifyDirectory)", 'compiler-manifest.input.json'))</_SharpProofEarlyCompilerManifestSourceFile>
      <_SharpProofEarlyCompilerManifestSourceFile Condition="$(_SharpProofCompilerManifestPathConfigured) != ''">$(_SharpProofCompilerManifestPathConfigured)</_SharpProofEarlyCompilerManifestSourceFile>
      <_SharpProofEarlyEffectiveSarifFile>$(SharpProofVerifySarifFile)</_SharpProofEarlyEffectiveSarifFile>
      <_SharpProofEarlyConfiguredSarifFullPath Condition="$(SharpProofVerifySarifFile) != '' AND $(TargetFrameworks) != ''">$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine("$(MSBuildProjectDirectory)", "$(SharpProofVerifySarifFile)"))))</_SharpProofEarlyConfiguredSarifFullPath>
      <_SharpProofEarlyEffectiveSarifFile Condition="$(SharpProofVerifySarifFile) != '' AND $(TargetFrameworks) != ''">$([System.IO.Path]::Combine($([System.IO.Path]::GetDirectoryName("$(_SharpProofEarlyConfiguredSarifFullPath)")), '$(TargetFramework)', $([System.IO.Path]::GetFileName("$(_SharpProofEarlyConfiguredSarifFullPath)"))))</_SharpProofEarlyEffectiveSarifFile>
      <_SharpProofEarlyVerifyCacheDirectoryNormalized>$([System.String]::Copy("$(SharpProofVerifyCacheDirectory)").Trim())</_SharpProofEarlyVerifyCacheDirectoryNormalized>
      <_SharpProofEarlyEffectiveCacheDirectory Condition="$(_SharpProofEarlyVerifyCacheDirectoryNormalized) == ''">$([System.IO.Path]::Combine("$(_SharpProofEarlyVerifyDirectory)", 'cache'))</_SharpProofEarlyEffectiveCacheDirectory>
      <_SharpProofEarlyEffectiveCacheDirectory Condition="$(_SharpProofEarlyVerifyCacheDirectoryNormalized) != ''">$(SharpProofVerifyCacheDirectory)</_SharpProofEarlyEffectiveCacheDirectory>
      <_SharpProofEarlyVerifyCacheEnabledNormalized>$([System.String]::Copy('$(SharpProofVerifyCacheEnabled)').Trim().ToLowerInvariant())</_SharpProofEarlyVerifyCacheEnabledNormalized>
      <_SharpProofEarlyActiveCacheDirectory Condition="'$(_SharpProofEarlyVerifyCacheEnabledNormalized)' == 'true'">$(_SharpProofEarlyEffectiveCacheDirectory)</_SharpProofEarlyActiveCacheDirectory>
    </PropertyGroup>
    <ItemGroup>
      <_SharpProofEarlyCompilerOwnedOutput Remove="@(_SharpProofEarlyCompilerOwnedOutput)" />
      <_SharpProofEarlyCompilerOwnedOutput Include="$(TargetPath)" Condition="'$(TargetPath)' != ''" />
      <_SharpProofEarlyCompilerOwnedOutput Include="@(IntermediateAssembly)" />
      <_SharpProofEarlyCompilerOwnedOutput Include="$(DocumentationFile)" Condition="'$(DocumentationFile)' != ''" />
      <_SharpProofEarlyCompilerOwnedOutput Include="$(IntermediateOutputPath)$(TargetName).pdb" Condition="'$(TargetName)' != ''" />
      <_SharpProofEarlyCompilerOwnedOutput Include="$([System.IO.Path]::ChangeExtension(&quot;$(TargetPath)&quot;, '.pdb'))" Condition="'$(TargetPath)' != ''" />
      <_SharpProofEarlyCompilerOwnedOutput Include="$(IntermediateRefAssembly)" Condition="'$(IntermediateRefAssembly)' != ''" />
      <_SharpProofEarlyCompilerOwnedOutput Include="$(IntermediateOutputPath)ref/$(TargetName)$(TargetExt)" />
      <_SharpProofEarlyCompilerOwnedOutput Include="$(IntermediateOutputPath)refint/$(TargetName)$(TargetExt)" />
      <_SharpProofEarlyCompilerOwnedOutput Include="$(GeneratedAssemblyInfoFile)" Condition="'$(GeneratedAssemblyInfoFile)' != ''" />
      <_SharpProofEarlyCompilerOwnedOutput Include="$(IntermediateOutputPath)$(MSBuildProjectName).AssemblyInfo.cs" />
      <_SharpProofEarlyCompilerOwnedOutput Include="$(GeneratedGlobalUsingsFile)" Condition="'$(GeneratedGlobalUsingsFile)' != ''" />
      <_SharpProofEarlyCompilerOwnedOutput Include="$(IntermediateOutputPath)$(MSBuildProjectName).GlobalUsings.g.cs" />
      <_SharpProofEarlyCompilerOwnedOutput Include="$(GeneratedMSBuildEditorConfigFile)" Condition="'$(GeneratedMSBuildEditorConfigFile)' != ''" />
      <_SharpProofEarlyCompilerOwnedOutput Include="$(IntermediateOutputPath)$(MSBuildProjectName).GeneratedMSBuildEditorConfig.editorconfig" />
      <_SharpProofEarlyCompilerOwnedOutput Include="$(_SharpProofEarlyCompilerManifestSourceFile)" />
      <_SharpProofEarlyCompilerOwnedOutput Include="$(ProjectDepsFilePath)" Condition="'$(ProjectDepsFilePath)' != ''" />
      <_SharpProofEarlyCompilerOwnedOutput Include="$(ProjectRuntimeConfigFilePath)" Condition="'$(ProjectRuntimeConfigFilePath)' != ''" />
      <_SharpProofEarlyCompilerOwnedOutput Include="$(ProjectRuntimeConfigDevFilePath)" Condition="'$(ProjectRuntimeConfigDevFilePath)' != ''" />
    </ItemGroup>
    <SharpProof.BuildTasks.InvalidatePublishedResult
        ResultPath="$(_SharpProofEarlyResultFile)"
        ProjectDirectory="$(MSBuildProjectDirectory)"
        RequestPath="$(_SharpProofEarlyRequestFile)"
        ManifestPath="$(_SharpProofEarlyManifestFile)"
        SarifPath="$(_SharpProofEarlyEffectiveSarifFile)"
        WorkerPath="$(_SharpProofWorkerPath)"
        LauncherPath="$(_SharpProofLauncherPath)"
        WorkerProtocolPath="$(_SharpProofWorkerProtocolPath)"
        CompilerOutputPaths="@(_SharpProofEarlyCompilerOwnedOutput)"
        CachePath="$(_SharpProofEarlyActiveCacheDirectory)" />
    <Error Code="SP0054"
           Condition="'$(SkipCompilerExecution)' == 'true' AND '$(DesignTimeBuild)' != 'true'"
           Text="SharpProof verification cannot run when SkipCompilerExecution=true; compiler execution is required to produce current evidence." />
  </Target>

  <Target Name="_SharpProofInitializeVerify"
          DependsOnTargets="_SharpProofValidateRuntimeClosure"
          BeforeTargets="GenerateMSBuildEditorConfigFileShouldRun;GenerateMSBuildEditorConfigFile"
          Condition="'$(_SharpProofProjectLanguageSupported)' == 'true'">
    <PropertyGroup>
      <_SharpProofConfiguredRequestFile>$([System.String]::Copy("$(SharpProofVerifyRequestFile)"))</_SharpProofConfiguredRequestFile>
      <_SharpProofConfiguredResultFile>$([System.String]::Copy("$(SharpProofVerifyResultFile)"))</_SharpProofConfiguredResultFile>
      <_SharpProofConfiguredManifestFile>$([System.String]::Copy("$(SharpProofCompilerManifestFile)"))</_SharpProofConfiguredManifestFile>
      <_SharpProofVerifyDirectory>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine("$(MSBuildProjectDirectory)", "$(IntermediateOutputPath)SharpProof"))))</_SharpProofVerifyDirectory>
      <_SharpProofPublicationTopologyPath>$([System.IO.Path]::Combine("$(_SharpProofVerifyDirectory)", 'publication-topology.json'))</_SharpProofPublicationTopologyPath>
      <SharpProofVerifyRequestFile Condition="$(SharpProofVerifyRequestFile) == ''">$([System.IO.Path]::Combine("$(_SharpProofVerifyDirectory)", 'request.json'))</SharpProofVerifyRequestFile>
      <SharpProofVerifyResultFile Condition="$(SharpProofVerifyResultFile) == ''">$([System.IO.Path]::Combine("$(_SharpProofVerifyDirectory)", 'result.json'))</SharpProofVerifyResultFile>
      <SharpProofCompilerManifestFile Condition="$(SharpProofCompilerManifestFile) == ''">$([System.IO.Path]::Combine("$(_SharpProofVerifyDirectory)", 'compiler-manifest.json'))</SharpProofCompilerManifestFile>
      <_SharpProofEffectiveRequestFile>$(SharpProofVerifyRequestFile)</_SharpProofEffectiveRequestFile>
      <_SharpProofEffectiveResultFile>$(SharpProofVerifyResultFile)</_SharpProofEffectiveResultFile>
      <_SharpProofEffectiveManifestFile>$(SharpProofCompilerManifestFile)</_SharpProofEffectiveManifestFile>
      <_SharpProofConfiguredRequestFullPath Condition="$(_SharpProofConfiguredRequestFile) != '' AND $(TargetFrameworks) != ''">$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine("$(MSBuildProjectDirectory)", "$(_SharpProofConfiguredRequestFile)"))))</_SharpProofConfiguredRequestFullPath>
      <_SharpProofConfiguredResultFullPath Condition="$(_SharpProofConfiguredResultFile) != '' AND $(TargetFrameworks) != ''">$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine("$(MSBuildProjectDirectory)", "$(_SharpProofConfiguredResultFile)"))))</_SharpProofConfiguredResultFullPath>
      <_SharpProofConfiguredManifestFullPath Condition="$(_SharpProofConfiguredManifestFile) != '' AND $(TargetFrameworks) != ''">$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine("$(MSBuildProjectDirectory)", "$(_SharpProofConfiguredManifestFile)"))))</_SharpProofConfiguredManifestFullPath>
      <_SharpProofEffectiveRequestFile Condition="$(_SharpProofConfiguredRequestFile) != '' AND $(TargetFrameworks) != ''">$([System.IO.Path]::Combine($([System.IO.Path]::GetDirectoryName("$(_SharpProofConfiguredRequestFullPath)")), '$(TargetFramework)', $([System.IO.Path]::GetFileName("$(_SharpProofConfiguredRequestFullPath)"))))</_SharpProofEffectiveRequestFile>
      <_SharpProofEffectiveResultFile Condition="$(_SharpProofConfiguredResultFile) != '' AND $(TargetFrameworks) != ''">$([System.IO.Path]::Combine($([System.IO.Path]::GetDirectoryName("$(_SharpProofConfiguredResultFullPath)")), '$(TargetFramework)', $([System.IO.Path]::GetFileName("$(_SharpProofConfiguredResultFullPath)"))))</_SharpProofEffectiveResultFile>
      <_SharpProofEffectiveManifestFile Condition="$(_SharpProofConfiguredManifestFile) != '' AND $(TargetFrameworks) != ''">$([System.IO.Path]::Combine($([System.IO.Path]::GetDirectoryName("$(_SharpProofConfiguredManifestFullPath)")), '$(TargetFramework)', $([System.IO.Path]::GetFileName("$(_SharpProofConfiguredManifestFullPath)"))))</_SharpProofEffectiveManifestFile>
      <_SharpProofEffectiveSarifFile>$(SharpProofVerifySarifFile)</_SharpProofEffectiveSarifFile>
      <_SharpProofConfiguredSarifFullPath Condition="$(SharpProofVerifySarifFile) != '' AND $(TargetFrameworks) != ''">$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine("$(MSBuildProjectDirectory)", "$(SharpProofVerifySarifFile)"))))</_SharpProofConfiguredSarifFullPath>
      <_SharpProofEffectiveSarifFile Condition="$(SharpProofVerifySarifFile) != '' AND $(TargetFrameworks) != ''">$([System.IO.Path]::Combine($([System.IO.Path]::GetDirectoryName("$(_SharpProofConfiguredSarifFullPath)")), '$(TargetFramework)', $([System.IO.Path]::GetFileName("$(_SharpProofConfiguredSarifFullPath)"))))</_SharpProofEffectiveSarifFile>
      <_SharpProofVerifyCacheDirectoryNormalized>$([System.String]::Copy("$(SharpProofVerifyCacheDirectory)").Trim())</_SharpProofVerifyCacheDirectoryNormalized>
      <_SharpProofVerifyCacheEnabledNormalized>$([System.String]::Copy('$(SharpProofVerifyCacheEnabled)').Trim().ToLowerInvariant())</_SharpProofVerifyCacheEnabledNormalized>
      <_SharpProofEffectiveCacheDirectory Condition="$(_SharpProofVerifyCacheDirectoryNormalized) == ''">$([System.IO.Path]::Combine("$(_SharpProofVerifyDirectory)", 'cache'))</_SharpProofEffectiveCacheDirectory>
      <_SharpProofEffectiveCacheDirectory Condition="$(_SharpProofVerifyCacheDirectoryNormalized) != ''">$(SharpProofVerifyCacheDirectory)</_SharpProofEffectiveCacheDirectory>
      <_SharpProofActiveCacheDirectory Condition="'$(_SharpProofVerifyCacheEnabledNormalized)' == 'true'">$(_SharpProofEffectiveCacheDirectory)</_SharpProofActiveCacheDirectory>
      <_SharpProofInvocationRunsDirectory>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine("$(_SharpProofVerifyDirectory)", 'runs'))))</_SharpProofInvocationRunsDirectory>
      <_SharpProofInvocationId Condition="'$(_SharpProofInvocationId)' == ''">$([System.Guid]::NewGuid().ToString('N'))</_SharpProofInvocationId>
      <_SharpProofInvocationIdIsSafe>$([System.Text.RegularExpressions.Regex]::IsMatch('$(_SharpProofInvocationId)', '\A[0-9a-f]{32}\z'))</_SharpProofInvocationIdIsSafe>
      <_SharpProofExpectedInvocationDirectory>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine("$(_SharpProofInvocationRunsDirectory)", "$(_SharpProofInvocationId)"))))</_SharpProofExpectedInvocationDirectory>
      <_SharpProofInvocationDirectory>$(_SharpProofExpectedInvocationDirectory)</_SharpProofInvocationDirectory>
      <_SharpProofInvocationDirectoryFullPath>$([System.IO.Path]::GetFullPath("$(_SharpProofInvocationDirectory)"))</_SharpProofInvocationDirectoryFullPath>
      <_SharpProofInvocationDirectoryIsCanonical>$([System.String]::Equals("$(_SharpProofInvocationDirectory)", "$(_SharpProofInvocationDirectoryFullPath)", System.StringComparison.Ordinal))</_SharpProofInvocationDirectoryIsCanonical>
      <_SharpProofInvocationDirectoryMatchesExpected>$([System.String]::Equals("$(_SharpProofInvocationDirectoryFullPath)", "$(_SharpProofExpectedInvocationDirectory)", System.StringComparison.Ordinal))</_SharpProofInvocationDirectoryMatchesExpected>
      <_SharpProofInvocationDirectoryParent>$([System.IO.Path]::GetDirectoryName("$(_SharpProofInvocationDirectoryFullPath)"))</_SharpProofInvocationDirectoryParent>
      <_SharpProofInvocationDirectoryIsContained>$([System.String]::Equals("$(_SharpProofInvocationDirectoryParent)", "$(_SharpProofInvocationRunsDirectory)", System.StringComparison.Ordinal))</_SharpProofInvocationDirectoryIsContained>
      <_SharpProofInvocationRequestFile>$([System.IO.Path]::Combine("$(_SharpProofInvocationDirectory)", 'request.json'))</_SharpProofInvocationRequestFile>
      <_SharpProofInvocationResultFile>$([System.IO.Path]::Combine("$(_SharpProofInvocationDirectory)", 'result.json'))</_SharpProofInvocationResultFile>
      <_SharpProofCompilerManifestSourcePath Condition="$(_SharpProofCompilerManifestPathConfigured) == ''">$([System.IO.Path]::Combine("$(_SharpProofVerifyDirectory)", 'compiler-manifest.input.json'))</_SharpProofCompilerManifestSourcePath>
      <_SharpProofCompilerManifestSourcePath Condition="$(_SharpProofCompilerManifestPathConfigured) != ''">$(_SharpProofCompilerManifestPathConfigured)</_SharpProofCompilerManifestSourcePath>
    </PropertyGroup>
    <Error Code="SP0054" Condition="'$(_SharpProofInvocationIdIsSafe)' != 'True'"
           Text="SharpProof invocation ID must be an exact safe identifier of 32 lowercase hexadecimal characters." />
    <Error Code="SP0054" Condition="'$(_SharpProofInvocationDirectoryIsCanonical)' != 'True' OR '$(_SharpProofInvocationDirectoryMatchesExpected)' != 'True' OR '$(_SharpProofInvocationDirectoryIsContained)' != 'True'"
           Text="SharpProof invocation directory must resolve canonically to a direct child of the package-owned runs directory." />
    <PropertyGroup Condition="'$(SharpProofVerify)' == 'true' AND '$(_SharpProofProfileNormalized)' != 'off' AND '$(_SharpProofVerifierHostSupported)' == 'true' AND '$(DesignTimeBuild)' != 'true' AND '$(BuildingProject)' != 'false'">
      <_SharpProofCompilationTargetFramework>$(TargetFramework)</_SharpProofCompilationTargetFramework>
      <_SharpProofCompilerManifestPath Condition="$(_SharpProofCompilerManifestPathConfigured) == ''">$([System.IO.Path]::Combine("$(_SharpProofInvocationDirectory)", 'compiler-manifest.json'))</_SharpProofCompilerManifestPath>
      <_SharpProofProjectDirectory>$(MSBuildProjectDirectory)</_SharpProofProjectDirectory>
    </PropertyGroup>
    <ItemGroup Condition="'$(SharpProofVerify)' == 'true' AND '$(_SharpProofProfileNormalized)' != 'off' AND '$(_SharpProofVerifierHostSupported)' == 'true' AND '$(DesignTimeBuild)' != 'true' AND '$(BuildingProject)' != 'false'">
      <_SharpProofCompilerOwnedOutput Remove="@(_SharpProofCompilerOwnedOutput)" />
      <_SharpProofCompilerOwnedOutput Include="$(TargetPath)" Condition="'$(TargetPath)' != ''" />
      <_SharpProofCompilerOwnedOutput Include="@(IntermediateAssembly)" />
      <_SharpProofCompilerOwnedOutput Include="$(DocumentationFile)" Condition="'$(DocumentationFile)' != ''" />
      <_SharpProofCompilerOwnedOutput Include="$(PdbFile)" Condition="'$(PdbFile)' != ''" />
      <_SharpProofCompilerOwnedOutput Include="$(_DebugSymbolsIntermediatePath)" Condition="'$(_DebugSymbolsIntermediatePath)' != ''" />
      <_SharpProofCompilerOwnedOutput Include="$(IntermediateOutputPath)$(TargetName).pdb" Condition="'$(TargetName)' != ''" />
      <_SharpProofCompilerOwnedOutput Include="$([System.IO.Path]::ChangeExtension(&quot;$(TargetPath)&quot;, '.pdb'))" Condition="$(TargetPath) != ''" />
      <_SharpProofCompilerOwnedOutput Include="$(IntermediateRefAssembly)" Condition="'$(IntermediateRefAssembly)' != ''" />
      <_SharpProofCompilerOwnedOutput Include="$(IntermediateOutputPath)ref/$(TargetName)$(TargetExt)" />
      <_SharpProofCompilerOwnedOutput Include="$(IntermediateOutputPath)refint/$(TargetName)$(TargetExt)" />
      <_SharpProofCompilerOwnedOutput Include="$(GeneratedAssemblyInfoFile)" Condition="'$(GeneratedAssemblyInfoFile)' != ''" />
      <_SharpProofCompilerOwnedOutput Include="$(IntermediateOutputPath)$(MSBuildProjectName).AssemblyInfo.cs" />
      <_SharpProofCompilerOwnedOutput Include="$(GeneratedGlobalUsingsFile)" Condition="'$(GeneratedGlobalUsingsFile)' != ''" />
      <_SharpProofCompilerOwnedOutput Include="$(IntermediateOutputPath)$(MSBuildProjectName).GlobalUsings.g.cs" />
      <_SharpProofCompilerOwnedOutput Include="$(GeneratedMSBuildEditorConfigFile)" Condition="'$(GeneratedMSBuildEditorConfigFile)' != ''" />
      <_SharpProofCompilerOwnedOutput Include="$(IntermediateOutputPath)$(MSBuildProjectName).GeneratedMSBuildEditorConfig.editorconfig" />
      <_SharpProofCompilerOwnedOutput Include="$(_SharpProofCompilerManifestSourcePath)" />
      <_SharpProofCompilerOwnedOutput Include="$(ProjectDepsFilePath)" Condition="'$(ProjectDepsFilePath)' != ''" />
      <_SharpProofCompilerOwnedOutput Include="$(ProjectRuntimeConfigFilePath)" Condition="'$(ProjectRuntimeConfigFilePath)' != ''" />
      <_SharpProofCompilerOwnedOutput Include="$(ProjectRuntimeConfigDevFilePath)" Condition="'$(ProjectRuntimeConfigDevFilePath)' != ''" />
      <CustomAdditionalCompileOutputs Include="$(_SharpProofCompilerManifestSourcePath)" />
      <FileWrites Include="$(_SharpProofCompilerManifestSourcePath)" />
      <FileWrites Include="$(_SharpProofPublicationTopologyPath)" />
    </ItemGroup>
    <SharpProof.BuildTasks.InvalidatePublishedResult
        Condition="'$(_SharpProofVerifierHostSupported)' == 'true' AND '$(DesignTimeBuild)' != 'true' AND '$(BuildingProject)' != 'false'"
        ResultPath="$(_SharpProofEffectiveResultFile)"
        ProjectDirectory="$(MSBuildProjectDirectory)"
        RequestPath="$(_SharpProofEffectiveRequestFile)"
        ManifestPath="$(_SharpProofEffectiveManifestFile)"
        SarifPath="$(_SharpProofEffectiveSarifFile)"
        InvocationRequestPath="$(_SharpProofInvocationRequestFile)"
        InvocationResultPath="$(_SharpProofInvocationResultFile)"
        InvocationManifestPath="$(_SharpProofCompilerManifestPath)"
        CompilerManifestSourcePath="$(_SharpProofCompilerManifestSourcePath)"
        WorkerPath="$(_SharpProofWorkerPath)"
        LauncherPath="$(_SharpProofLauncherPath)"
        WorkerProtocolPath="$(_SharpProofWorkerProtocolPath)"
        CompilerOutputPaths="@(_SharpProofCompilerOwnedOutput)"
        CachePath="$(_SharpProofActiveCacheDirectory)" />
    <OnError ExecuteTargets="_SharpProofCleanupInvocation" />
  </Target>

  <Target Name="_SharpProofCleanupInvocation"
          Condition="'$(_SharpProofInvocationId)' != ''">
    <PropertyGroup>
      <_SharpProofCleanupVerifyDirectory>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine("$(MSBuildProjectDirectory)", "$(IntermediateOutputPath)SharpProof"))))</_SharpProofCleanupVerifyDirectory>
      <_SharpProofCleanupRunsDirectory>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine("$(_SharpProofCleanupVerifyDirectory)", 'runs'))))</_SharpProofCleanupRunsDirectory>
      <_SharpProofCleanupInvocationIdIsSafe>$([System.Text.RegularExpressions.Regex]::IsMatch('$(_SharpProofInvocationId)', '\A[0-9a-f]{32}\z'))</_SharpProofCleanupInvocationIdIsSafe>
      <_SharpProofCleanupExpectedInvocationDirectory>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine("$(_SharpProofCleanupRunsDirectory)", "$(_SharpProofInvocationId)"))))</_SharpProofCleanupExpectedInvocationDirectory>
      <_SharpProofInvocationDirectory Condition="$(_SharpProofInvocationDirectory) == ''">$(_SharpProofCleanupExpectedInvocationDirectory)</_SharpProofInvocationDirectory>
      <_SharpProofCleanupInvocationDirectoryFullPath>$([System.IO.Path]::GetFullPath("$(_SharpProofInvocationDirectory)"))</_SharpProofCleanupInvocationDirectoryFullPath>
      <_SharpProofCleanupInvocationDirectoryIsCanonical>$([System.String]::Equals("$(_SharpProofInvocationDirectory)", "$(_SharpProofCleanupInvocationDirectoryFullPath)", System.StringComparison.Ordinal))</_SharpProofCleanupInvocationDirectoryIsCanonical>
      <_SharpProofCleanupInvocationDirectoryMatchesExpected>$([System.String]::Equals("$(_SharpProofCleanupInvocationDirectoryFullPath)", "$(_SharpProofCleanupExpectedInvocationDirectory)", System.StringComparison.Ordinal))</_SharpProofCleanupInvocationDirectoryMatchesExpected>
      <_SharpProofCleanupInvocationDirectoryParent>$([System.IO.Path]::GetDirectoryName("$(_SharpProofCleanupInvocationDirectoryFullPath)"))</_SharpProofCleanupInvocationDirectoryParent>
      <_SharpProofCleanupInvocationDirectoryIsContained>$([System.String]::Equals("$(_SharpProofCleanupInvocationDirectoryParent)", "$(_SharpProofCleanupRunsDirectory)", System.StringComparison.Ordinal))</_SharpProofCleanupInvocationDirectoryIsContained>
    </PropertyGroup>
    <Error Code="SP0054" Condition="'$(_SharpProofCleanupInvocationIdIsSafe)' != 'True'"
           Text="SharpProof invocation ID must be an exact safe identifier of 32 lowercase hexadecimal characters." />
    <Error Code="SP0054" Condition="'$(_SharpProofCleanupInvocationDirectoryIsCanonical)' != 'True' OR '$(_SharpProofCleanupInvocationDirectoryMatchesExpected)' != 'True' OR '$(_SharpProofCleanupInvocationDirectoryIsContained)' != 'True'"
           Text="SharpProof invocation cleanup directory must resolve canonically to a direct child of the package-owned runs directory." />
    <RemoveDir Directories="$(_SharpProofCleanupInvocationDirectoryFullPath)" />
  </Target>

  <Target Name="_SharpProofVerifyCore"
          DependsOnTargets="_SharpProofInitializeVerify;ResolveReferences"
          Condition="'$(_SharpProofProjectLanguageSupported)' == 'true'">
    <Error Code="SP0054" Condition="'$(_SharpProofVerifierHostSupported)' != 'true'"
           Text="SharpProof verification is supported only by Core MSBuild inside the canonical Linux amd64 container. Portable analyzer profiles remain available on this host." />
    <Error Code="SP0054" Condition="'$(_SharpProofVerifyPolicyNormalized)' != 'advisory' AND '$(_SharpProofVerifyPolicyNormalized)' != 'warn-on-unknown' AND '$(_SharpProofVerifyPolicyNormalized)' != 'require-proven'"
           Text="SharpProofVerifyPolicy must be advisory, warn-on-unknown, or require-proven." />
    <Error Code="SP0054" Condition="'$(_SharpProofAssumptionPolicyNormalized)' != 'allow' AND '$(_SharpProofAssumptionPolicyNormalized)' != 'warn' AND '$(_SharpProofAssumptionPolicyNormalized)' != 'error'"
           Text="SharpProofAssumptionPolicy must be allow, warn, or error." />
     <Error Code="SP0049"
            Condition="!Exists($(_SharpProofCompilerManifestSourcePath))"
           Text="SharpProof did not receive the required final compiler manifest." />
    <Error Code="SP0054" Condition="!Exists($(_SharpProofLauncherPath))"
           Text="SharpProof verifier launcher was not found at '$(_SharpProofLauncherPath)'." />
    <Error Code="SP0054" Condition="!Exists($(_SharpProofWorkerPath))"
           Text="SharpProof verifier worker was not found at '$(_SharpProofWorkerPath)'." />
     <MakeDir Directories="$([MSBuild]::Escape(&quot;$(_SharpProofInvocationDirectory)&quot;))" />
     <Copy Condition="'$(_SharpProofCompilerManifestSourcePath)' != '$(_SharpProofCompilerManifestPath)'"
           SourceFiles="$(_SharpProofCompilerManifestSourcePath)"
           DestinationFiles="$(_SharpProofCompilerManifestPath)"
           SkipUnchangedFiles="true" />
    <ItemGroup>
      <_SharpProofVerifierArgument Remove="@(_SharpProofVerifierArgument)" />
      <_SharpProofVerifierArgument Include="$([MSBuild]::Escape(&quot;$(_SharpProofLauncherPath)&quot;))" />
      <_SharpProofVerifierArgument Include="verify" />
      <_SharpProofVerifierArgument Include="--worker" />
      <_SharpProofVerifierArgument Include="$([MSBuild]::Escape(&quot;$(_SharpProofWorkerPath)&quot;))" />
      <_SharpProofVerifierArgument Include="--request" />
      <_SharpProofVerifierArgument Include="$([MSBuild]::Escape(&quot;$(_SharpProofInvocationRequestFile)&quot;))" />
      <_SharpProofVerifierArgument Include="--result" />
      <_SharpProofVerifierArgument Include="$([MSBuild]::Escape(&quot;$(_SharpProofInvocationResultFile)&quot;))" />
      <_SharpProofVerifierArgument Include="--publish-request" />
      <_SharpProofVerifierArgument Include="$([MSBuild]::Escape(&quot;$(_SharpProofEffectiveRequestFile)&quot;))" />
      <_SharpProofVerifierArgument Include="--publish-result" />
      <_SharpProofVerifierArgument Include="$([MSBuild]::Escape(&quot;$(_SharpProofEffectiveResultFile)&quot;))" />
      <_SharpProofVerifierArgument Include="--compiler-manifest" />
      <_SharpProofVerifierArgument Include="$([MSBuild]::Escape(&quot;$(_SharpProofCompilerManifestPath)&quot;))" />
      <_SharpProofVerifierArgument Include="--publish-compiler-manifest" />
      <_SharpProofVerifierArgument Include="$([MSBuild]::Escape(&quot;$(_SharpProofEffectiveManifestFile)&quot;))" />
      <_SharpProofVerifierArgument Include="--verify-policy" />
      <_SharpProofVerifierArgument Include="$(_SharpProofVerifyPolicyNormalized)" />
      <_SharpProofVerifierArgument Include="--assumption-policy" />
      <_SharpProofVerifierArgument Include="$(_SharpProofAssumptionPolicyNormalized)" />
      <_SharpProofVerifierArgument Include="--query-rlimit" />
      <_SharpProofVerifierArgument Include="$(SharpProofVerifyQueryRlimit)" />
      <_SharpProofVerifierArgument Include="--method-rlimit" />
      <_SharpProofVerifierArgument Include="$(SharpProofVerifyMethodRlimit)" />
      <_SharpProofVerifierArgument Include="--method-wall-ms" />
      <_SharpProofVerifierArgument Include="$(SharpProofVerifyMethodWallTimeMilliseconds)" />
      <_SharpProofVerifierArgument Include="--project-wall-ms" />
      <_SharpProofVerifierArgument Include="$(SharpProofVerifyProjectWallTimeMilliseconds)" />
      <_SharpProofVerifierArgument Include="--max-parallelism" />
      <_SharpProofVerifierArgument Include="$(SharpProofVerifyMaxParallelism)" />
      <_SharpProofVerifierArgument Include="--max-expression-depth" />
      <_SharpProofVerifierArgument Include="$(SharpProofVerifyMaximumExpressionDepth)" />
      <_SharpProofVerifierArgument Include="--termination-grace-ms" />
      <_SharpProofVerifierArgument Include="$(SharpProofVerifyTerminationGraceMilliseconds)" />
      <_SharpProofVerifierArgument Include="--cache-enabled" />
      <_SharpProofVerifierArgument Include="$(SharpProofVerifyCacheEnabled)" />
      <_SharpProofVerifierArgument Include="--cache-directory" />
      <_SharpProofVerifierArgument Include="$([MSBuild]::Escape(&quot;$(_SharpProofEffectiveCacheDirectory)&quot;))" />
      <_SharpProofVerifierArgument Include="--cache-maximum-bytes" />
      <_SharpProofVerifierArgument Include="$(SharpProofVerifyCacheMaximumBytes)" />
      <_SharpProofVerifierArgument Include="--publish-sarif"
                                   Condition="$(_SharpProofEffectiveSarifFile) != ''" />
      <_SharpProofVerifierArgument Include="$([MSBuild]::Escape(&quot;$(_SharpProofEffectiveSarifFile)&quot;))"
                                   Condition="$(_SharpProofEffectiveSarifFile) != ''" />
    </ItemGroup>
    <SharpProof.BuildTasks.RunVerifier
        Executable="$(_SharpProofDotNetHost)"
        Arguments="@(_SharpProofVerifierArgument)"
        WorkingDirectory="$(MSBuildProjectDirectory)"
        ProjectWallTimeMilliseconds="$(SharpProofVerifyProjectWallTimeMilliseconds)"
        TerminationGraceMilliseconds="$(SharpProofVerifyTerminationGraceMilliseconds)">
      <Output TaskParameter="ExitCode"
              PropertyName="_SharpProofVerifierExitCode" />
      <Output TaskParameter="HasStructuredError"
              PropertyName="_SharpProofVerifierHasStructuredError" />
    </SharpProof.BuildTasks.RunVerifier>
    <Error Code="SP0051" Condition="'$(_SharpProofVerifierExitCode)' != '0' AND '$(_SharpProofVerifierHasStructuredError)' != 'true'"
           Text="SharpProof verifier failed with exit code $(_SharpProofVerifierExitCode)." />
    <SharpProof.BuildTasks.ValidatePublishedVerificationResult
        RequestPath="$(_SharpProofEffectiveRequestFile)"
        ResultPath="$(_SharpProofEffectiveResultFile)"
        ManifestPath="$(_SharpProofEffectiveManifestFile)"
        ProjectDirectory="$(MSBuildProjectDirectory)"
        InvocationResultPath="$(_SharpProofInvocationResultFile)"
        SarifPath="$(_SharpProofEffectiveSarifFile)" />
    <SharpProof.BuildTasks.PersistPublishedVerification
        MetadataPath="$(_SharpProofPublicationTopologyPath)"
        ProjectDirectory="$(MSBuildProjectDirectory)"
        RequestPath="$(_SharpProofEffectiveRequestFile)"
        ResultPath="$(_SharpProofEffectiveResultFile)"
        ManifestPath="$(_SharpProofEffectiveManifestFile)"
        SarifPath="$(_SharpProofEffectiveSarifFile)" />
    <Message Importance="High"
             Text="SharpProof verifier result: $(_SharpProofEffectiveResultFile)" />
    <Message Condition="$(_SharpProofEffectiveSarifFile) != ''"
             Importance="High"
             Text="SharpProof verifier SARIF result: $(_SharpProofEffectiveSarifFile)" />
    <CallTarget Targets="_SharpProofCleanupInvocation" />
    <OnError ExecuteTargets="_SharpProofCleanupInvocation" />
  </Target>

  <Target Name="SharpProofVerify"
          AfterTargets="CoreCompile"
          DependsOnTargets="CoreCompile;_SharpProofInitializeVerify;_SharpProofVerifyCore"
          Condition="'$(_SharpProofProjectLanguageSupported)' == 'true' AND '$(SharpProofVerify)' == 'true' AND '$(_SharpProofProfileNormalized)' != 'off' AND '$(DesignTimeBuild)' != 'true' AND '$(BuildingProject)' != 'false' AND '$(SkipCompilerExecution)' != 'true'">
    <OnError ExecuteTargets="_SharpProofCleanupInvocation" />
  </Target>

  <Target Name="SharpProofResetPublishedVerification"
          BeforeTargets="Clean"
          Condition="'$(_SharpProofProjectLanguageSupported)' == 'true' AND '$(_SharpProofVerifierHostSupported)' == 'true' AND '$(DesignTimeBuild)' != 'true' AND ('$(TargetFrameworks)' == '' OR '$(TargetFramework)' != '')">
    <PropertyGroup>
      <_SharpProofCleanConfiguredRequestFile>$([System.String]::Copy("$(SharpProofVerifyRequestFile)"))</_SharpProofCleanConfiguredRequestFile>
      <_SharpProofCleanConfiguredResultFile>$([System.String]::Copy("$(SharpProofVerifyResultFile)"))</_SharpProofCleanConfiguredResultFile>
      <_SharpProofCleanConfiguredManifestFile>$([System.String]::Copy("$(SharpProofCompilerManifestFile)"))</_SharpProofCleanConfiguredManifestFile>
      <_SharpProofCleanVerifyDirectory>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine("$(MSBuildProjectDirectory)", "$(IntermediateOutputPath)SharpProof"))))</_SharpProofCleanVerifyDirectory>
      <_SharpProofCleanPublicationTopologyPath>$([System.IO.Path]::Combine("$(_SharpProofCleanVerifyDirectory)", 'publication-topology.json'))</_SharpProofCleanPublicationTopologyPath>
      <_SharpProofCleanRequestFile Condition="$(SharpProofVerifyRequestFile) == ''">$([System.IO.Path]::Combine("$(_SharpProofCleanVerifyDirectory)", 'request.json'))</_SharpProofCleanRequestFile>
      <_SharpProofCleanRequestFile Condition="$(SharpProofVerifyRequestFile) != ''">$(SharpProofVerifyRequestFile)</_SharpProofCleanRequestFile>
      <_SharpProofCleanResultFile Condition="$(SharpProofVerifyResultFile) == ''">$([System.IO.Path]::Combine("$(_SharpProofCleanVerifyDirectory)", 'result.json'))</_SharpProofCleanResultFile>
      <_SharpProofCleanResultFile Condition="$(SharpProofVerifyResultFile) != ''">$(SharpProofVerifyResultFile)</_SharpProofCleanResultFile>
      <_SharpProofCleanManifestFile Condition="$(SharpProofCompilerManifestFile) == ''">$([System.IO.Path]::Combine("$(_SharpProofCleanVerifyDirectory)", 'compiler-manifest.json'))</_SharpProofCleanManifestFile>
      <_SharpProofCleanManifestFile Condition="$(SharpProofCompilerManifestFile) != ''">$(SharpProofCompilerManifestFile)</_SharpProofCleanManifestFile>
      <_SharpProofCleanEffectiveRequestFile>$(_SharpProofCleanRequestFile)</_SharpProofCleanEffectiveRequestFile>
      <_SharpProofCleanEffectiveResultFile>$(_SharpProofCleanResultFile)</_SharpProofCleanEffectiveResultFile>
      <_SharpProofCleanEffectiveManifestFile>$(_SharpProofCleanManifestFile)</_SharpProofCleanEffectiveManifestFile>
      <_SharpProofCleanCompilerManifestSourceFile Condition="$(_SharpProofCompilerManifestPathConfigured) == ''">$([System.IO.Path]::Combine("$(_SharpProofCleanVerifyDirectory)", 'compiler-manifest.input.json'))</_SharpProofCleanCompilerManifestSourceFile>
      <_SharpProofCleanCompilerManifestSourceFile Condition="$(_SharpProofCompilerManifestPathConfigured) != ''">$(_SharpProofCompilerManifestPathConfigured)</_SharpProofCleanCompilerManifestSourceFile>
      <_SharpProofCleanConfiguredRequestFullPath Condition="$(_SharpProofCleanConfiguredRequestFile) != '' AND $(TargetFrameworks) != ''">$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine("$(MSBuildProjectDirectory)", "$(_SharpProofCleanConfiguredRequestFile)"))))</_SharpProofCleanConfiguredRequestFullPath>
      <_SharpProofCleanConfiguredResultFullPath Condition="$(_SharpProofCleanConfiguredResultFile) != '' AND $(TargetFrameworks) != ''">$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine("$(MSBuildProjectDirectory)", "$(_SharpProofCleanConfiguredResultFile)"))))</_SharpProofCleanConfiguredResultFullPath>
      <_SharpProofCleanConfiguredManifestFullPath Condition="$(_SharpProofCleanConfiguredManifestFile) != '' AND $(TargetFrameworks) != ''">$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine("$(MSBuildProjectDirectory)", "$(_SharpProofCleanConfiguredManifestFile)"))))</_SharpProofCleanConfiguredManifestFullPath>
      <_SharpProofCleanEffectiveRequestFile Condition="$(_SharpProofCleanConfiguredRequestFile) != '' AND $(TargetFrameworks) != ''">$([System.IO.Path]::Combine($([System.IO.Path]::GetDirectoryName("$(_SharpProofCleanConfiguredRequestFullPath)")), '$(TargetFramework)', $([System.IO.Path]::GetFileName("$(_SharpProofCleanConfiguredRequestFullPath)"))))</_SharpProofCleanEffectiveRequestFile>
      <_SharpProofCleanEffectiveResultFile Condition="$(_SharpProofCleanConfiguredResultFile) != '' AND $(TargetFrameworks) != ''">$([System.IO.Path]::Combine($([System.IO.Path]::GetDirectoryName("$(_SharpProofCleanConfiguredResultFullPath)")), '$(TargetFramework)', $([System.IO.Path]::GetFileName("$(_SharpProofCleanConfiguredResultFullPath)"))))</_SharpProofCleanEffectiveResultFile>
      <_SharpProofCleanEffectiveManifestFile Condition="$(_SharpProofCleanConfiguredManifestFile) != '' AND $(TargetFrameworks) != ''">$([System.IO.Path]::Combine($([System.IO.Path]::GetDirectoryName("$(_SharpProofCleanConfiguredManifestFullPath)")), '$(TargetFramework)', $([System.IO.Path]::GetFileName("$(_SharpProofCleanConfiguredManifestFullPath)"))))</_SharpProofCleanEffectiveManifestFile>
      <_SharpProofCleanSarifFile>$(SharpProofVerifySarifFile)</_SharpProofCleanSarifFile>
      <_SharpProofCleanConfiguredSarifFullPath Condition="$(SharpProofVerifySarifFile) != '' AND $(TargetFrameworks) != ''">$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine("$(MSBuildProjectDirectory)", "$(SharpProofVerifySarifFile)"))))</_SharpProofCleanConfiguredSarifFullPath>
      <_SharpProofCleanSarifFile Condition="$(SharpProofVerifySarifFile) != '' AND $(TargetFrameworks) != ''">$([System.IO.Path]::Combine($([System.IO.Path]::GetDirectoryName("$(_SharpProofCleanConfiguredSarifFullPath)")), '$(TargetFramework)', $([System.IO.Path]::GetFileName("$(_SharpProofCleanConfiguredSarifFullPath)"))))</_SharpProofCleanSarifFile>
    </PropertyGroup>
    <SharpProof.BuildTasks.ResetPublishedVerification
        RequestPath="$(_SharpProofCleanEffectiveRequestFile)"
        ResultPath="$(_SharpProofCleanEffectiveResultFile)"
        ManifestPath="$(_SharpProofCleanEffectiveManifestFile)"
        ProjectDirectory="$(MSBuildProjectDirectory)"
        SarifPath="$(_SharpProofCleanSarifFile)"
        PublicationTopologyPath="$(_SharpProofCleanPublicationTopologyPath)"
        CompilerManifestSourcePath="$(_SharpProofCleanCompilerManifestSourceFile)" />
  </Target>

  <Target Name="SharpProofRejectUnsupportedWorkerHost"
          AfterTargets="CoreCompile"
          Condition="'$(_SharpProofProjectLanguageSupported)' == 'true' AND '$(SharpProofVerify)' == 'true' AND '$(_SharpProofProfileNormalized)' != 'off' AND '$(_SharpProofVerifierHostSupported)' != 'true' AND '$(DesignTimeBuild)' != 'true' AND '$(BuildingProject)' != 'false'">
    <Error Code="SP0054" Text="SharpProof verification is supported only by Core MSBuild inside the canonical Linux amd64 container. Portable analyzer profiles remain available on this host." />
  </Target>
</Project>
