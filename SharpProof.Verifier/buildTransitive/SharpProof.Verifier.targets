<Project>
  <UsingTask TaskName="SharpProof.BuildTasks.InvalidatePublishedResult"
             AssemblyFile="$(_SharpProofBuildTasksPath)" />
  <UsingTask TaskName="SharpProof.BuildTasks.RunVerifier"
             AssemblyFile="$(_SharpProofBuildTasksPath)" />

  <PropertyGroup>
    <SharpProofVerifyPolicy Condition="'$(SharpProofVerifyPolicy)' == '' AND '$(_SharpProofProfileNormalized)' == 'strict'">require-proven</SharpProofVerifyPolicy>
    <SharpProofVerifyPolicy Condition="'$(SharpProofVerifyPolicy)' == ''">advisory</SharpProofVerifyPolicy>
    <SharpProofAssumptionPolicy Condition="'$(SharpProofAssumptionPolicy)' == '' AND '$(_SharpProofProfileNormalized)' == 'strict'">error</SharpProofAssumptionPolicy>
    <SharpProofAssumptionPolicy Condition="'$(SharpProofAssumptionPolicy)' == ''">allow</SharpProofAssumptionPolicy>
    <_SharpProofVerifyPolicyNormalized>$([System.String]::Copy('$(SharpProofVerifyPolicy)').ToLowerInvariant())</_SharpProofVerifyPolicyNormalized>
    <_SharpProofAssumptionPolicyNormalized>$([System.String]::Copy('$(SharpProofAssumptionPolicy)').ToLowerInvariant())</_SharpProofAssumptionPolicyNormalized>
  </PropertyGroup>

  <Target Name="_SharpProofInitializeVerify"
          BeforeTargets="GenerateMSBuildEditorConfigFileShouldRun;GenerateMSBuildEditorConfigFile">
    <PropertyGroup>
      <_SharpProofVerifyDirectory>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)SharpProof'))))</_SharpProofVerifyDirectory>
      <SharpProofVerifyRequestFile Condition="'$(SharpProofVerifyRequestFile)' == ''">$([System.IO.Path]::Combine('$(_SharpProofVerifyDirectory)', 'request.json'))</SharpProofVerifyRequestFile>
      <SharpProofVerifyResultFile Condition="'$(SharpProofVerifyResultFile)' == ''">$([System.IO.Path]::Combine('$(_SharpProofVerifyDirectory)', 'result.json'))</SharpProofVerifyResultFile>
      <SharpProofCompilerManifestFile Condition="'$(SharpProofCompilerManifestFile)' == ''">$([System.IO.Path]::Combine('$(_SharpProofVerifyDirectory)', 'compiler-manifest.json'))</SharpProofCompilerManifestFile>
      <_SharpProofVerifyCacheDirectoryNormalized>$([System.String]::Copy('$(SharpProofVerifyCacheDirectory)').Trim())</_SharpProofVerifyCacheDirectoryNormalized>
      <_SharpProofEffectiveCacheDirectory Condition="'$(_SharpProofVerifyCacheDirectoryNormalized)' == ''">$([System.IO.Path]::Combine('$(_SharpProofVerifyDirectory)', 'cache'))</_SharpProofEffectiveCacheDirectory>
      <_SharpProofEffectiveCacheDirectory Condition="'$(_SharpProofVerifyCacheDirectoryNormalized)' != ''">$(SharpProofVerifyCacheDirectory)</_SharpProofEffectiveCacheDirectory>
      <_SharpProofInvocationId Condition="'$(_SharpProofInvocationId)' == ''">$([System.Guid]::NewGuid().ToString('N'))</_SharpProofInvocationId>
      <_SharpProofInvocationDirectory>$([System.IO.Path]::Combine('$(_SharpProofVerifyDirectory)', 'runs', '$(_SharpProofInvocationId)'))</_SharpProofInvocationDirectory>
      <_SharpProofInvocationRequestFile>$([System.IO.Path]::Combine('$(_SharpProofInvocationDirectory)', 'request.json'))</_SharpProofInvocationRequestFile>
      <_SharpProofInvocationResultFile>$([System.IO.Path]::Combine('$(_SharpProofInvocationDirectory)', 'result.json'))</_SharpProofInvocationResultFile>
    </PropertyGroup>
    <PropertyGroup Condition="'$(SharpProofVerify)' == 'true' AND '$(_SharpProofProfileNormalized)' != 'off' AND '$(_SharpProofVerifierHostSupported)' == 'true' AND '$(DesignTimeBuild)' != 'true' AND '$(BuildingProject)' != 'false'">
      <_SharpProofCompilationTargetFramework>$(TargetFramework)</_SharpProofCompilationTargetFramework>
      <_SharpProofCompilerManifestPath>$([System.IO.Path]::Combine('$(_SharpProofInvocationDirectory)', 'compiler-manifest.json'))</_SharpProofCompilerManifestPath>
      <_SharpProofProjectDirectory>$(MSBuildProjectDirectory)</_SharpProofProjectDirectory>
    </PropertyGroup>
    <SharpProof.BuildTasks.InvalidatePublishedResult
        Condition="'$(SharpProofVerify)' == 'true' AND '$(_SharpProofProfileNormalized)' != 'off' AND '$(_SharpProofVerifierHostSupported)' == 'true' AND '$(DesignTimeBuild)' != 'true' AND '$(BuildingProject)' != 'false'"
        ResultPath="$(SharpProofVerifyResultFile)"
        ProjectDirectory="$(MSBuildProjectDirectory)"
        RequestPath="$(SharpProofVerifyRequestFile)"
        ManifestPath="$(SharpProofCompilerManifestFile)"
        SarifPath="$(SharpProofVerifySarifFile)"
        InvocationRequestPath="$(_SharpProofInvocationRequestFile)"
        InvocationResultPath="$(_SharpProofInvocationResultFile)"
        InvocationManifestPath="$(_SharpProofCompilerManifestPath)"
        WorkerPath="$(_SharpProofWorkerPath)"
        LauncherPath="$(_SharpProofLauncherPath)"
        WorkerProtocolPath="$(_SharpProofWorkerProtocolPath)"
        CachePath="$(_SharpProofEffectiveCacheDirectory)" />
  </Target>

  <Target Name="_SharpProofVerifyCore"
          DependsOnTargets="_SharpProofInitializeVerify;ResolveReferences">
    <Error Condition="'$(_SharpProofVerifierHostSupported)' != 'true'"
           Text="SharpProof verification is supported only by Core MSBuild inside the canonical Linux amd64 container. Portable analyzer profiles remain available on this host." />
    <Error Condition="'$(_SharpProofVerifyPolicyNormalized)' != 'advisory' AND '$(_SharpProofVerifyPolicyNormalized)' != 'warn-on-unknown' AND '$(_SharpProofVerifyPolicyNormalized)' != 'require-proven'"
           Text="SharpProofVerifyPolicy must be advisory, warn-on-unknown, or require-proven." />
    <Error Condition="'$(_SharpProofAssumptionPolicyNormalized)' != 'allow' AND '$(_SharpProofAssumptionPolicyNormalized)' != 'warn' AND '$(_SharpProofAssumptionPolicyNormalized)' != 'error'"
           Text="SharpProofAssumptionPolicy must be allow, warn, or error." />
    <Error Code="SP0049"
           Condition="!Exists('$(_SharpProofCompilerManifestPath)')"
           Text="SharpProof did not receive the required final compiler manifest." />
    <Error Condition="!Exists('$(_SharpProofLauncherPath)')"
           Text="SharpProof verifier launcher was not found at '$(_SharpProofLauncherPath)'." />
    <Error Condition="!Exists('$(_SharpProofWorkerPath)')"
           Text="SharpProof verifier worker was not found at '$(_SharpProofWorkerPath)'." />
    <MakeDir Directories="$(_SharpProofInvocationDirectory)" />
    <ItemGroup>
      <_SharpProofVerifierArgument Remove="@(_SharpProofVerifierArgument)" />
      <_SharpProofVerifierArgument Include="$([MSBuild]::Escape('$(_SharpProofLauncherPath)'))" />
      <_SharpProofVerifierArgument Include="verify" />
      <_SharpProofVerifierArgument Include="--worker" />
      <_SharpProofVerifierArgument Include="$([MSBuild]::Escape('$(_SharpProofWorkerPath)'))" />
      <_SharpProofVerifierArgument Include="--request" />
      <_SharpProofVerifierArgument Include="$([MSBuild]::Escape('$(_SharpProofInvocationRequestFile)'))" />
      <_SharpProofVerifierArgument Include="--result" />
      <_SharpProofVerifierArgument Include="$([MSBuild]::Escape('$(_SharpProofInvocationResultFile)'))" />
      <_SharpProofVerifierArgument Include="--publish-request" />
      <_SharpProofVerifierArgument Include="$([MSBuild]::Escape('$(SharpProofVerifyRequestFile)'))" />
      <_SharpProofVerifierArgument Include="--publish-result" />
      <_SharpProofVerifierArgument Include="$([MSBuild]::Escape('$(SharpProofVerifyResultFile)'))" />
      <_SharpProofVerifierArgument Include="--compiler-manifest" />
      <_SharpProofVerifierArgument Include="$([MSBuild]::Escape('$(_SharpProofCompilerManifestPath)'))" />
      <_SharpProofVerifierArgument Include="--publish-compiler-manifest" />
      <_SharpProofVerifierArgument Include="$([MSBuild]::Escape('$(SharpProofCompilerManifestFile)'))" />
      <_SharpProofVerifierArgument Include="--verify-policy" />
      <_SharpProofVerifierArgument Include="$(_SharpProofVerifyPolicyNormalized)" />
      <_SharpProofVerifierArgument Include="--assumption-policy" />
      <_SharpProofVerifierArgument Include="$(_SharpProofAssumptionPolicyNormalized)" />
      <_SharpProofVerifierArgument Include="--query-rlimit" />
      <_SharpProofVerifierArgument Include="$(SharpProofVerifyQueryRlimit)" />
      <_SharpProofVerifierArgument Include="--method-rlimit" />
      <_SharpProofVerifierArgument Include="$(SharpProofVerifyMethodRlimit)" />
      <_SharpProofVerifierArgument Include="--method-wall-ms" />
      <_SharpProofVerifierArgument Include="$(SharpProofVerifyMethodWallTimeMilliseconds)" />
      <_SharpProofVerifierArgument Include="--project-wall-ms" />
      <_SharpProofVerifierArgument Include="$(SharpProofVerifyProjectWallTimeMilliseconds)" />
      <_SharpProofVerifierArgument Include="--max-parallelism" />
      <_SharpProofVerifierArgument Include="$(SharpProofVerifyMaxParallelism)" />
      <_SharpProofVerifierArgument Include="--max-expression-depth" />
      <_SharpProofVerifierArgument Include="$(SharpProofVerifyMaximumExpressionDepth)" />
      <_SharpProofVerifierArgument Include="--termination-grace-ms" />
      <_SharpProofVerifierArgument Include="$(SharpProofVerifyTerminationGraceMilliseconds)" />
      <_SharpProofVerifierArgument Include="--cache-enabled" />
      <_SharpProofVerifierArgument Include="$(SharpProofVerifyCacheEnabled)" />
      <_SharpProofVerifierArgument Include="--cache-directory" />
      <_SharpProofVerifierArgument Include="$([MSBuild]::Escape('$(_SharpProofEffectiveCacheDirectory)'))" />
      <_SharpProofVerifierArgument Include="--cache-maximum-bytes" />
      <_SharpProofVerifierArgument Include="$(SharpProofVerifyCacheMaximumBytes)" />
      <_SharpProofVerifierArgument Include="--publish-sarif"
                                   Condition="'$(SharpProofVerifySarifFile)' != ''" />
      <_SharpProofVerifierArgument Include="$([MSBuild]::Escape('$(SharpProofVerifySarifFile)'))"
                                   Condition="'$(SharpProofVerifySarifFile)' != ''" />
    </ItemGroup>
    <SharpProof.BuildTasks.RunVerifier
        Executable="$(_SharpProofDotNetHost)"
        Arguments="@(_SharpProofVerifierArgument)"
        WorkingDirectory="$(MSBuildProjectDirectory)">
      <Output TaskParameter="ExitCode"
              PropertyName="_SharpProofVerifierExitCode" />
    </SharpProof.BuildTasks.RunVerifier>
    <RemoveDir Directories="$(_SharpProofInvocationDirectory)" />
    <Error Condition="'$(_SharpProofVerifierExitCode)' != '0'"
           Text="SharpProof verifier failed with exit code $(_SharpProofVerifierExitCode)." />
    <Message Importance="High"
             Text="SharpProof verifier result: $(SharpProofVerifyResultFile)" />
    <Message Condition="'$(SharpProofVerifySarifFile)' != ''"
             Importance="High"
             Text="SharpProof verifier SARIF result: $(SharpProofVerifySarifFile)" />
  </Target>

  <Target Name="SharpProofVerify"
          AfterTargets="CoreCompile"
          DependsOnTargets="_SharpProofInitializeVerify;_SharpProofVerifyCore"
          Condition="'$(SharpProofVerify)' == 'true' AND '$(_SharpProofProfileNormalized)' != 'off' AND '$(_SharpProofVerifierHostSupported)' == 'true' AND '$(DesignTimeBuild)' != 'true' AND '$(BuildingProject)' != 'false'" />

  <Target Name="SharpProofRejectUnsupportedWorkerHost"
          AfterTargets="CoreCompile"
          Condition="'$(SharpProofVerify)' == 'true' AND '$(_SharpProofProfileNormalized)' != 'off' AND '$(_SharpProofVerifierHostSupported)' != 'true' AND '$(DesignTimeBuild)' != 'true' AND '$(BuildingProject)' != 'false'">
    <Error Text="SharpProof verification is supported only by Core MSBuild inside the canonical Linux amd64 container. Portable analyzer profiles remain available on this host." />
  </Target>
</Project>
