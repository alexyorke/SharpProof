<Project>
  <PropertyGroup>
    <_SharpProofVerifierPackagePresent>true</_SharpProofVerifierPackagePresent>
    <_SharpProofVerifierHostArchitecture>$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)</_SharpProofVerifierHostArchitecture>
    <_SharpProofVerifierProcessArchitecture>$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)</_SharpProofVerifierProcessArchitecture>
    <_SharpProofVerifierHostSupported Condition="'$(MSBuildRuntimeType)' == 'Core' AND '$(SHARPPROOF_CONTAINER)' == '1' AND '$(_SharpProofVerifierHostArchitecture)' == 'X64' AND '$(_SharpProofVerifierProcessArchitecture)' == 'X64'">true</_SharpProofVerifierHostSupported>
    <SharpProofToolsDirectory Condition="'$(SharpProofToolsDirectory)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../tools/net9'))</SharpProofToolsDirectory>
    <_SharpProofToolsDirectory>$([System.IO.Path]::GetFullPath('$(SharpProofToolsDirectory)'))</_SharpProofToolsDirectory>
    <SharpProofWorkerPath Condition="'$(SharpProofWorkerPath)' == ''">$(_SharpProofToolsDirectory)/SharpProof.Worker.dll</SharpProofWorkerPath>
    <SharpProofLauncherPath Condition="'$(SharpProofLauncherPath)' == ''">$(_SharpProofToolsDirectory)/SharpProof.Worker.Launcher.dll</SharpProofLauncherPath>
    <_SharpProofWorkerPath>$([System.IO.Path]::GetFullPath('$(SharpProofWorkerPath)'))</_SharpProofWorkerPath>
    <_SharpProofLauncherPath>$([System.IO.Path]::GetFullPath('$(SharpProofLauncherPath)'))</_SharpProofLauncherPath>
    <_SharpProofWorkerProtocolPath>$([System.IO.Path]::Combine('$(_SharpProofToolsDirectory)', 'SharpProof.Worker.Protocol.dll'))</_SharpProofWorkerProtocolPath>
    <_SharpProofBuildTasksPath>$([System.IO.Path]::Combine('$(_SharpProofToolsDirectory)', 'SharpProof.BuildTasks.dll'))</_SharpProofBuildTasksPath>
    <SharpProofVerifyQueryRlimit Condition="'$(SharpProofVerifyQueryRlimit)' == ''">3000000</SharpProofVerifyQueryRlimit>
    <SharpProofVerifyMethodRlimit Condition="'$(SharpProofVerifyMethodRlimit)' == ''">20000000</SharpProofVerifyMethodRlimit>
    <SharpProofVerifyMethodWallTimeMilliseconds Condition="'$(SharpProofVerifyMethodWallTimeMilliseconds)' == ''">10000</SharpProofVerifyMethodWallTimeMilliseconds>
    <SharpProofVerifyProjectWallTimeMilliseconds Condition="'$(SharpProofVerifyProjectWallTimeMilliseconds)' == ''">300000</SharpProofVerifyProjectWallTimeMilliseconds>
    <SharpProofVerifyMaxParallelism Condition="'$(SharpProofVerifyMaxParallelism)' == ''">4</SharpProofVerifyMaxParallelism>
    <SharpProofVerifyMaximumExpressionDepth Condition="'$(SharpProofVerifyMaximumExpressionDepth)' == ''">64</SharpProofVerifyMaximumExpressionDepth>
    <SharpProofVerifyTerminationGraceMilliseconds Condition="'$(SharpProofVerifyTerminationGraceMilliseconds)' == ''">1000</SharpProofVerifyTerminationGraceMilliseconds>
    <SharpProofVerifyCacheEnabled Condition="'$(SharpProofVerifyCacheEnabled)' == ''">true</SharpProofVerifyCacheEnabled>
    <SharpProofVerifyCacheMaximumBytes Condition="'$(SharpProofVerifyCacheMaximumBytes)' == ''">536870912</SharpProofVerifyCacheMaximumBytes>
    <_SharpProofDotNetHost Condition="'$(_SharpProofDotNetHost)' == '' AND '$(DOTNET_HOST_PATH)' != ''">$(DOTNET_HOST_PATH)</_SharpProofDotNetHost>
    <_SharpProofDotNetHost Condition="'$(_SharpProofDotNetHost)' == ''">dotnet</_SharpProofDotNetHost>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="SharpProofVerifyPolicy" />
    <CompilerVisibleProperty Include="SharpProofAssumptionPolicy" />
    <CompilerVisibleProperty Include="_SharpProofCompilerManifestPath" />
    <CompilerVisibleProperty Include="_SharpProofCompilationTargetFramework" />
    <CompilerVisibleProperty Include="_SharpProofProjectDirectory" />
    <CompilerVisibleProperty Include="SharpProofVerifyMaximumExpressionDepth" />
  </ItemGroup>
</Project>
