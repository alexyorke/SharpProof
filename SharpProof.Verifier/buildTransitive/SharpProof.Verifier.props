<Project>
  <PropertyGroup>
    <_SharpProofVerifierPackagePresent>true</_SharpProofVerifierPackagePresent>
    <_SharpProofVerifierHostArchitecture>$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)</_SharpProofVerifierHostArchitecture>
    <_SharpProofVerifierProcessArchitecture>$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)</_SharpProofVerifierProcessArchitecture>
    <_SharpProofVerifierHostSupported Condition="'$(MSBuildRuntimeType)' == 'Core' AND '$(SHARPPROOF_CONTAINER)' == '1' AND '$(_SharpProofVerifierHostArchitecture)' == 'X64' AND '$(_SharpProofVerifierProcessArchitecture)' == 'X64'">true</_SharpProofVerifierHostSupported>
    <_SharpProofPackageToolsDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../tools/net9'))</_SharpProofPackageToolsDirectory>
    <_SharpProofPackageNativeZ3Path>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../tools/native/linux-x64/libz3.so'))</_SharpProofPackageNativeZ3Path>
    <_SharpProofToolsDirectory>$(_SharpProofPackageToolsDirectory)</_SharpProofToolsDirectory>
    <_SharpProofToolsDirectory Condition="'$(_SharpProofTestToolsDirectory)' != ''">$([System.IO.Path]::GetFullPath('$(_SharpProofTestToolsDirectory)'))</_SharpProofToolsDirectory>
    <_SharpProofBuildTasksPath>$([System.IO.Path]::Combine('$(_SharpProofPackageToolsDirectory)', 'SharpProof.BuildTasks.dll'))</_SharpProofBuildTasksPath>
    <_SharpProofBuildTasksPath Condition="'$(_SharpProofTestBuildTasksPath)' != ''">$([System.IO.Path]::GetFullPath('$(_SharpProofTestBuildTasksPath)'))</_SharpProofBuildTasksPath>
    <_SharpProofPackageWorkerPath>$([System.IO.Path]::Combine('$(_SharpProofPackageToolsDirectory)', 'SharpProof.Worker.dll'))</_SharpProofPackageWorkerPath>
    <_SharpProofPackageLauncherPath>$([System.IO.Path]::Combine('$(_SharpProofPackageToolsDirectory)', 'SharpProof.Worker.Launcher.dll'))</_SharpProofPackageLauncherPath>
    <_SharpProofPackageWorkerProtocolPath>$([System.IO.Path]::Combine('$(_SharpProofPackageToolsDirectory)', 'SharpProof.Worker.Protocol.dll'))</_SharpProofPackageWorkerProtocolPath>
    <_SharpProofPackageBuildTasksPath>$([System.IO.Path]::Combine('$(_SharpProofPackageToolsDirectory)', 'SharpProof.BuildTasks.dll'))</_SharpProofPackageBuildTasksPath>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)SharpProof.Verifier.defaults.props" />
  <PropertyGroup>
    <_SharpProofDotNetHost Condition="'$(_SharpProofDotNetHost)' == '' AND '$(DOTNET_HOST_PATH)' != ''">$(DOTNET_HOST_PATH)</_SharpProofDotNetHost>
    <_SharpProofDotNetHost Condition="'$(_SharpProofDotNetHost)' == ''">dotnet</_SharpProofDotNetHost>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="SharpProofVerifyPolicy;SharpProofAssumptionPolicy;_SharpProofCompilerManifestPath;_SharpProofCompilationTargetFramework;_SharpProofProjectDirectory;SharpProofVerifyMaximumExpressionDepth" />
  </ItemGroup>
</Project>
