<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\SharpProof.PackageMetadata.props" />
  <PropertyGroup>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NuspecFile>SharpProof.Verifier.nuspec</NuspecFile>
    <NuspecBasePath>$(MSBuildProjectDirectory)</NuspecBasePath>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>
  <PropertyGroup>
    <PackageId>SharpProof.Verifier</PackageId>
    <Title>SharpProof Verifier</Title>
    <Description>Container-only Linux amd64 postcondition verifier for SharpProof, including the worker, launcher, MSBuild integration, and the pinned native Z3 payload.</Description>
    <PackageReleaseNotes>Initial container-first Linux amd64 verifier package for the soundness-first SharpProof preview.</PackageReleaseNotes>
    <Copyright>Copyright (c) Alex Yorke</Copyright>
    <PackageTags>SharpProof;Verifier;Contracts;SMT;Z3;Linux;Container;x64</PackageTags>
    <NoPackageAnalysis>true</NoPackageAnalysis>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SharpProof.Package\SharpProof.Package.csproj"
                      PrivateAssets="all"
                      TreatAsPackageReference="false" />
    <ProjectReference Include="..\SharpProof.Worker\SharpProof.Worker.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      PrivateAssets="all"
                      TreatAsPackageReference="false" />
    <ProjectReference Include="..\SharpProof.Worker.Launcher\SharpProof.Worker.Launcher.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      PrivateAssets="all"
                      TreatAsPackageReference="false" />
    <ProjectReference Include="..\SharpProof.BuildTasks\SharpProof.BuildTasks.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      PrivateAssets="all"
                      TreatAsPackageReference="false" />
    <ProjectReference Include="..\SharpProof.Host\SharpProof.Host.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      PrivateAssets="all"
                      TreatAsPackageReference="false" />
  </ItemGroup>
  <Target Name="_SharpProofPrepareNuspecProperties"
          BeforeTargets="GenerateNuspec">
    <Error Condition="'$(SHARPPROOF_CONTAINER)' != '1'"
           Text="SharpProof.Verifier packages must be built inside the canonical Linux amd64 container." />
    <PropertyGroup>
      <_SharpProofNativePayloadRoot Condition="'$(_SharpProofNativePayloadRoot)' == ''">$(SHARPPROOF_NATIVE_ROOT)</_SharpProofNativePayloadRoot>
      <NuspecProperties>version=$(SharpProofPackageVersion);configuration=$(Configuration);repositorycommit=$(RepositoryCommit);nativeroot=$(_SharpProofNativePayloadRoot)</NuspecProperties>
    </PropertyGroup>
  </Target>
</Project>
