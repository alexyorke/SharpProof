# Build output (Arcade writes everything under artifacts/)
artifacts/
[Bb]in/
[Oo]bj/
*.binlog
*.nupkg
*.snupkg
/nupkgs/
/packages/

# Test results and coverage
[Tt]est[Rr]esult*/
*.trx
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
coverage*.info
/coverage/
/coverage-report/

# Arcade bootstrap and tool caches
.dotnet/
.tools/
.packages/

# Repository-local caches, virtual environments, and scratch worktrees
/.cache/
/.nuget/
/.venv/
/venv/
/tmp/
/temp/
/.worktrees/
/worktrees/
.baseline-check/
node_modules/
__pycache__/
*.pyc

# Local environment files; keep shareable examples and templates.
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.*.example
!.env.*.sample
!.env.*.template

# IDE and editor state
.vs/
.idea/
.fleet/
.history/
.ionide/
.claude/
*.user
*.suo
*.rsuser
*.userprefs
*.DotSettings.user
*.sln.iml
*.swp
*.swo

# Logs, crash dumps, and merge/backup leftovers
*.log
/*.sarif
/*.dmp
/*.dump
*.tmp
*.bak
*.orig
*.rej
*~

# Operating-system metadata
.DS_Store
._*
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Keep the complete pinned Arcade tree, including cross/arm patches.
!/eng/common/**
