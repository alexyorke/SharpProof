<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <InternalsVisibleTo Include="SharpProof.Fuzz.Test" />
  </ItemGroup>
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <!-- The executable deliberately uses seeded non-cryptographic randomness,
         IR sort names, explicit argument guards with stable messages, and
         console-oriented async/output behavior. It has no public API contract. -->
    <NoWarn>$(NoWarn);CA1510;CA1512;CA1515;CA1720;CA1849;CA2007;CA5394</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Z3" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\scripts\SharpProof.JsonDefaults.cs"
             Link="SharpProof.JsonDefaults.cs" />
    <ProjectReference Include="..\..\SharpProof.Ir\SharpProof.Ir.csproj" />
    <ProjectReference Include="..\..\SharpProof.Frontend\SharpProof.Frontend.csproj" />
    <ProjectReference Include="..\..\SharpProof.Host\SharpProof.Host.csproj" />
    <ProjectReference Include="..\..\SharpProof.Smt\SharpProof.Smt.csproj" />
    <ProjectReference Include="..\..\SharpProof.Testing\SharpProof.Testing.csproj" />
    <ProjectReference Include="..\..\SharpProof.Verify\SharpProof.Verify.csproj" />
  </ItemGroup>
</Project>
