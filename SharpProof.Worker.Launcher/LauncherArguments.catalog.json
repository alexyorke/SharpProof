    { "key": "max-expression-depth", "category": "optional", "accessor": "none", "property": "", "fallback": "" },
    { "key": "cache-enabled", "category": "optional", "accessor": "none", "property": "", "fallback": "" },
    { "key": "cache-directory", "category": "optional", "accessor": "none", "property": "", "fallback": "" },
    { "key": "cache-maximum-bytes", "category": "optional", "accessor": "none", "property": "", "fallback": "" }
