<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <!-- Integer and String are intentional names in the typed IR vocabulary. -->
    <NoWarn>$(NoWarn);CA1720</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Collections.Immutable" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SharpProof.Meta.Analyzers\SharpProof.Meta.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SharpProof.CompilerArtifact" />
    <InternalsVisibleTo Include="SharpProof.CompilerCollector" />
    <InternalsVisibleTo Include="SharpProof.Analyzer.Test" />
    <InternalsVisibleTo Include="SharpProof.Effects" />
    <InternalsVisibleTo Include="SharpProof.Frontend" />
    <InternalsVisibleTo Include="SharpProof.Gates" />
    <InternalsVisibleTo Include="SharpProof.Specs" />
    <InternalsVisibleTo Include="SharpProof.Specs.Test" />
    <InternalsVisibleTo Include="SharpProof.Summaries" />
    <InternalsVisibleTo Include="SharpProof.Worker" />
    <InternalsVisibleTo Include="SharpProof.Analyzer" />
    <InternalsVisibleTo Include="SharpProof.Analyzer.Core" />
    <InternalsVisibleTo Include="SharpProof.Contracts" />
    <InternalsVisibleTo Include="SharpProof.Ir.Test" />
    <InternalsVisibleTo Include="SharpProof.Smt" />
    <InternalsVisibleTo Include="SharpProof.Testing" />
    <InternalsVisibleTo Include="SharpProof.Verify" />
    <InternalsVisibleTo Include="SharpProof.Worker.Launcher" />
  </ItemGroup>
</Project>
