<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsRoslynAnalyzer>true</IsRoslynAnalyzer>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion> 
    <ImplicitUsings>enable</ImplicitUsings> 
    <NoWarn>$(NoWarn);RS2007;RS1035</NoWarn> 
    <GeneratedPurityBuiltInSummaryDirectory Condition="'$(GeneratedPurityBuiltInSummaryDirectory)' == ''">$(BaseIntermediateOutputPath)$(Configuration)\$(TargetFramework)\GeneratedPurity</GeneratedPurityBuiltInSummaryDirectory>
    <GeneratedPurityArtifactSourceDirectory Condition="'$(GeneratedPurityArtifactSourceDirectory)' == ''">$(MSBuildThisFileDirectory)..\artifacts\effect-summary</GeneratedPurityArtifactSourceDirectory>
  </PropertyGroup>

  <ItemGroup>
    
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="4.14.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />

    
    <PackageReference Include="System.Collections.Immutable" Version="9.0.0" /> 
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
  </ItemGroup>

  
  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PurelySharp.Attributes\PurelySharp.Attributes.csproj" />
    <ProjectReference Include="..\SearchLib\SearchLib.csproj" />
    
  </ItemGroup>
  
  <ItemGroup>
    
    <EmbeddedResource Update="Resources\DiagnosticMessages.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>DiagnosticMessages.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Resources\DiagnosticMessages.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>DiagnosticMessages.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <Target Name="StageGeneratedPurityBuiltInSummaries" BeforeTargets="AssignTargetPaths">
    <ItemGroup Condition="Exists('$(GeneratedPurityArtifactSourceDirectory)')">
      <_GeneratedPurityArtifactAlreadyNamed Include="$(GeneratedPurityArtifactSourceDirectory)\*.PurelySharp.EffectSummary.json" />
    </ItemGroup>

    <RemoveDir Directories="$(GeneratedPurityBuiltInSummaryDirectory)"
               Condition="Exists('$(GeneratedPurityBuiltInSummaryDirectory)')" />
    <MakeDir Directories="$(GeneratedPurityBuiltInSummaryDirectory)"
             Condition="'@(_GeneratedPurityArtifactAlreadyNamed)' != ''" />

    <Copy SourceFiles="@(_GeneratedPurityArtifactAlreadyNamed)"
          DestinationFolder="$(GeneratedPurityBuiltInSummaryDirectory)"
          SkipUnchangedFiles="true"
          Condition="'@(_GeneratedPurityArtifactAlreadyNamed)' != ''" />
  </Target>

  <Target Name="IncludeGeneratedPurityBuiltInSummaries"
          BeforeTargets="AssignTargetPaths"
          DependsOnTargets="StageGeneratedPurityBuiltInSummaries">
    <ItemGroup Condition="Exists('$(GeneratedPurityBuiltInSummaryDirectory)')">
      <_GeneratedPurityBuiltInSummary Include="$(GeneratedPurityBuiltInSummaryDirectory)\*.PurelySharp.EffectSummary.json" />
      <EmbeddedResource Include="@(_GeneratedPurityBuiltInSummary)">
        <LogicalName>PurelySharp.Analyzer.GeneratedPurity.%(Filename)%(Extension)</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

</Project> 
