<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <SharpProofUsesMetaAnalyzer>true</SharpProofUsesMetaAnalyzer>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>
  <Target Name="_SharpProofCopyRuntimeDependencies" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <_SharpProofImmutableRuntime Include="@(RuntimeCopyLocalItems)"
                                   Condition="'%(RuntimeCopyLocalItems.NuGetPackageId)' == 'System.Collections.Immutable'" />
    </ItemGroup>
    <Copy SourceFiles="@(_SharpProofImmutableRuntime)"
          DestinationFiles="@(_SharpProofImmutableRuntime->'$(TargetDir)%(Filename)%(Extension)')" />
  </Target>
  <ItemGroup>
    <ProjectReference Include="..\SharpProof.CompilerArtifact\SharpProof.CompilerArtifact.csproj" />
    <ProjectReference Include="..\SharpProof.Dataflow\SharpProof.Dataflow.csproj" />
    <ProjectReference Include="..\SharpProof.Host\SharpProof.Host.csproj" />
    <ProjectReference Include="..\SharpProof.Ir\SharpProof.Ir.csproj" />
    <ProjectReference Include="..\SharpProof.Smt\SharpProof.Smt.csproj" />
    <ProjectReference Include="..\SharpProof.Specs\SharpProof.Specs.csproj" />
    <ProjectReference Include="..\SharpProof.Verify\SharpProof.Verify.csproj" />
    <ProjectReference Include="..\SharpProof.Worker.Protocol\SharpProof.Worker.Protocol.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SharpProof.Worker.Test" />
  </ItemGroup>
</Project>
