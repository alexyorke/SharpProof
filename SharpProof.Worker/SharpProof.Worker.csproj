<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>$(SharpProofPackageVersion)</Version>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.AnalyzerUtilities" Version="5.6.0" />
    <PackageReference Include="System.Text.Json" Version="10.0.10" />
    <Reference Include="Microsoft.CodeAnalysis"
               HintPath="$(RoslynTargetsPath)\bincore\Microsoft.CodeAnalysis.dll"
               Private="true" />
    <Reference Include="Microsoft.CodeAnalysis.CSharp"
               HintPath="$(RoslynTargetsPath)\bincore\Microsoft.CodeAnalysis.CSharp.dll"
               Private="true" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SharpProof.Attributes\SharpProof.Attributes.csproj" />
    <ProjectReference Include="..\SharpProof.CompilerArtifact\SharpProof.CompilerArtifact.csproj" />
    <ProjectReference Include="..\SharpProof.Contracts\SharpProof.Contracts.csproj" />
    <ProjectReference Include="..\SharpProof.Dataflow\SharpProof.Dataflow.csproj" />
    <ProjectReference Include="..\SharpProof.Frontend\SharpProof.Frontend.csproj" />
    <ProjectReference Include="..\SharpProof.Ir\SharpProof.Ir.csproj" />
    <ProjectReference Include="..\SharpProof.Meta.Analyzers\SharpProof.Meta.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\SharpProof.Smt\SharpProof.Smt.csproj" />
    <ProjectReference Include="..\SharpProof.Specs\SharpProof.Specs.csproj" />
    <ProjectReference Include="..\SharpProof.Verify\SharpProof.Verify.csproj" />
    <ProjectReference Include="..\SharpProof.Worker.Protocol\SharpProof.Worker.Protocol.csproj" />
  </ItemGroup>
  <Target Name="_CopySharpProofCompilerRuntime"
          AfterTargets="Build">
    <Copy SourceFiles="$(RoslynTargetsPath)\bincore\Microsoft.CodeAnalysis.dll;$(RoslynTargetsPath)\bincore\Microsoft.CodeAnalysis.CSharp.dll"
          DestinationFolder="$(TargetDir)" />
  </Target>
</Project>
