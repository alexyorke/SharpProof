<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>SharpProof.Analyzer.Core</AssemblyName>
    <RootNamespace>SharpProof</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DefineConstants>$(DefineConstants);SHARPPROOF_ANALYZER_LIBRARY</DefineConstants>
    <NoWarn>$(NoWarn);RS2002;RS2003</NoWarn>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="System.Collections.Immutable" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\SharpProof.Analyzer\**\*.cs"
             Exclude="..\SharpProof.Analyzer\bin\**\*;..\SharpProof.Analyzer\obj\**\*"
             LinkBase="Sources\SharpProof.Analyzer" />
    <Compile Include="..\SharpProof.Specs\Polyfills\IsExternalInit.cs"
             Link="Polyfills\IsExternalInit.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpProof.Contracts\SharpProof.Contracts.csproj" />
    <ProjectReference Include="..\SharpProof.Effects\SharpProof.Effects.csproj" />
    <ProjectReference Include="..\SharpProof.Frontend\SharpProof.Frontend.csproj" />
    <ProjectReference Include="..\SharpProof.Ir\SharpProof.Ir.csproj" />
    <ProjectReference Include="..\SharpProof.Specs\SharpProof.Specs.csproj" />
    <ProjectReference Include="..\SharpProof.Meta.Analyzers\SharpProof.Meta.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
