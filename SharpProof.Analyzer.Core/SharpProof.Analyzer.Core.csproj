<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsRoslynAnalyzer>true</IsRoslynAnalyzer>
    <SharpProofUsesMetaAnalyzer>true</SharpProofUsesMetaAnalyzer>
    <AssemblyName>SharpProof.Analyzer.Core</AssemblyName>
    <RootNamespace>SharpProof</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="System.Collections.Immutable" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\eng\RoslynCfgThrowFacts.cs"
             Link="RoslynCfgThrowFacts.cs" />
    <Compile Include="..\SharpProof.Specs\Polyfills\IsExternalInit.cs"
             Link="Polyfills\IsExternalInit.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpProof.Contracts\SharpProof.Contracts.csproj" />
    <ProjectReference Include="..\SharpProof.Effects\SharpProof.Effects.csproj" />
    <ProjectReference Include="..\SharpProof.Frontend\SharpProof.Frontend.csproj" />
    <ProjectReference Include="..\SharpProof.Ir\SharpProof.Ir.csproj" />
    <ProjectReference Include="..\SharpProof.Specs\SharpProof.Specs.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SharpProof.Analyzer.Test" />
    <InternalsVisibleTo Include="SharpProof.Analyzer" />
    <InternalsVisibleTo Include="SharpProof.ContractForGenerator" />
    <InternalsVisibleTo Include="SharpProof.ContractForGenerator.Test" />
    <InternalsVisibleTo Include="SharpProof.CompilerCollector" />
    <InternalsVisibleTo Include="SharpProof.Gates" />
    <InternalsVisibleTo Include="SharpProof.Worker.Test" />
  </ItemGroup>
</Project>
