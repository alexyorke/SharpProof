<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\SharpProof.PackageMetadata.props" />
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>SharpProof.Legacy.Attributes</PackageId>
    <Title>SharpProof legacy contract attributes</Title>
    <Description>Temporary compatibility types for migrating SharpProof string contracts to compiler-bound Contract calls.</Description>
    <PackageReleaseNotes>Migration-only compatibility surface. Do not use for new code.</PackageReleaseNotes>
    <PackageTags>SharpProof;Migration;Legacy;Roslyn</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
