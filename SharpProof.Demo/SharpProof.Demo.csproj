<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AssemblyName>SharpProof.Demo</AssemblyName>
		<RootNamespace>SharpProof.Demo</RootNamespace>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<!-- Keep intentional teaching diagnostics visible for direct demo builds while the repository solution gate stays warning-free. -->
	<PropertyGroup Condition="'$(BuildingSolutionFile)' == 'true'">
		<NoWarn>$(NoWarn);SP0002;SP0004</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<GlobalAnalyzerConfigFiles Include="SharpProof.globalconfig" />
		<AdditionalFiles Include="SharpProof.Baseline.json" />
		<AdditionalFiles Include="Demo.SharpProof.EffectSummary.json" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\SharpProof.Attributes\SharpProof.Attributes.csproj" />
		<ProjectReference Include="..\SharpProof.Analyzer\SharpProof.Analyzer.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
		<ProjectReference Include="..\SharpProof.Symbolic\SharpProof.Symbolic.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
		<ProjectReference Include="..\SearchLib\SearchLib.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
		<ProjectReference Include="..\SharpProof.CodeFixes\SharpProof.CodeFixes.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

</Project>
